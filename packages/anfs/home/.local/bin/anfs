#!/usr/bin/env bash
# anfs — Agent Native Full Stack: the toolkit's own command
#
# anfs owns what the tools share: the sources. Each source is a repo that may hold
#   packages/    ppm   software and dotfiles
#   containers/  pcm   podman compose services
#   machines/    pmm   machines, the images they run from and the networks they are on
#   skills/      psm   agent skills
#   spaces/      wsm   workspaces
#   stacks/      anfs  stacks: manifests of the others, applied together (lib/anfs/stacks.sh)
# and the tools each read their own directory of every source. anfs's own resource is the stack;
# it adds the commands that span the tools: install a whole source, and implode the whole toolkit.
#
# Commands:
#   src <add|remove|list|ssh|update>   the source lists (~/.config/anfs/{user,system}.list)
#   iso <list|show|pull|add|...>       the ISO catalogue and store (lib/anfs/iso.sh; pmm and
#                                      ventoy have the same group)
#   list | show | install | remove | path   stacks (lib/anfs/stacks.sh): the manifest, applied
#                                      tool by tool, and its record for remove
#   src install [-y] <source>...       every resource of each source, tool by tool
#   onboard [--check] [step...]        from a fresh install to yours: what your sources offer,
#                                      your own repo, and the steps installed packages bring
#                                      (lib/anfs/onboard.sh; the contract is lib/ppm/onboard.sh)
#   implode [-y] [--all]               the other stacks, the tools' implodes, the system stack,
#                                      then anfs itself; --all also what
#                                      install.sh added (Homebrew when it installed it)
#
# Tools: each tool by what it manages (`anfs machine ...` is `pmm ...`, exec'd), its name an alias:
#   package (ppm)  container (pcm)  machine (pmm)  skill (psm)  space (wsm)  vault (pvm)
#
# From packages: `anfs <name>`, when anfs declares no such command, execs ~/.local/bin/anfs-<name>
# with the rest of the line (anfs-dev/dev's anfs work and anfs hooks). Nothing of a package is
# sourced into anfs, and a declared command always wins.
#
# Cherry-picking within a source is each tool's business: ppm install lgat/rails,
# pcm install lgat/postgres, wsm install lgat/main/tech.
set -euo pipefail

ANFS_LIB="$HOME/.local/lib/anfs"
# The bash floor, first: re-execs under bash 5 when this is macOS's 3.2 (lib/anfs/bash.sh).
# Optional here only: anfs and ppm are what repair an install whose lib/anfs predates it
# shellcheck source=/dev/null
if [[ -f "$ANFS_LIB/bash.sh" ]]; then source "$ANFS_LIB/bash.sh"; fi
# shellcheck source=/dev/null
source "$ANFS_LIB/paths.sh"
# Messages, the log and callbacks. Optional for the same reason as bash.sh
for _lib in log.sh callbacks.sh table.sh; do
  # shellcheck source=/dev/null
  if [[ -f "$ANFS_LIB/$_lib" ]]; then source "$ANFS_LIB/$_lib"; fi
done
# shellcheck source=/dev/null
source "$ANFS_LIB/sources.sh"
anfs_gitsrc_env
# shellcheck source=/dev/null
source "$ANFS_LIB/resolve.sh"
# shellcheck source=/dev/null
if [[ -f "$ANFS_LIB/stacks.sh" ]]; then source "$ANFS_LIB/stacks.sh"; fi
# shellcheck source=/dev/null
if [[ -f "$ANFS_LIB/iso.sh" ]]; then source "$ANFS_LIB/iso.sh"; fi
# shellcheck source=/dev/null
if [[ -f "$ANFS_LIB/listener.sh" ]]; then source "$ANFS_LIB/listener.sh"; fi

# The command line (lib/anfs/cli.sh): every command is a cmd_<name> function below
# shellcheck source=/dev/null
source "$ANFS_LIB/cli.sh"
CLI_TOOL=anfs
# shellcheck source=/dev/null
if [[ -f "$ANFS_LIB/onboard.sh" ]]; then source "$ANFS_LIB/onboard.sh"; fi
cli_group src "The sources every tool reads"
cli_cmd "src list" "The sources in priority order: status, and what each provides" --alias ls
cli_cmd "src add" "Add a source to your list (and clone it)" \
  --opt "--top: Before your other sources (highest priority)" --arg "url" --arg "[alias]"
cli_cmd "src remove" "Take a source off your list" --alias rm --arg "source"
cli_cmd "src ssh" "Switch GitHub HTTPS sources and their remotes to SSH" --arg "[source]"
cli_cmd "src update" "Clone missing sources and pull the others (local paths are linked,
never pulled)" --arg "[source...]"
# The iso group is lib/anfs/iso.sh's, the same in every tool that uses ISOs
! declare -F anfs_iso_cli >/dev/null || anfs_iso_cli
cli_cmd "src install" "Install everything a source holds: its packages (ppm),
containers (pcm), machines (pmm), skills (psm)
and spaces (wsm), in that order. To pick single resources use the
tool itself." --opt "-y --yes: Do not ask" --arg "source..."
# Stacks, anfs's own resource (lib/anfs/stacks.sh)
cli_cmd list "Every stack in every source: STACK STATUS VERSION (installed, partial, -)" --alias ls
cli_cmd show "A stack's resources through the stacks it depends on, in install
order: declared and actual status, and the stack that brought each in" --arg "stack"
cli_cmd install "Install stacks: the stacks they depend on, then packages, skills,
vaults, spaces, containers and machines, each kind by its tool,
then the status: entries. Recorded, for remove." \
  --opt "-y --yes: Do not ask" \
  --opt "-t --target TARGET: Where: host (the default; the only one for now)" \
  --opt "--build: Only what belongs in an image: packages and skills" --arg "stack..."
cli_cmd remove "Undo stacks: what their install put here that was not here before
and no other installed stack holds, in reverse order" --alias rm \
  --opt "-y --yes: Do not ask" \
  --opt "-t --target TARGET: Where: host (the default; the only one for now)" --arg "stack..."
cli_cmd path "Print a stack's directory" --arg "stack"
# A step's options are declared by the package that owns it (package.yml onboard.options), so
# they are read only when the line is about onboard: one yq over the sources' package.yml files
_onboard_opts=()
if [[ " $* " == *" onboard "* ]] && declare -F onboard_options >/dev/null; then
  while IFS= read -r _spec; do
    [[ -z "$_spec" ]] || _onboard_opts+=(--opt "$_spec")
  done < <(onboard_options)
fi
cli_cmd onboard "Make a fresh install yours, step by step. anfs's own steps are
packages (what your sources offer to install) and repo (your
own repo, the user source); installed packages add theirs:
your git identity, an ssh key, GitHub, a password manager.
Each step looks at the machine first, so a rerun does only
what is missing. No step named means all of them." \
  --opt "--check: Only report each step's state; exit 1 when one is still to do" \
  --opt "-y --yes: Take every proposal without asking" \
  --opt "--install PACKAGE: A package on offer to install (or all); may be repeated" \
  --opt "--repo REPO: Your repo: local, new (also published, by a package that can), or a git URL" \
  ${_onboard_opts[@]+"${_onboard_opts[@]}"} \
  --arg "[step...]"
cli_cmd implode "Remove everything the toolkit put on this machine: the other
installed stacks (last installed first), each installed tool's
implode (wsm, psm, pmm, pcm), the system stack, ppm's implode,
then the sources. Space contents are kept. It ends by listing what anfs's installer added
that is still there (mise and its tools, the base formulas,
Homebrew if it installed it)." \
  --opt "-y --yes: Do not ask" \
  --opt "--all: That too, and nothing that was on the machine before anfs"
cli_cmd callbacks "Who listens to which tool's events (ppm and wsm emit
install and remove): tool, listener, ok or stale, handler" --arg "[tool]"
cli_cmd log "Print the log every tool writes; of one tool when named" \
  --opt "-f --follow: Keep printing as it grows" --arg "[tool]"
cli_cmd rpc "The toolkit's API: a JSON request per line on stdin, a JSON
answer per line on stdout (run, stream, yes, watch, version). Only
the toolkit's tools, never a shell; a write needs --grant write" \
  --opt "--grant GRANT: read (the default) or write" \
  --opt "--token: The first line must be {\"token\":\"...\"}; the token is the grant (the listener's TCP mode)"
cli_standard

# The tools, by what each manages: the whole line goes to the tool (_anfs_forward)
declare -A ANFS_TOOL_OF=()
cli_section Tools
_anfs_tool() {
  ANFS_TOOL_OF[$1]="$2"
  cli_cmd "$1" "$3 ($2 <command>)" --alias "$2"
}
_anfs_tool package   ppm "Packages: software and dotfiles"
_anfs_tool container pcm "Containers: podman compose services"
_anfs_tool machine   pmm "Machines, their images and networks"
_anfs_tool skill     psm "Agent skills"
_anfs_tool space     wsm "Workspaces of spaces"
_anfs_tool vault     pvm "Secrets"

# Commands from packages: an executable anfs-<name> in ~/.local/bin, for a name anfs does not
# declare. Read from the file names alone, so help and completion start no process.
declare -A ANFS_FROM_PACKAGE=()
cli_section "From packages"
for _bin in "$ANFS_BIN_DIR"/anfs-*; do
  [[ -x "$_bin" && ! -d "$_bin" ]] || continue
  _name="${_bin##*/anfs-}"
  [[ "$_name" =~ ^[a-z][a-z0-9-]*$ ]] || continue
  [[ -z "${CLI_KIND[$_name]:-}" && -z "${CLI_ALIAS_TO[$_name]:-}" ]] || continue
  ANFS_FROM_PACKAGE[$_name]="$_bin"
  # its path as anfs_display shows it, without the subshell (this runs on every start)
  _desc="$_bin"
  [[ "$_desc" != "$HOME"/* ]] || _desc="~/${_desc#"$HOME"/}"
  cli_cmd "$_name" "$_desc"
done
unset _bin _name _desc

# The executable a tool's or a package's command runs, into REPLY. Returns 1 for a name that is
# anfs's own, or no command at all. A tool that is not installed is 69, unless <quiet>.
_anfs_target() {
  local name="${CLI_ALIAS_TO[$1]:-$1}" tool
  if [[ -n "${ANFS_TOOL_OF[$name]:-}" ]]; then
    tool="${ANFS_TOOL_OF[$name]}"
    REPLY="$ANFS_BIN_DIR/$tool"
    [[ -x "$REPLY" ]] && return 0
    [[ -z "${2:-}" ]] || return 1
    ! declare -F anfs_fail >/dev/null || anfs_fail 69 "$tool is not installed (ppm install core/$tool)"
    echo "anfs: $tool is not installed (ppm install core/$tool)" >&2
    exit 69
  fi
  [[ -n "${ANFS_FROM_PACKAGE[$name]:-}" ]] || return 1
  REPLY="${ANFS_FROM_PACKAGE[$name]}"
}

# A line that is a tool's or a package's command is that executable's, all of it: exec'd with the
# rest, so its exit status and output are the command's. So are `help <name>` and completion after
# the name. anfs's -d, --trace and --json go along. Returns when the line is anfs's own.
_anfs_forward() {
  local -a pre=()
  while [[ $# -gt 0 ]]; do
    case "$1" in -d|--debug|--trace) pre+=("$1") ;; *) break ;; esac
    shift
  done
  case "${1:-}" in
    __complete)
      shift
      while [[ $# -gt 0 ]]; do
        case "$1" in -d|--debug|--trace|--json) shift ;; *) break ;; esac
      done
      # the name itself is still being typed: anfs completes it
      [[ $# -ge 2 ]] && _anfs_target "$1" quiet || return 0
      exec "$REPLY" __complete "${@:2}"
      ;;
  esac
  cli_globals "$@"
  set -- ${CLI_ARGS[@]+"${CLI_ARGS[@]}"}
  [[ "${ANFS_JSON:-}" != true ]] || pre+=(--json)
  if [[ "${1:-}" == help && $# -ge 2 ]]; then
    _anfs_target "$2" || return 0
    exec "$REPLY" ${pre[@]+"${pre[@]}"} help "${@:3}"
  fi
  [[ $# -ge 1 ]] && _anfs_target "$1" || return 0
  exec "$REPLY" ${pre[@]+"${pre[@]}"} "${@:2}"
}

cli_help_epilogue() {
  cat <<'EOF'
A source is a git repo (or a local directory) listed in ~/.config/anfs/user.list (yours,
highest priority) or system.list (shipped). `anfs src list` shows what each one provides.
EOF
}

die() {
  ! declare -F anfs_die >/dev/null || anfs_die "$@"
  echo "anfs: $*" >&2; exit 1
}

# --- callbacks, log (lib/anfs/callbacks.sh, log.sh) ----------------------------------------------

_need_lib() {
  declare -F "$1" >/dev/null || die "$ANFS_LIB is out of date (no ${2}); install core/anfs again"
}

# ppm's handlers are functions of a package's install.sh, not commands: ok while the package that
# registered is installed. (anfs_callbacks_ls asks <tool>_callback_state when there is one.)
ppm_callback_state() {
  [[ -f "$XDG_STATE_HOME/ppm/installed/${1%%/*}/${1#*/}.yml" ]] && echo ok || echo stale
}

# Read-only: why did my listener not run? To watch an event happen, run the tool with -d.
cmd_callbacks() {
  _need_lib anfs_callbacks_ls callbacks.sh
  local out
  out=$(anfs_callbacks_ls "$@")
  if [[ -z "$out" ]]; then
    if declare -F anfs_json_on >/dev/null && anfs_json_on; then echo '[]'; else echo "no callbacks registered${1:+ with $1}"; fi
    return 0
  fi
  _need_lib anfs_table table.sh
  printf '%s\n' "${out//$'\t'/$ANFS_US}" | anfs_table "TOOL LISTENER STATUS HANDLER" "tool listener status handler"
}

cmd_log() {
  local follow=${CLI_OPT[follow]:-false} tool="${1:-}"
  _need_lib anfs_log_file log.sh
  anfs_log_file || die "logging is off (ANFS_LOG=off)"
  [[ -f "$ANFS_LOG_FILE" ]] || die "nothing logged yet ($ANFS_LOG_FILE)"
  # A line is "<time> <tool>[<pid>] <level>: <message>"
  local -a filter=(cat)
  [[ -z "$tool" ]] || filter=(awk -v t="$tool" 'index($2, t "[") == 1')
  if $follow; then
    tail -n 20 -F "$ANFS_LOG_FILE" | "${filter[@]}"
  else
    "${filter[@]}" < "$ANFS_LOG_FILE"
  fi
}

# The tool commands, from ~/.local/bin even when it is not on PATH
tool() {
  local bin="$ANFS_BIN_DIR/$1"
  shift
  [[ -x "$bin" ]] || die "$(basename "$bin") is not installed (ppm install core/$(basename "$bin"))"
  "$bin" "$@"
}

confirm() { anfs_confirm "$@"; }

# `anfs src ...`: the work is lib/anfs/sources.sh's
cmd_src_list()   { _need_lib anfs_table table.sh; gitsrc_list; }
cmd_src_add()    { if ${CLI_OPT[top]:-false}; then gitsrc_add --top "$@"; else gitsrc_add "$@"; fi; }
cmd_src_remove() { gitsrc_remove "$@"; }
cmd_src_ssh()    { gitsrc_ssh "$@"; }
cmd_src_update() { gitsrc_update "$@"; }

# What cli.sh asks for on a tab press (complete_<kind>)
complete_source() { gitsrc_collect 2>/dev/null; printf '%s\n' "${GITSRC_NAMES[@]}"; }
complete_tool()   { printf '%s\n' $ANFS_TOOLS; }
complete_stack()  { anfs_sources stacks 2>/dev/null; anfs_list stacks; }

# Stacks: the work is lib/anfs/stacks.sh's
cmd_list()    { _need_lib stack_list stacks.sh; stack_list; }
cmd_show()    { _need_lib stack_show stacks.sh; stack_show "$1"; }
cmd_path()    { _need_lib stack_path stacks.sh; stack_path "$1"; }
cmd_install() {
  _need_lib stack_install stacks.sh
  gitsrc_update_stale >/dev/null 2>&1 || true
  stack_install "${CLI_OPT[yes]:-false}" "${CLI_OPT[build]:-false}" "${CLI_OPT[target]:-}" "$@"
}
cmd_remove() {
  _need_lib stack_remove stacks.sh
  stack_remove "${CLI_OPT[yes]:-false}" "${CLI_OPT[target]:-}" "$@"
}

cmd_src_install() {
  local yes=${CLI_OPT[yes]:-false} arg
  local -a srcs=()
  for arg in "$@"; do
    [[ "$arg" != */* ]] || die "src install takes whole sources ('${arg%%/*}'); for one resource use the tool: ${ANFS_TOOLS// /|} install $arg"
    srcs+=("$arg")
  done

  gitsrc_update_stale >/dev/null 2>&1 || true
  gitsrc_collect
  local src dir t tld plan=""
  for src in "${srcs[@]}"; do
    [[ "$(gitsrc_index "$src")" != 9999 ]] || die "'$src' is not a source (anfs src list; anfs src add <url> $src)"
    dir=$(gitsrc_dir "$src")
    [[ -d "$dir" ]] || die "source '$src' is not cloned yet (anfs src update $src)"
    for t in $ANFS_TOOLS; do
      tld=$(anfs_tool_dir "$t")
      [[ -d "$dir/$tld" ]] && plan="$plan  $src: $tld ($t)"$'\n'
    done
  done
  [[ -n "$plan" ]] || die "nothing to install: ${srcs[*]} hold none of: $GITSRC_DIRS"

  printf 'anfs install:\n%s' "$plan"
  $yes || confirm "install changes this machine" "Install?"

  # One tool at a time across all the sources: packages bring the software containers and skills
  # run on, and spaces come last so whatever they open has been installed
  local rc=0
  for t in $ANFS_TOOLS; do
    local -a specs=()
    tld=$(anfs_tool_dir "$t")
    for src in "${srcs[@]}"; do
      [[ -d "$(gitsrc_dir "$src")/$tld" ]] && specs+=("$src/")
    done
    [[ ${#specs[@]} -gt 0 ]] || continue
    # Not every tool is in the system stack (pmm is not): one that is missing is skipped, said so
    if [[ ! -x "$ANFS_BIN_DIR/$t" ]]; then
      echo "== $t is not installed: skipping ${specs[*]} $tld (ppm install core/$t)" >&2
      continue
    fi
    echo "== $t install ${specs[*]}"
    case "$t" in
      ppm) tool ppm install -y "${specs[@]}" || rc=1 ;;
      *)   tool "$t" install "${specs[@]}" || rc=1 ;;
    esac
  done
  return $rc
}

# Implode is `anfs remove system` and what comes after the tools. In order:
#   1. every other installed stack, the last installed first, so none holds a toolkit resource
#   2. each installed tool's implode but ppm's (wsm psm pmm pcm): their state, and what they hold
#      outside a stack. A tool that is not installed is skipped (pmm on a default install).
#   3. `anfs remove system`: ppm removes the toolkit's packages, keeping core/ppm and core/anfs
#   4. ppm implode: those two, the packages installed outside a stack, ppm's own dirs. With no
#      system record (a machine installed before stacks) it is what removes the toolkit.
#   5. the sources, anfs's dirs, the links; with --all the bootstrap
cmd_implode() {
  local yes=${CLI_OPT[yes]:-false} all=${CLI_OPT[all]:-false}

  # Read before anything is deleted: the records live in anfs's state dir
  _record_load
  local system="" q t
  local -a others=()
  if declare -F stack_installed_reverse >/dev/null; then
    while IFS= read -r q; do
      [[ -n "$q" ]] || continue
      if [[ -z "$system" && "${q#*/}" == system ]]; then system="$q"; else others+=("$q"); fi
    done < <(stack_installed_reverse)
  fi
  local tools=""
  for t in $ANFS_TOOLS; do [[ "$t" == ppm ]] || tools="$t $tools"; done

  echo "anfs implode runs, in order:"
  declare -F anfs_rpc_listener_remove >/dev/null && echo "  the toolkit API's listener: unloaded, its unit files and tokens deleted"
  [[ ${#others[@]} -eq 0 ]] || echo "  anfs remove ${others[*]} (the other installed stacks, last installed first)"
  echo "  ${tools% } implode (each installed tool's; each lists what it removes)"
  if [[ -n "$system" ]]; then
    echo "  anfs remove $system (the toolkit's packages), then ppm implode"
  else
    echo "  ppm implode (no system stack recorded: it removes the toolkit)"
  fi
  echo "then deletes the sources ($(_tilde "$ANFS_DATA_HOME")), $(_tilde "$ANFS_CONFIG_HOME") and $(_tilde "$ANFS_CACHE_HOME")."
  echo "Space contents are kept."
  if $all; then
    echo "--all: then everything anfs's installer added to this machine:"
    _bootstrap_summary "  "
  fi
  $all && { _login_shell_guard || return 1; }
  $yes || confirm "implode removes the whole toolkit" "Implode anfs?"

  local rc=0
  # Nothing listening once implode starts: the listener first, before anything it would run
  if declare -F anfs_rpc_listener_remove >/dev/null; then
    echo "== the toolkit API's listener"
    anfs_rpc_listener_remove
    rm -rf "${ANFS_RPC_HOME:?}"
  fi
  # A stack's remove exits on failure: each in a subshell, so the rest still runs
  for q in ${others[@]+"${others[@]}"}; do
    echo "== anfs remove $q"
    ( stack_remove true "" "$q" ) || { echo "anfs: remove $q failed; continuing" >&2; rc=1; }
  done
  # Spaces, skills and containers before the software under them
  for t in $tools; do
    _implode_tool "$t" || rc=1
  done
  if [[ -n "$system" ]]; then
    echo "== anfs remove $system"
    # ppm and anfs stay for ppm implode: removing ppm's package would leave its dirs behind
    ( STACK_REMOVE_KEEP="packages|core/ppm packages|core/anfs" stack_remove true "" "$system" ) ||
      { echo "anfs: remove $system failed; continuing" >&2; rc=1; }
  fi
  # The packages left, and ppm itself; without a system record, the whole toolkit (the fallback)
  _implode_tool ppm || rc=1

  local dir
  for dir in "$ANFS_DATA_HOME" "$ANFS_CONFIG_HOME" "$ANFS_CACHE_HOME" "$ANFS_LIB_DIR"; do
    [[ -e "$dir" ]] || continue
    echo "Deleting $(_tilde "$dir")"
    rm -rf "${dir:?}"
  done
  for t in anfs $ANFS_TOOLS; do
    [[ -L "$ANFS_BIN_DIR/$t" ]] && rm -f "$ANFS_BIN_DIR/$t"
  done

  if $all; then
    _implode_bootstrap || rc=1
  elif [[ -n "$(_bootstrap_summary)" ]]; then
    echo ""
    echo "Still on this machine, added by anfs's installer:"
    _bootstrap_summary "  "
    echo "Remove them too with: anfs implode --all"
  else
    rm -rf "${ANFS_STATE_HOME:?}"
  fi
  [[ $rc -eq 0 ]] && echo "anfs imploded. Open a new shell."
  return $rc
}

# <tool> implode -y, when the tool is installed; a missing one is never called
_implode_tool() {
  [[ -x "$ANFS_BIN_DIR/$1" ]] || return 0
  echo "== $1 implode"
  "$ANFS_BIN_DIR/$1" implode -y </dev/null || { echo "anfs: $1 implode failed; continuing" >&2; return 1; }
}

# --- the bootstrap record ($ANFS_BOOTSTRAP_RECORD, written by install.sh) -------------------------

REC_HOMEBREW="" REC_PREFIX="" REC_FORMULAS="" REC_KNOWN_HOSTS="" REC_EXISTING="" REC_CHECKED=""
_record_load() {
  [[ -f "$ANFS_BOOTSTRAP_RECORD" ]] || return 0
  local key value
  while IFS='=' read -r key value; do
    case "$key" in
      homebrew)        REC_HOMEBREW="$value" ;;
      homebrew_prefix) REC_PREFIX="$value" ;;
      formulas)        REC_FORMULAS="$value" ;;
      known_hosts)     REC_KNOWN_HOSTS="$value" ;;
      existing_homes)  REC_EXISTING="$value" ;;
      checked_homes)   REC_CHECKED="$value" ;;
    esac
  done < "$ANFS_BOOTSTRAP_RECORD"
}

# The tool homes installed software created: of those install.sh checked, the ones that were not
# there before the first install
_created_homes() {
  local rel
  for rel in $REC_CHECKED; do
    [[ "$rel" == .ssh ]] && continue   # only ever emptied, with known_hosts
    [[ " $REC_EXISTING " == *" $rel "* ]] && continue
    [[ -e "$HOME/$rel" ]] && echo "$rel"
  done
  return 0
}

# What install.sh added that is still here, one line each with <indent>; nothing when nothing is.
# What was on the machine before anfs is never listed.
_bootstrap_summary() {
  local indent="${1:-}" homes
  [[ -f "$ANFS_BOOTSTRAP_RECORD" ]] || return 0
  homes=$(_created_homes | paste -sd ' ' -)
  homes=$(for rel in $homes; do _is_bare_dir "$rel" || echo "$rel"; done | paste -sd ' ' -)
  [[ -z "$homes" ]] || echo "${indent}tool homes   $homes (mise and the tools it installed, podman storage, brew caches)"
  [[ -z "$REC_FORMULAS" ]] || echo "${indent}formulas     $REC_FORMULAS (from Homebrew)"
  [[ "$REC_KNOWN_HOSTS" != added ]] || echo "${indent}known_hosts  GitHub's host keys in ~/.ssh/known_hosts"
  [[ "$REC_HOMEBREW" != installed ]] || echo "${indent}Homebrew     ${REC_PREFIX:-its prefix}, installed by anfs"
  return 0
}

# A login shell that runs from Homebrew would stop working once --all removes it: refuse, rather
# than lock the user out. cmd_implode checks this before anything is removed.
# Usage: _login_shell_guard [brew_bin]
_login_shell_guard() {
  local brew_bin="${1:-}" login_shell
  [[ -n "$brew_bin" ]] || { [[ -n "$REC_PREFIX" && -x "$REC_PREFIX/bin/brew" ]] && brew_bin="$REC_PREFIX/bin/brew"; }
  [[ -n "$brew_bin" ]] || brew_bin=$(command -v brew 2>/dev/null) || return 0
  login_shell=$(_login_shell)
  if [[ "$login_shell" == "$(dirname "$(dirname "$brew_bin")")"/* ]] &&
     { [[ "$REC_HOMEBREW" == installed ]] || [[ " $REC_FORMULAS " == *" $(basename "$login_shell") "* ]]; }; then
    echo "anfs: your login shell is $login_shell, from Homebrew; change it first (chsh -s /bin/zsh)," >&2
    echo "anfs: then re-run: anfs implode --all" >&2
    return 1
  fi
}

# `--all`: remove what the record says install.sh added, and nothing that was already there
_implode_bootstrap() {
  [[ -f "$ANFS_BOOTSTRAP_RECORD" ]] || { echo "No bootstrap record ($(_tilde "$ANFS_BOOTSTRAP_RECORD")): nothing more to remove"; return 0; }
  local rc=0 rel brew_bin=""
  [[ -n "$REC_PREFIX" && -x "$REC_PREFIX/bin/brew" ]] && brew_bin="$REC_PREFIX/bin/brew"
  [[ -z "$brew_bin" ]] && command -v brew >/dev/null 2>&1 && brew_bin=$(command -v brew)

  _login_shell_guard "$brew_bin" || return 1

  # Tool homes the toolkit's software created. podman's rootless storage holds files owned by
  # subordinate ids, which only podman can remove; resetting it first also recreates podman's own
  # config dir, so the list is taken after.
  if [[ " $(_created_homes | paste -sd ' ' -) " == *" .local/share/containers "* ]] &&
     command -v podman >/dev/null 2>&1 && [[ "$OSTYPE" != darwin* ]]; then
    podman system reset --force >/dev/null 2>&1 || true
  fi
  for rel in $(_created_homes); do
    _is_bare_dir "$rel" && continue                                        # pruned once empty, below
    [[ "$rel" == .cache/Homebrew && "$REC_HOMEBREW" == installed ]] && continue   # with Homebrew
    echo "Deleting ~/$rel"
    rm -rf "${HOME:?}/$rel" 2>/dev/null || { chmod -R u+w "$HOME/$rel" 2>/dev/null; rm -rf "${HOME:?}/$rel"; } || rc=1
  done

  if [[ "$REC_KNOWN_HOSTS" == added && -f "$ANFS_STATE_HOME/known_hosts" && -f "$HOME/.ssh/known_hosts" ]]; then
    echo "Removing GitHub's host keys from ~/.ssh/known_hosts"
    grep -vxF -f "$ANFS_STATE_HOME/known_hosts" "$HOME/.ssh/known_hosts" > "$HOME/.ssh/known_hosts.anfs" || true
    if [[ -s "$HOME/.ssh/known_hosts.anfs" ]]; then
      mv "$HOME/.ssh/known_hosts.anfs" "$HOME/.ssh/known_hosts"
    else
      rm -f "$HOME/.ssh/known_hosts.anfs" "$HOME/.ssh/known_hosts"
    fi
    [[ " $REC_EXISTING " == *" .ssh "* ]] || rmdir "$HOME/.ssh" 2>/dev/null || true
  fi

  if [[ "$REC_HOMEBREW" == installed && -n "$brew_bin" ]]; then
    # Homebrew's own uninstaller removes the prefix, formulas included (it asks sudo for the prefix)
    echo "Uninstalling Homebrew from $(dirname "$(dirname "$brew_bin")")"
    # Every brew command resets sudo's cached credentials (brew.sh: sudo --reset-timestamp), and
    # ppm implode just ran some; the uninstaller runs without a terminal, so authenticate here, now:
    # a prompt in a terminal, or SUDO_ASKPASS for an unattended run
    if ! sudo -n true 2>/dev/null && [[ -z "${SUDO_ASKPASS:-}" ]] && ! _has_terminal; then
      echo "anfs: removing Homebrew needs sudo; run implode --all in a terminal (or set SUDO_ASKPASS)" >&2
      exit 77
    elif ! sudo -n true 2>/dev/null && ! sudo ${SUDO_ASKPASS:+-A} -v; then
      echo "anfs: removing Homebrew needs sudo; run implode --all in a terminal (or set SUDO_ASKPASS)" >&2
      rc=1
    elif NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/uninstall.sh)" -- --force </dev/null >/dev/null; then
      rm -rf "${HOME:?}/.cache/Homebrew" "${HOME:?}/.homebrew"
    else
      echo "anfs: Homebrew's uninstaller failed" >&2
      rc=1
    fi
  elif [[ -n "$REC_FORMULAS" && -n "$brew_bin" ]]; then
    echo "Uninstalling $REC_FORMULAS from Homebrew (it was here before anfs, so it stays)"
    # shellcheck disable=SC2086
    "$brew_bin" uninstall --quiet $REC_FORMULAS || rc=1
    "$brew_bin" autoremove --quiet >/dev/null 2>&1 || true
  fi

  # The record has served; then the bare XDG dirs the toolkit made, once nothing is left in them
  # (deepest first)
  local bare
  bare=$(_created_homes | awk -F/ '{ print NF "\t" $0 }' | sort -rn | cut -f2)
  rm -rf "${ANFS_STATE_HOME:?}"
  for rel in $bare; do
    _is_bare_dir "$rel" && rmdir "$HOME/$rel" 2>/dev/null || true
  done
  return $rc
}

# A person who can answer sudo: stdin is a terminal or there is one to open; never under anfs rpc
_has_terminal() {
  [[ -z "${ANFS_RPC:-}" ]] || return 1
  [[ -t 0 ]] || { : </dev/tty; } 2>/dev/null
}

# .local, .config, ... themselves: removed only when empty, never with what is in them
_is_bare_dir() {
  case "$1" in .local|.local/share|.local/state|.local/bin|.local/lib|.config|.cache) return 0 ;; esac
  return 1
}

# The user's login shell from the account database (getent on Linux, dscl on macOS)
_login_shell() {
  if command -v getent >/dev/null 2>&1; then
    getent passwd "$(id -un)" | cut -d: -f7
  elif command -v dscl >/dev/null 2>&1; then
    dscl . -read "/Users/$(id -un)" UserShell 2>/dev/null | awk '{print $2}'
  fi
}

_tilde() { anfs_display "$1"; }

# --- the toolkit API: anfs rpc --------------------------------------------------------------------
#
# A filter: JSON lines in, JSON lines out, until EOF (plan 02 puts it behind a socket). A request:
#   {"run":["ppm","list"]}                 {"exit":0,"data":<--json output>} or {"exit":0,"out":"..."}
#   {"run":[...],"stream":true}            {"out":"<line>"} per line of stdout+stderr, then {"exit":N}
#   {"run":[...],"yes":true}               the same with -y (before a --, else at the end)
#   {"watch":true}                         {"event":"start"|"end",...} per tool run, from anfs.log,
#                                          until stdin closes (other requests still answered)
#   {"version":true}                       {"anfs":"0.2.9","tools":{"ppm":"0.2.5",...}}
# A failed run is {"exit":N,"error":"<last stderr line>"}; 77 adds "needs":"terminal" and the
# command. Anything else is {"error":"..."} and the next line is read.
#
# run[0] is anfs, one of ANFS_TOOLS or pvm, from $ANFS_BIN_DIR, never PATH; the rest is an argv,
# never a shell. Refused: anfs rpc, any implode. Read (allowed under --grant read): a tool's
# list|ls, show, status, path, validate, --version, version (in a group too: pmm image list;
# through anfs: anfs package list). A read gets --json and ANFS_LOG=off; every run has stdin
# /dev/null, ANFS_RPC=1 (no terminal: confirm and sudo exit 77) and ANFS_RPC_TIMEOUT seconds
# (60; a stream has none).

RPC_GROUPS=" agents file image iso link machine network repo snapshot src "
RPC_READ=" list ls show status path validate --version version "

# A JSON string, into REPLY
_rpc_str() {
  local LC_ALL=C s="$1" out="" c i
  s=${s//\\/\\\\} s=${s//\"/\\\"}
  s=${s//$'\n'/\\n} s=${s//$'\r'/\\r} s=${s//$'\t'/\\t}
  if [[ "$s" == *[$'\x01'-$'\x1f']* ]]; then
    for (( i = 0; i < ${#s}; i++ )); do
      c=${s:i:1}
      [[ "$c" != [$'\x01'-$'\x1f'] ]] || printf -v c '\\u%04x' "'$c"
      out+=$c
    done
    s=$out
  fi
  REPLY="\"$s\""
}

# A JSON array of strings, into REPLY
_rpc_arr() {
  local a out=""
  for a in "$@"; do _rpc_str "$a"; out+=",$REPLY"; done
  REPLY="[${out#,}]"
}

_rpc_error() { _rpc_str "$1"; printf '{"error":%s}\n' "$REPLY"; }

# The command word of a tool's argv (options, anfs's tool names and a group skipped), in RPC_VERB
_rpc_verb() {
  local tool="$1" w w2 group=false
  shift
  RPC_VERB=""
  for w in "$@"; do
    [[ "$w" != --version ]] || { RPC_VERB=$w; return 0; }
    [[ "$w" != -* ]] || continue
    w2="${CLI_ALIAS_TO[$w]:-$w}"
    if [[ "$tool" == anfs && -n "${ANFS_TOOL_OF[$w2]:-}" ]]; then
      tool="${ANFS_TOOL_OF[$w2]}"
      continue
    fi
    if ! $group && [[ "$RPC_GROUPS" == *" $w "* ]]; then group=true; continue; fi
    RPC_VERB=$w
    return 0
  done
}

# Run RPC_ARGV and answer. Usage: _rpc_run <stream> <yes>
_rpc_run() {
  local stream="$1" yes="$2" tool="${RPC_ARGV[0]:-}" bin read=false rc=0 i
  local -a args=("${RPC_ARGV[@]:1}")
  [[ "$tool" =~ ^[a-z]+$ && " anfs $ANFS_TOOLS pvm " == *" $tool "* ]] ||
    { _rpc_error "not a toolkit tool: $tool (anfs ${ANFS_TOOLS} pvm)"; return 0; }
  bin="$ANFS_BIN_DIR/$tool"
  [[ -x "$bin" && ! -d "$bin" ]] || { _rpc_error "$tool is not installed"; return 0; }
  _rpc_verb "$tool" ${args[@]+"${args[@]}"}
  [[ "$RPC_VERB" != implode ]] || { _rpc_error "refused: implode"; return 0; }
  [[ "$tool $RPC_VERB" != "anfs rpc" ]] || { _rpc_error "refused: anfs rpc"; return 0; }
  [[ -z "$RPC_VERB" || "$RPC_READ" != *" $RPC_VERB "* ]] || read=true
  [[ -n "$RPC_VERB" ]] || read=true   # the tool's help
  if ! $read && [[ "$RPC_GRANT" != write ]]; then
    _rpc_error "refused: a write request (${RPC_VERB}) under --grant read"
    return 0
  fi
  if $yes; then
    for (( i = 0; i < ${#args[@]}; i++ )); do [[ "${args[i]}" != -- ]] || break; done
    args=(${args[@]+"${args[@]:0:i}"} -y ${args[@]+"${args[@]:i}"})
  fi
  if $read && ! $stream; then args=(--json ${args[@]+"${args[@]}"}); fi
  _rpc_arr "$tool" ${args[@]+"${args[@]}"}
  local cmd="$REPLY" dir="$RPC_TMP/run"
  rm -rf "$dir"; mkdir -p "$dir"

  if $stream; then
    set +e
    ( ! $read || export ANFS_LOG=off; exec "$bin" ${args[@]+"${args[@]}"} </dev/null 2>&1 ) |
      while IFS= read -r line || [[ -n "$line" ]]; do _rpc_str "$line"; printf '{"out":%s}\n' "$REPLY"; done
    rc=${PIPESTATUS[0]}
    set -e
  else
    ( ! $read || export ANFS_LOG=off; exec "$bin" ${args[@]+"${args[@]}"} </dev/null >"$dir/out" 2>"$dir/err" ) &
    local pid=$! wpid
    mkfifo "$dir/tick"
    # the timeout: a read on a fifo nobody writes, then the run and its children
    ( exec {fd}<>"$dir/tick"
      read -r -t "$RPC_TIMEOUT" -u "$fd" _ ||
        { : > "$dir/timeout"; pkill -TERM -P "$pid"; kill -TERM "$pid"; } ) 2>/dev/null &
    wpid=$!
    wait "$pid" || rc=$?
    kill "$wpid" 2>/dev/null || true
    wait "$wpid" 2>/dev/null || true
  fi

  if [[ -f "$dir/timeout" ]]; then
    printf '{"exit":124,"error":"timed out after %ss","command":%s}\n' "$RPC_TIMEOUT" "$cmd"
    return 0
  fi
  if $stream; then
    if [[ $rc == 77 ]]; then printf '{"exit":77,"needs":"terminal","command":%s}\n' "$cmd"
    else printf '{"exit":%d}\n' "$rc"; fi
    return 0
  fi
  local last=""
  [[ ! -s "$dir/err" ]] || last=$(grep -v '^[[:space:]]*$' "$dir/err" | tail -n 1) || true
  _rpc_str "$last"
  if [[ $rc == 77 ]]; then
    printf '{"exit":77,"needs":"terminal","command":%s,"error":%s}\n' "$cmd" "$REPLY"
  elif [[ $rc != 0 ]]; then
    printf '{"exit":%d,"error":%s}\n' "$rc" "$REPLY"
  else
    local data first
    first=$(tr -d ' \t\n\r' < "$dir/out" | head -c 1)
    if $read && [[ "$first" == [\[\{] ]] && data=$(yq -p json -o json -I0 . "$dir/out" 2>/dev/null); then
      printf '{"exit":0,"data":%s}\n' "$data"
    else
      local out
      out=$(cat "$dir/out"; echo x); out=${out%x}; out=${out%$'\n'}
      _rpc_str "$out"
      printf '{"exit":0,"out":%s}\n' "$REPLY"
    fi
  fi
}

# One anfs.log line as an event: <time> <tool>[<pid>] start: <id> <args> | end: <id> <exit>
_rpc_events() {
  local line re='^([^ ]+) ([^[ ]+)\[([0-9]+)\] (start|end): ([0-9]+-[0-9]+) ?(.*)$'
  local time tool pid kind id rest
  while IFS= read -r line; do
    [[ "$line" =~ $re ]] || continue
    time=${BASH_REMATCH[1]} pid=${BASH_REMATCH[3]} kind=${BASH_REMATCH[4]}
    id=${BASH_REMATCH[5]} rest=${BASH_REMATCH[6]}
    _rpc_str "${BASH_REMATCH[2]}"; tool=$REPLY
    if [[ "$kind" == start ]]; then
      _rpc_str "$rest"
      printf '{"event":"start","id":"%s","tool":%s,"pid":%s,"time":"%s","args":%s}\n' \
        "$id" "$tool" "$pid" "$time" "$REPLY"
    elif [[ "$rest" =~ ^[0-9]+$ ]]; then
      printf '{"event":"end","id":"%s","tool":%s,"pid":%s,"time":"%s","exit":%s}\n' \
        "$id" "$tool" "$pid" "$time" "$rest"
    fi
  done
}

# Follow anfs.log from where it is now; stopped at EOF
_rpc_watch() {
  [[ -z "$RPC_WATCH" ]] || { _rpc_error "already watching"; return 0; }
  declare -F anfs_log_file >/dev/null && anfs_log_file || { _rpc_error "logging is off (ANFS_LOG=off)"; return 0; }
  mkdir -p "${ANFS_LOG_FILE%/*}"
  [[ -f "$ANFS_LOG_FILE" ]] || : > "$ANFS_LOG_FILE"
  local size
  size=$(wc -c < "$ANFS_LOG_FILE" | tr -d ' ')
  tail -c +$(( size + 1 )) -F "$ANFS_LOG_FILE" 2>/dev/null > >(_rpc_events) &
  RPC_WATCH=$!
}

_rpc_version() {
  local t v out=""
  [[ -n "$CLI_VERSION" ]] || cli_package_version
  for t in $ANFS_TOOLS pvm; do
    [[ -x "$ANFS_BIN_DIR/$t" ]] || continue
    v=$(ANFS_LOG=off "$ANFS_BIN_DIR/$t" --version </dev/null 2>/dev/null) || continue
    _rpc_str "${v##* }"
    out+=",\"$t\":$REPLY"
  done
  _rpc_str "${CLI_VERSION:-unknown}"
  printf '{"anfs":%s,"tools":{%s}}\n' "$REPLY" "${out#,}"
}

# The token of a {"token":"..."} line (a map whose only key is token, a string); fails otherwise
_rpc_token() {
  local t
  t=$(printf '%s' "$1" | yq -p json -o tsv '[tag, (keys | join(",")), (.token | tag), .token]' 2>/dev/null) || return 1
  [[ "$t" == $'!!map\ttoken\t!!str\t'* ]] || return 1
  printf '%s\n' "${t#$'!!map\ttoken\t!!str\t'}"
}

# One request line
_rpc_request() {
  local f="$RPC_TMP/req" n i
  local -a h
  if ! printf '%s' "$1" | yq -p json -0 'tag, ((.run | tag) // ""), (.stream // false), (.yes // false), (.watch // false), (.version // false), (.run[]? | (tag, .))' > "$f" 2>/dev/null; then
    _rpc_error "not a JSON request"; return 0
  fi
  mapfile -d '' -t h < "$f"
  [[ "${h[0]:-}" == '!!map' ]] || { _rpc_error "a request is a JSON object"; return 0; }
  if [[ "${h[1]}" == '!!seq' ]]; then
    n=$(( (${#h[@]} - 6) / 2 ))
    (( n > 0 )) || { _rpc_error "run is a non-empty array of strings"; return 0; }
    RPC_ARGV=()
    for (( i = 0; i < n; i++ )); do
      [[ "${h[6 + i]}" == '!!str' ]] || { _rpc_error "run is a non-empty array of strings"; return 0; }
      RPC_ARGV+=("${h[6 + n + i]}")
    done
    _rpc_run "$([[ ${h[2]} == true ]] && echo true || echo false)" "$([[ ${h[3]} == true ]] && echo true || echo false)"
  elif [[ -n "${h[1]}" && "${h[1]}" != '!!null' ]]; then
    _rpc_error "run is a non-empty array of strings"
  elif [[ "${h[4]}" == true ]]; then _rpc_watch
  elif [[ "${h[5]}" == true ]]; then _rpc_version
  else _rpc_error "unknown request (run, watch or version)"
  fi
}

cmd_rpc() {
  RPC_GRANT="${CLI_OPT[grant]:-read}" RPC_WATCH="" RPC_TIMEOUT="${ANFS_RPC_TIMEOUT:-60}"
  [[ "$RPC_GRANT" == read || "$RPC_GRANT" == write ]] || cli_usage_err "--grant is read or write"
  [[ "$RPC_TIMEOUT" =~ ^[0-9]+$ ]] || cli_usage_err "ANFS_RPC_TIMEOUT is seconds"
  command -v yq >/dev/null 2>&1 || { echo "anfs: yq is required" >&2; exit 69; }
  export ANFS_RPC=1
  RPC_TMP=$(mktemp -d "${TMPDIR:-/tmp}/anfs-rpc.XXXXXX")
  local line first=true token
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -n "${line//[[:space:]]/}" ]] || continue
    # The first line may be {"token":"..."}: with --token it must be, and its token is the grant;
    # without (a unix socket, a pipe), it is read and ignored
    if $first; then
      first=false
      token=$(_rpc_token "$line") || token=""
      if ${CLI_OPT[token]:-false}; then
        if [[ -z "$token" ]] || ! RPC_GRANT=$(anfs_rpc_token_grant "$token" 2>/dev/null); then
          _rpc_error "unauthorized: the first line is {\"token\":\"...\"}"
          rm -rf "$RPC_TMP"
          return 1
        fi
        continue
      fi
      [[ -z "$token" ]] || continue
    fi
    _rpc_request "$line"
  done
  if [[ -n "$RPC_WATCH" ]]; then
    kill "$RPC_WATCH" 2>/dev/null || true
    wait "$RPC_WATCH" 2>/dev/null || true
  fi
  rm -rf "$RPC_TMP"
}

_anfs_forward "$@"
cli_dispatch "$@"
