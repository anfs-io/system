# anfs settings: shipped by core/anfs. anfs's own (ANFS_*, what more than one tool shares) and
# Homebrew's, which every tool runs with. Each tool's own are in ~/.config/<tool>/<tool>.env.
#
# This machine's values go in ~/.config/anfs/anfs.local.env, beside this file (yours, never
# shipped). The environment wins over both: `ANFS_UPDATE_CACHE_DURATION=0 ppm install x` does what
# it says. Format: NAME=value, one per line, read and never sourced (only a leading ~/, or a value
# that is ~, is expanded, to $HOME; a value may be quoted). A commented line is the default used
# when nothing sets it; an active one is what the package sets. `anfs config list` shows them and
# where each is from; `anfs config set NAME=value` writes anfs.local.env.

# --- sources ---
# Seconds between automatic updates of the source repos (ppm install, pcm up, anfs install)
ANFS_UPDATE_CACHE_DURATION=86400
# true: say which sources were not updated because of local changes only with --debug
#ANFS_QUIET_SKIPPED_REPOS=false

# --- skills (psm and wsm) ---
# Version of the skills CLI (npx skills@<version>) psm and wsm run (lib/anfs/skill.sh)
#ANFS_SKILLS_CLI_VERSION=latest

# --- the toolkit API (anfs rpc) ---
# macOS: the localhost TCP port the API's listener takes (written when core/anfs is installed)
#ANFS_RPC_PORT=47100
# Seconds a command run through the API may take before it is stopped (a stream has no limit)
#ANFS_RPC_TIMEOUT=60

# --- the log (anfs log) ---
# Bytes ~/.local/state/anfs/anfs.log may reach before it is rotated to anfs.log.1
#ANFS_LOG_MAX=1048576

# --- Homebrew (every brew a tool runs) ---
HOMEBREW_NO_AUTO_UPDATE=1
HOMEBREW_NO_ENV_HINTS=1
