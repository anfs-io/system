# anfsd settings: shipped by core/anfsd. anfsd reads this file and anfsd.local.env itself; the
# hooks and anfs bus read ANFSD_BIN.
#
# This machine's values go in ~/.config/anfsd/anfsd.local.env, beside this file (yours, never
# shipped). The environment wins over both. Format: NAME=value, one per line, read and never
# sourced (only a leading ~/, or a value that is ~, is expanded, to $HOME). A commented line is
# the default used when nothing sets it. After a change: anfs bus restart anfsd.

# An anfsd built from source, run instead of the pinned release (anfs bus status says "from
# source"): go build -o ~/.local/share/anfsd/dev/anfsd ./cmd/anfsd in a runtime checkout. Empty:
# the release
#ANFSD_BIN=
# How long the stream ANFS keeps an event (90d, 24h). The JSONL files keep every event forever
#ANFSD_STREAM_MAX_AGE=90d
# The most the stream ANFS holds (1GiB, 512MiB); past it the oldest events go
#ANFSD_STREAM_MAX_BYTES=1GiB
# How long the stream remembers an event id, so an event sent twice is stored once
#ANFSD_DUP_WINDOW=24h
# Events a second the shipper sends per space (more wait in the files)
#ANFSD_SHIP_RATE=100
# How many it may send at once before that rate applies
#ANFSD_SHIP_BURST=1000
