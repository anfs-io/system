# pcm settings: shipped by core/pcm. Every setting pcm reads (anfs's own are in ~/.config/anfs/anfs.env).
#
# This machine's values go in ~/.config/pcm/pcm.local.env, beside this file (yours, never shipped).
# The environment wins over both: `PCM_HEALTH_TIMEOUT=300 pcm up x` does what it says. Format:
# NAME=value, one per line, read and never sourced (only a leading ~/, or a value that is ~, is
# expanded, to $HOME; a value may be quoted). A commented line is the default used when nothing
# sets it; an active one is what the package sets. `pcm config list` shows them and where each is
# from; `pcm config set NAME=value` writes pcm.local.env.

# Compose runner: "podman compose" or "podman-compose"
#PCM_COMPOSE="podman compose"
# Seconds pcm up waits for a dependency to become healthy
#PCM_HEALTH_TIMEOUT=120
# The podman network services share
#PCM_SHARED_NETWORK=dev-net
# The services always attached to that network (space-separated, name or source/name; empty: none).
# A service with pcm dependencies is attached regardless.
#PCM_ATTACHED_SERVICES="postgres valkey"
# macOS: memory (MiB) of the podman machine VM, e.g. 4096. pcm up resizes a machine with another
# amount, restarting it (which stops every container in it). Empty leaves it as podman made it.
#PCM_MACHINE_MEMORY=
# macOS: MiB the podman machine gets on top of what its containers declare (container.yml memory:)
#PCM_MACHINE_HEADROOM=1024
# The proxy routing x-pcm.ingress hosts when several definitions provide one (e.g. traefik); empty:
# the one that does
#PCM_PROXY=
# The domain a service's default host is under (<name>.<domain>)
#PCM_INGRESS_DOMAIN=localhost
# The cloudflare-tunnel edge's tunnel (empty: pcm-<hostname>; an edge's tunnel= wins)
#PCM_TUNNEL_NAME=
