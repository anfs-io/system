#!/usr/bin/env bash
set -euo pipefail

# Paths and sources come from anfs: one source list for every tool (`anfs src`), each source
# cloned once under ~/.local/share/anfs/sources; pcm reads the containers/ directory of each
ANFS_LIB="$HOME/.local/lib/anfs"
if [[ ! -f "$ANFS_LIB/bash.sh" ]]; then
  anfs_warn "$ANFS_LIB is missing or out of date; run: ppm install -f core/anfs"
  exit 1
fi
# The bash floor, first: re-execs under bash 5 when this is macOS's 3.2
# shellcheck source=/dev/null
source "$ANFS_LIB/bash.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/paths.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/log.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/callbacks.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/sources.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/catalog.sh"
anfs_tool_paths pcm
anfs_gitsrc_env
: "${PCM_CONTAINERS_HOME:=$PCM_CONFIG_HOME/containers}"
: "${PCM_VOLUMES_HOME:=$PCM_DATA_HOME/volumes}"
: "${PCM_HEALTH_TIMEOUT:=120}"
: "${PCM_INGRESS_DOMAIN:=localhost}"
export PCM_CONFIG_HOME PCM_CONTAINERS_HOME PCM_DATA_HOME PCM_VOLUMES_HOME

# The implicit, highest-priority source: hand-made definitions in $PCM_CONTAINERS_HOME
PCM_LOCAL_SOURCE=local

# Compose runner: "podman compose" (default) or "podman-compose"
read -ra RUNNER <<< "${PCM_COMPOSE:-podman compose}"

# varlock resolves each service's env; don't send usage analytics from pcm runs
: "${VARLOCK_TELEMETRY_DISABLED:=1}"
export VARLOCK_TELEMETRY_DISABLED

# The command line (lib/anfs/cli.sh): every command is a cmd_<name> function in lib/pcm/; the
# registry below is the help, in this order, and the completion's command list
# shellcheck source=/dev/null
source "$ANFS_LIB/cli.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/table.sh"
CLI_TOOL=pcm
# The commands are declared in lib/pcm/commands.sh, which the tests load too

cli_help_epilogue() {
  cat <<'EOF'
A <service> is `name` or `source/name`. A plain name resolves to the highest-priority
source that defines it: local ($PCM_CONTAINERS_HOME), then the anfs sources in order.
Only one service of a name runs at a time; `source/name` picks which definition.

Any compose subcommand also works via the podman wrapper in pcm.zsh:
  podman compose --pcm logs -f postgres

Manifest: a service's container.yml beside its compose.yml says what it is

  version: 0.1.0
  description: Postgres, shared by the services that need a database
  upstream: docker.io/library/postgres:17   # what it is built from
  license: PostgreSQL
  url: https://www.postgresql.org
  memory: 512m                              # what it needs; also its limit

Every key but version is optional; an unknown one is a validate error. memory:
is each of its containers' limit whatever compose says (a different mem_limit
is an error), and `pcm up` checks there is room for it: on Linux in the host's
available memory, on macOS in the podman machine beside what already runs. A
machine with nothing running is resized to fit (plus PCM_MACHINE_HEADROOM MiB,
default 1024); with something running pcm refuses, naming what a resize would
stop: `pcm machine resize [size]` does it. Nothing shrinks the machine.

Dependencies: a service's compose.yml may declare other pcm services it needs

  x-pcm:
    depends_on:
      postgres:
        database: glitchtip

`pcm up` starts any that aren't running, waits for them to be healthy, attaches
the service to the shared network and runs the dependency's `provision` hook
(if present) with the settings as key=value args. Each KEY=VALUE line the hook
prints is exported to the service's compose as PCM_<DEP>_<KEY>, e.g.
PCM_POSTGRES_URL. A value already set in the environment wins. `pcm remove`
runs the dependency's `deprovision` hook (if present) with the same settings.

Ingress: a service may declare a hostname route instead of (or as well as) a
host port

  x-pcm:
    ingress:
      service: server        # compose service (default: the only one)
      port: 3000             # its container port
      healthcheck: /healthz  # default /up
      hosts: ${APP_HOSTS}    # default <name>.$PCM_INGRESS_DOMAIN (localhost)

It is routed by the active proxy: the definition with `x-pcm.provides: proxy`,
or the one PCM_PROXY names when several do. The service implicitly depends on
it, so `pcm up` starts the proxy first. The proxy's `labels` hook gets the
ingress as key=value args and prints the labels pcm sets on the container;
its `provision` hook prints the URL, exported as PCM_INGRESS_URL.

Runtime: every service runs as compose project <name> (a definition's top-level
name: is ignored) and its containers carry the labels io.pcm.id (source/name),
io.pcm.name and io.pcm.source; ps, list, show and remove find them by those.

Configuration: a service's .env.schema declares every variable its compose.yml
uses, with types and defaults. pcm runs compose and provision hooks through
`varlock run` from the service directory, so values resolve as
environment > .env > .env.schema defaults, and invalid values stop the command.
Put this machine's overrides in $PCM_CONTAINERS_HOME/<name>/local.env (KEY=VALUE
lines), not next to the schema in a clone: they apply to whichever source's
definition of <name> runs. They are exported before varlock runs, below anything
already in the environment. If fnox is installed and a fnox.toml is in the
service directory or $PCM_CONFIG_HOME, the call is wrapped in `fnox exec` so its
secrets are in the environment first.

Validation:
  errors    env that doesn't pass the service's .env.schema (or no schema when
            compose.yml uses variables)
            volumes that aren't bind mounts under ${PCM_VOLUMES_HOME}/<service>/
            (read-only :ro mounts from the service directory are allowed);
            unknown or cyclic x-pcm.depends_on; an unknown x-pcm.provides role;
            x-pcm.ingress with a bad service, port, healthcheck or host, or
            with no single proxy (or one without a labels hook)
  warnings  image-declared VOLUMEs with nothing mounted there (pulled images
            only); host ports also published by another pcm service; an
            ingress host also routed to another service; a
            top-level name: other than the service name

  Other host paths must be listed in the service's compose.yml, and must exist:

    x-pcm:
      allow_mounts:
        - ${PCM_PODMAN_SOCKET}

  PCM_PODMAN_SOCKET is set to the podman API socket (inside the podman machine
  VM on macOS) for services that reference it.

Sources:
  local     $PCM_CONTAINERS_HOME/<name>/compose.yml (a directory there without
            compose.yml is only settings, local.env, for a <name> defined elsewhere)
  anfs      ~/.local/share/anfs/sources/<source>/containers/<name>/compose.yml
            (every anfs source with a containers/ directory: anfs src list)
EOF
}

cmd_cd() {
  echo "pcm cd needs the pcm shell function (source ~/.config/sh/pcm.sh)" >&2
  return 1
}

# pcm's own libraries, plus any a package contributes: every *.sh in PCM_LIB_DIR. A function
# named cmd_<name> there is the command `pcm <name>`. The stowed dir is preferred so contributed
# libs load; next to this script's real path is the fallback (right after a pull, or unstowed).
pcm_lib_dir() {
  local self="${BASH_SOURCE[0]}" dir link
  if [[ -n "${PCM_LIB_DIR:-}" ]]; then echo "$PCM_LIB_DIR"; return; fi
  if [[ -f "$HOME/.local/lib/pcm/sources.sh" ]]; then echo "$HOME/.local/lib/pcm"; return; fi
  dir="$(cd "$(dirname "$self")" && pwd)"
  while [[ -L "$self" ]]; do
    link="$(readlink "$self")"
    [[ "$link" == /* ]] || link="$dir/$link"
    self="$link"
    dir="$(cd "$(dirname "$self")" && pwd)"
  done
  echo "$dir/../lib/pcm"
}
PCM_LIB_DIR="$(pcm_lib_dir)"
if [[ ! -f "$PCM_LIB_DIR/sources.sh" ]]; then
  anfs_warn "libraries not found in $PCM_LIB_DIR; run: ppm install -f core/pcm"
  exit 1
fi
for lib_file in "$PCM_LIB_DIR"/*.sh; do
  # shellcheck source=/dev/null
  [[ -f "$lib_file" ]] && source "$lib_file"
done

PRE=()
PROVISIONED=()
NAMED=""
ORDER=()
CLOSURE=()
VALIDATE_ERRORS=0

# Subcommand dispatch
cmd=$(cli_resolve "${1:-help}")
shift 2>/dev/null || true

# up and install pull stale sources first, like ppm install
[[ "$cmd" == "up" || "$cmd" == "install" ]] && { gitsrc_update_stale >&2 || true; }
case "$cmd" in
  completion|help|-h|--help) ;;
  *) load_sources ;;
esac

# __compose is the podman wrapper's plumbing (pcm.zsh), not a command
if [[ "$cmd" == "__compose" ]]; then
  compose_wrapper "$@"
else
  cli_dispatch "$cmd" "$@"
fi
