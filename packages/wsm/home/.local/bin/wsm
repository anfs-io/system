#!/usr/bin/env bash
# wsm — work space manager
#
# A source's spaces/ directory holds workspaces, and each workspace holds spaces. The levels are
# fixed by depth, so every directory at the workspace and space depths is one:
#
#   <source>/spaces/                  the source level
#   <source>/spaces/<ws>/             a workspace
#   <source>/spaces/<ws>/<space>/     a space
#
# Each level may hold files of its own and an optional space.yml (the repositories to clone into
# it; a space's also its dependencies). A space's files are everything below it; a workspace's and
# the source level's are what is not inside one of their workspaces or spaces. Hidden directories
# are content, never a level.
#
# `wsm install` stows each level into <target>/<source>/<ws>/<space>/ with GNU Stow, as ppm stows a
# package's home/ into $HOME, then clones the repositories of every space.yml under the spec. The
# target is the DIR argument, else $WSM_SPACES_HOME (anfs.conf; default ~/spaces), and a source
# lives in one target. `wsm new` and `wsm add` go the other way: what you create in that tree is
# moved into the source and stowed back, so the source holds everything but the clones.
#
# What is installed is recorded in one tracker per level, $WSM_STATE_HOME/installed/<id>.yml
# (id: source, source/ws or source/ws/space), which is wsm's only state.
#
# Written for bash 3.2, the version macOS ships: no associative arrays, no mapfile/readarray.
set -euo pipefail

# Bumped by hand at release time. The pre-commit hook bumps package.yml, which the stowed script
# cannot read at runtime, so the two are kept in step manually.
WSM_VERSION=0.4.0

# Paths, sources and the command line come from anfs
ANFS_LIB="$HOME/.local/lib/anfs"
if [[ ! -f "$ANFS_LIB/cli.sh" ]]; then
  echo "wsm: $ANFS_LIB not found; run: ppm install -f core/anfs" >&2
  exit 69
fi
# shellcheck source=/dev/null
source "$ANFS_LIB/paths.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/sources.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/resolve.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/cli.sh"
anfs_gitsrc_env
anfs_tool_paths wsm

WSM_INSTALLED="$WSM_STATE_HOME/installed"
# Where stow finds wsm's ignore list (stow reads $HOME/.stow-global-ignore)
WSM_STOW_HOME="$WSM_STATE_HOME/stow"

# $HOME itself may contain a symlink (macOS /var -> /private/var); stored paths are canonical
WSM_HOME=$(cd -P -- "$HOME" 2>/dev/null && pwd -P) || WSM_HOME="$HOME"

# Exit codes
EX_NOTFOUND=1 EX_AMBIGUOUS=2 EX_STALE=3
EX_USAGE=64 EX_UNAVAIL=69 EX_EXISTS=73

# Names are <ws>/<space> (lib/anfs resolve.sh): a spec is source-qualified with three segments
ANFS_NAME_PARTS=2
# A space is one directory, the highest-priority one: spaces do not layer like packages
ANFS_RESOLVE_FIRST=true

CLI_TOOL=wsm
CLI_EX_USAGE=64
cli_cmd ls         "ls [SPEC] [-r|--repositories]"  "The sources' workspaces and spaces, and where each is installed;
or the repositories their space.yml files declare, and their state"
cli_cmd install    "install [SPEC [DIR]] [--dry-run]" "Stow levels into DIR/<source>/<ws>/<space> and clone their
repositories, dependencies first. SPEC is source/, source/ws,
source/ws/space, ws or ws/space; none is the level at ."
cli_cmd remove     "remove SPEC..."                "Unstow installed spaces (and a named ws or source); clones and your files stay"
cli_cmd new        "new [[SOURCE/]WS/]SPACE"       "Create a space in a source; the parts left out come from where
you are. Installed too when its workspace is"
cli_cmd add        "add FILE..."                   "Move files from an installed tree into the source and stow them back"
cli_cmd status     "status [SOURCE...]"            "What in the installed trees differs from the sources"
cli_cmd cd         "cd [-s] [QUERY]"               "Change to an installed space or workspace; -s, --source: its
directory in the source (requires the wsm shell function)"
cli_cmd path       "path [-s] [QUERY]"             "Print that path; no QUERY means the level containing ."
cli_cmd implode    "implode [-y]"                  "Unstow every installed level and delete wsm's state"
cli_cmd completion "completion <shell>"            "Output shell completion code (zsh)"
cli_cmd help       "help, --version"               "Show this help, or the version"

cmd_cd() {
  echo "wsm cd needs the wsm shell function (source ~/.config/sh/wsm.sh)" >&2
  exit 1
}

cli_help_epilogue() {
  cat <<'EOF'
A source's spaces/ holds workspaces, each a directory of spaces. Every directory at those depths
is one; each level may hold files and a space.yml:

  spaces/space.yml                  the source level: an org-wide mise.toml, ...
  spaces/<ws>/space.yml             a workspace: an opm.yml, ...
  spaces/<ws>/<space>/space.yml     a space: README, CLAUDE.md, ...

  depends: [org, infra/net]   # a space's: installed first, a sibling or <ws>/<space>
  repositories:               # cloned into the level's directory
    - url: git@github.com:you/thing
      path: repos/thing
      ref: main               # optional

install stows each level into <target>/<source>/<ws>/<space>/ (stow --no-folding, so directories
stay real), then clones the repositories of every space.yml under SPEC, and of the spaces it
depends on. A source lives in one target: DIR the first time, else $WSM_SPACES_HOME. Re-running
install restows and clones what is missing; it never pulls.

QUERY (cd, path) is space, ws/space or source/ws/space; failing those, ws or source/ws names
the workspace directory, and source/ the source's. An ambiguous query exits 2.
EOF
  printf '\nSpaces home: %s\n' "$(_display "$(_spaces_home)")"
}

# --- Output helpers -----------------------------------------------------------------------

warn() { echo "wsm: $*" >&2; }
die()  { echo "wsm: $*" >&2; exit 1; }
fail() { local code="$1"; shift; echo "wsm: $*" >&2; exit "$code"; }
usage_err() { echo "Usage: $*" >&2; exit "$EX_USAGE"; }

_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# Shorten a leading $HOME for display only; the stored value is always absolute
_display() {
  case "$1" in
    "$WSM_HOME")    printf '~\n' ;;
    "$WSM_HOME"/*)  printf '~/%s\n' "${1#"$WSM_HOME"/}" ;;
    *)              printf '%s\n' "$1" ;;
  esac
}

# Absolute, symlinks resolved, no trailing slash
_canon() { (cd -P -- "$1" 2>/dev/null && pwd -P); }

# A path as given, made absolute without touching the filesystem
_abs() {
  case "$1" in
    /*) printf '%s\n' "${1%/}" ;;
    .)  printf '%s\n' "$PWD" ;;
    *)  printf '%s\n' "$PWD/${1%/}" ;;
  esac
}

# The canonical form of a path that may not exist yet: its deepest existing directory resolved,
# the rest appended
_canon_maybe() {
  local p="$1" rest="" c
  while [[ ! -d "$p" && "$p" == */* ]]; do
    rest="/${p##*/}$rest" p="${p%/*}"
    [[ -n "$p" ]] || p=/
  done
  c=$(_canon "$p") || c="$p"
  printf '%s\n' "${c%/}$rest"
}

# The canonical path of an existing file or directory: its directory resolved, the name kept
_canon_file() {
  local d
  [[ -d "$1" && ! -L "$1" ]] && { _canon "$1"; return; }
  d=$(_canon "$(dirname -- "$1")") || return 1
  printf '%s/%s\n' "${d%/}" "$(basename -- "$1")"
}

# The canonical path a link points at (the directory it lands in must exist)
_link_target() {
  local t
  t=$(readlink -- "$1")
  [[ "$t" == /* ]] || t="$(dirname -- "$1")/$t"
  _canon_file "$t"
}

# <to> relative to directory <from>, both absolute and canonical: how stow writes its links
_relpath() {
  local from="$1" to="$2" up=""
  while [[ "$to" != "$from"/* ]]; do
    from=$(dirname -- "$from") up="../$up"
    [[ "$from" != / ]] || { printf '%s\n' "$up${to#/}"; return 0; }
  done
  printf '%s\n' "$up${to#"$from"/}"
}

# The default target: $WSM_SPACES_HOME, read from anfs.conf unexpanded, so ~ and $HOME are ours
_spaces_home() {
  local d="${WSM_SPACES_HOME:-$HOME/spaces}"
  case "$d" in
    "~"|"~/"*)          d="$HOME${d#\~}" ;;
    '$HOME'|'$HOME/'*)  d="$HOME${d#\$HOME}" ;;
  esac
  printf '%s\n' "$d"
}

_require_yq() {
  command -v yq >/dev/null 2>&1 || fail "$EX_UNAVAIL" "wsm needs yq (https://github.com/mikefarah/yq)"
}

_in_list() {
  local want="$1" x
  shift
  for x in "$@"; do [[ "$x" == "$want" ]] && return 0; done
  return 1
}

# A name of up to three parts: none empty, none . or .., no glob characters or whitespace, and
# nothing that reads as a path (a leading / or ~)
_valid_name() {
  local rest="$1" p
  [[ -n "$rest" ]] || return 1
  while :; do
    p="${rest%%/*}"
    case "$p" in
      ""|.|..|"~"*|*[*?[]*|*[[:space:]]*) return 1 ;;
    esac
    [[ "$rest" == */* ]] || return 0
    rest="${rest#*/}"
  done
}

_parts() { local s="${1//[^\/]/}"; echo $(( ${#s} + 1 )); }

# --- Stow ---------------------------------------------------------------------------------
#
# wsm stows with its own ignore list. stow reads $HOME/.stow-global-ignore, and without one
# falls back to a built-in list that drops README.*, LICENSE.* and .gitignore: right for a
# package's sources, wrong for a space, whose README is the point. So stow runs with HOME set to
# a directory holding wsm's list, which leaves the user's own HOME (and ppm's stow) alone.

WSM_STOW_IGNORE='# wsm stows with this list (stow reads $HOME/.stow-global-ignore, and wsm runs it with
# HOME here), so stow'"'"'s built-in one, which drops README.* and LICENSE.*, never applies
\.DS_Store'

_stow() {
  command -v stow >/dev/null 2>&1 || fail "$EX_UNAVAIL" "wsm needs GNU stow"
  local f="$WSM_STOW_HOME/.stow-global-ignore"
  if [[ ! -f "$f" || "$(cat "$f")" != "$WSM_STOW_IGNORE" ]]; then
    mkdir -p "$WSM_STOW_HOME"
    printf '%s\n' "$WSM_STOW_IGNORE" > "$f"
  fi
  HOME="$WSM_STOW_HOME" stow "$@"
}

# The --ignore arguments that keep a level's stow out of the levels below it: every directory
# that is a workspace (source level) or a space (workspace level). Sets STOW_IGN.
STOW_IGN=()
_stow_ignores() {
  local from="$1" level="$2" d n
  STOW_IGN=()
  [[ "$level" != space ]] || return 0
  for d in "$from"/*/; do
    [[ -d "$d" ]] || continue
    d="${d%/}" n="${d##*/}"
    STOW_IGN+=("--ignore=^${n//./\\.}\$")
  done
}

# --- Sources ------------------------------------------------------------------------------

# A workspace or space: any directory at that depth that is not hidden
_is_level() { [[ -d "$1" && "${1##*/}" != .* ]]; }

# The directory of source <name>: among the sources with spaces/ when they are loaded, else
# wherever anfs keeps it
_src_dir() {
  local i
  for i in ${ANFS_SRC_NAMES[@]+"${!ANFS_SRC_NAMES[@]}"}; do
    [[ "${ANFS_SRC_NAMES[$i]}" == "$1" ]] && { printf '%s\n' "${ANFS_SRC_DIRS[$i]}"; return 0; }
  done
  gitsrc_dir "$1"
}

_is_registered() {
  [[ -n "${GITSRC_NAMES[*]+x}" ]] || gitsrc_collect
  _in_list "$1" ${GITSRC_NAMES[@]+"${GITSRC_NAMES[@]}"}
}

# The source whose checkout holds canonical <path>, or return 1
_source_holding() {
  local n d
  [[ -n "${GITSRC_NAMES[*]+x}" ]] || gitsrc_collect
  for n in ${GITSRC_NAMES[@]+"${GITSRC_NAMES[@]}"}; do
    d=$(_canon "$(gitsrc_dir "$n")") || continue
    [[ "$1" == "$d" || "$1" == "$d"/* ]] && { printf '%s\n' "$n"; return 0; }
  done
  return 1
}

# --- Installed (the trackers) -------------------------------------------------------------
#
# One tracker per level installed: <src>.yml, <src>/<ws>.yml, <src>/<ws>/<space>.yml, each with
# the target, the directory it was stowed into and the files. INST_* are parallel arrays over the
# space trackers, ISRC_* over the source ones; each read with one yq call.

INST_ID=() INST_SRC=() INST_WS=() INST_SPACE=() INST_TARGET=() INST_DIR=() INST_FILE=()
ISRC_NAME=() ISRC_TARGET=() IWS_ID=() IWS_DIR=()

_installed_load() {
  INST_ID=() INST_SRC=() INST_WS=() INST_SPACE=() INST_TARGET=() INST_DIR=() INST_FILE=()
  ISRC_NAME=() ISRC_TARGET=() IWS_ID=() IWS_DIR=()
  local -a files=()
  local f s w p t d i=0
  for f in "$WSM_INSTALLED"/*/*/*.yml; do
    [[ -f "$f" ]] && files+=("$f")
  done
  if [[ ${#files[@]} -gt 0 ]]; then
    _require_yq
    # One field per line: never empty, but a path may hold a tab. A tracker without a dir is from
    # 0.2, which put a space at <target>/<ws>/<space>.
    while IFS= read -r s && IFS= read -r w && IFS= read -r p && IFS= read -r t && IFS= read -r d; do
      INST_ID+=("$s/$w/$p") INST_SRC+=("$s") INST_WS+=("$w") INST_SPACE+=("$p")
      INST_TARGET+=("$t") INST_DIR+=("$d") INST_FILE+=("${files[$i]}")
      i=$((i + 1))
    done < <(yq -N -r '.source, .workspace, .space, .target,
                       (.dir // (.target + "/" + .workspace + "/" + .space))' "${files[@]}")
  fi

  # The workspace levels (<src>/<ws>)
  files=()
  for f in "$WSM_INSTALLED"/*/*.yml; do
    [[ -f "$f" ]] && files+=("$f")
  done
  if [[ ${#files[@]} -gt 0 ]]; then
    _require_yq
    i=0
    while IFS= read -r d; do
      f="${files[$i]#"$WSM_INSTALLED"/}"
      IWS_ID+=("${f%.yml}") IWS_DIR+=("$d")
      i=$((i + 1))
    done < <(yq -N -r '.dir' "${files[@]}")
  fi

  files=()
  for f in "$WSM_INSTALLED"/*.yml; do
    [[ -f "$f" ]] && files+=("$f")
  done
  [[ ${#files[@]} -gt 0 ]] || return 0
  _require_yq
  i=0
  while IFS= read -r t; do
    s=$(basename -- "${files[$i]}" .yml)
    ISRC_NAME+=("$s") ISRC_TARGET+=("$t")
    i=$((i + 1))
  done < <(yq -N -r '.target' "${files[@]}")
}

# The target source <src> is installed in, or nothing
_src_target() {
  local j
  for j in ${ISRC_NAME[@]+"${!ISRC_NAME[@]}"}; do
    [[ "${ISRC_NAME[$j]}" == "$1" ]] && { printf '%s\n' "${ISRC_TARGET[$j]}"; return 0; }
  done
  # A space installed by 0.2, which kept no source tracker
  for j in ${INST_ID[@]+"${!INST_ID[@]}"}; do
    [[ "${INST_SRC[$j]}" == "$1" ]] && { printf '%s\n' "${INST_TARGET[$j]}"; return 0; }
  done
  return 0
}

_tracker_path() { printf '%s\n' "$WSM_INSTALLED/$1.yml"; }

# The files a tracker records, one per line
_tracker_files() { yq -r '.files[]?' "$1"; }

# Where level <id> is installed, or nothing
_installed_dir() {
  local f
  f=$(_tracker_path "$1")
  [[ -f "$f" ]] && yq -r '.dir // ""' "$f"
  return 0
}

# Whether a source or workspace level was installed by name (named: true in its tracker): it then
# stays when its last space is removed
_is_named() { [[ -f "$1" && "$(yq -r '.named // false' "$1")" == true ]]; }

# Usage: _tracker_write <tracker> <src> <ws> <space> <target> <dir> <named> <file>...
_tracker_write() {
  local file="$1"
  mkdir -p "$(dirname "$file")"
  S="$2" W="$3" P="$4" T="$5" D="$6" N="$7" A="$(_now)" F="$(shift 7; printf '%s\n' "$@")" \
    yq -n '.source = strenv(S) | .workspace = strenv(W) | .space = strenv(P) |
           .target = strenv(T) | .dir = strenv(D) | .installed_at = strenv(A) |
           (select(strenv(N) == "true") | .named) = true |
           .files = (strenv(F) | split("\n") | map(select(. != "")))' > "$file.tmp"
  mv -- "$file.tmp" "$file"
}

# Add one file to a tracker's list
_tracker_add_file() {
  F="$2" yq -i '.files = ((.files // []) + [strenv(F)] | unique)' "$1"
}

_rmdir_empty_up() {
  local dir="$1" stop="$2"
  while [[ "$dir" == "$stop"/* ]]; do
    rmdir -- "$dir" 2>/dev/null || return 0
    dir=$(dirname -- "$dir")
  done
}

# Unstow the level a tracker recorded, then remove what stow could not reach (links into a
# directory the source no longer has) — only links still pointing at the source's file, so
# anything the user replaced stays — then the directories that leaves empty, up to the target,
# and the tracker. Cloned repos and the user's own files keep a directory alive.
_unlink_unit() {
  local file="$1" src ws space target dir rel from level=source f dest
  {
    IFS= read -r src; IFS= read -r ws; IFS= read -r space; IFS= read -r target; IFS= read -r dir
  } < <(yq -N -r '.source, (.workspace // ""), (.space // ""), .target,
                  (.dir // (.target + "/" + .workspace + "/" + .space))' "$file")
  rel="$ws${space:+/$space}"
  [[ -n "$ws" ]] && level=ws
  [[ -n "$space" ]] && level=space
  from="$(_src_dir "$src")/spaces${rel:+/$rel}"
  if [[ -d "$from" && -d "$dir" ]]; then
    _stow_ignores "$from" "$level"
    _stow -D --no-folding -d "$(dirname -- "$from")" -t "$dir" \
      ${STOW_IGN[@]+"${STOW_IGN[@]}"} "$(basename -- "$from")" >/dev/null 2>&1 || true
  fi
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    dest="$dir/$f"
    if [[ -L "$dest" ]]; then
      case "$(readlink -- "$dest")" in
        */spaces/"${rel:+$rel/}$f") rm -f -- "$dest" ;;
        *) continue ;;
      esac
    fi
    _rmdir_empty_up "$(dirname -- "$dest")" "$dir"
  done < <(_tracker_files "$file")
  _rmdir_empty_up "$dir" "$target"
  rm -f -- "$file"
  _rmdir_empty_up "$(dirname -- "$file")" "$WSM_INSTALLED"
}

# Whether any space of <src> (or of <src>/<ws>) is still installed
_has_spaces() {
  local f
  for f in "$WSM_INSTALLED/$1"/${2:-*}/*.yml; do [[ -f "$f" ]] && return 0; done
  return 1
}

# After spaces are removed: unstow the workspace and source levels no space is left under, unless
# they were installed by name. A source stays while one of its workspaces does.
# Usage: _unlink_orphans <src/ws>...
_unlink_orphans() {
  local sw src ws f
  local -a srcs=()
  for sw in "$@"; do
    src="${sw%%/*}" ws="${sw#*/}"
    _in_list "$src" ${srcs[@]+"${srcs[@]}"} || srcs+=("$src")
    [[ -n "$ws" && "$ws" != "$sw" ]] || continue
    _has_spaces "$src" "$ws" && continue
    f=$(_tracker_path "$src/$ws")
    [[ -f "$f" ]] && ! _is_named "$f" && _unlink_unit "$f"
  done
  for src in ${srcs[@]+"${srcs[@]}"}; do
    _has_spaces "$src" && continue
    for f in "$WSM_INSTALLED/$src"/*.yml; do
      [[ -f "$f" ]] && continue 2
    done
    f=$(_tracker_path "$src")
    [[ -f "$f" ]] && ! _is_named "$f" && _unlink_unit "$f"
  done
  return 0
}

# --- Stowing ------------------------------------------------------------------------------

# The files of one level of spaces/, relative, sorted: a space is everything below it; a workspace
# or the source level what is not inside one of the (non-hidden) directories below it.
# Usage: _unit_files <dir> <source|ws|space>
_unit_files() {
  local dir="$1" level="$2" d
  local -a prune=()
  [[ -d "$dir" ]] || return 0
  if [[ "$level" != space ]]; then
    for d in "$dir"/*/; do
      [[ -d "$d" ]] && prune+=(-path "./$(basename -- "$d")" -o)
    done
  fi
  (
    cd "$dir"
    find . \( "${prune[@]+"${prune[@]}"}" -false \) -prune -o \
      \( -type f -o -type l \) ! -name .DS_Store -print | sed 's|^\./||' | LC_ALL=C sort
  )
}

# Stow one level (<from>, at <level>) into <root>: stow --no-folding, so every directory is real
# and what install clones lands in the target, never in the source. All or nothing: anything in
# the way fails the level before stow runs (stow would refuse it too, less legibly). A link the
# previous install recorded (OLD_FILES) is ours to replace, and one whose file left the source is
# removed. A space always reports; the source and workspace levels only when they have files.
# Usage: _link_unit <from> <root> <level> <dry> <header>   (sets LINKED to the files)
OLD_FILES=() LINKED=()
_link_unit() {
  local from="$1" root="$2" level="$3" dry="$4" header="$5" f dest t cfrom out
  local conflicts=0 made=0 gone
  local -a gone_files=() stale=()
  LINKED=()
  while IFS= read -r f; do
    [[ -n "$f" ]] && LINKED+=("$f")
  done < <(_unit_files "$from" "$level")
  for f in ${OLD_FILES[@]+"${OLD_FILES[@]}"}; do
    _in_list "$f" ${LINKED[@]+"${LINKED[@]}"} && continue
    [[ -L "$root/$f" ]] && gone_files+=("$f")
  done
  gone=${#gone_files[@]}

  [[ "$level" == space || ${#LINKED[@]} -gt 0 || $gone -gt 0 ]] || return 0
  echo "$header"

  cfrom=$(_canon "$from")
  for f in ${LINKED[@]+"${LINKED[@]}"}; do
    dest="$root/$f"
    if [[ -L "$dest" ]]; then
      t=$(_link_target "$dest" 2>/dev/null) || t=""
      if [[ "$t" == "$cfrom/$f" && "$(readlink -- "$dest")" != /* ]]; then
        continue   # stowed already
      elif [[ "$t" == "$cfrom/$f" || "$t" == "$cfrom"/* ]] || _in_list "$f" ${OLD_FILES[@]+"${OLD_FILES[@]}"}; then
        stale+=("$f")   # ours, but not as stow would have it (an absolute link from wsm 0.3)
      else
        warn "in the way: $(_display "$dest")"
        conflicts=$((conflicts + 1))
      fi
    elif [[ -e "$dest" ]]; then
      warn "in the way: $(_display "$dest")"
      conflicts=$((conflicts + 1))
    fi
    made=$((made + 1))
  done
  [[ $conflicts -eq 0 ]] || return 1

  if ! $dry; then
    for f in ${stale[@]+"${stale[@]}"}; do rm -f -- "$root/$f"; done
    if [[ $made -gt 0 ]]; then
      mkdir -p -- "$root"
      _stow_ignores "$from" "$level"
      if ! out=$(_stow --no-folding -d "$(dirname -- "$from")" -t "$root" \
                   ${STOW_IGN[@]+"${STOW_IGN[@]}"} "$(basename -- "$from")" 2>&1); then
        warn "stow failed for $(_display "$root"):"
        printf '%s\n' "$out" >&2
        return 1
      fi
    fi
    for f in ${gone_files[@]+"${gone_files[@]}"}; do
      rm -f -- "$root/$f"
      _rmdir_empty_up "$(dirname -- "$root/$f")" "$root"
    done
  fi

  local verb=linked
  $dry && verb="would link"
  printf '  %s %d of %d file(s)' "$verb" "$made" "${#LINKED[@]}"
  [[ $gone -eq 0 ]] || printf ', %s %d gone from the source' "$($dry && echo would unlink || echo unlinked)" "$gone"
  printf '\n'
}

# Stow one level of <src>'s spaces/ (the source itself, a workspace or a space) into <target>
# and record it. A level installed by name stays named on later installs.
# Usage: _install_unit <src> <ws> <space> <target> <dry> [named]   (ws, space may be empty)
_install_unit() {
  local src="$1" ws="$2" space="$3" target="$4" dry="$5" named="${6:-false}" id rel level from root tracker f
  rel="$ws${space:+/$space}"
  id="$src${rel:+/$rel}"
  level=source
  [[ -n "$ws" ]] && level=ws
  [[ -n "$space" ]] && level=space
  from="$(_src_dir "$src")/spaces${rel:+/$rel}"
  root="$target/$src${rel:+/$rel}"
  tracker=$(_tracker_path "$id")

  OLD_FILES=()
  _is_named "$tracker" && named=true
  if [[ -f "$tracker" ]]; then
    while IFS= read -r f; do [[ -n "$f" ]] && OLD_FILES+=("$f"); done < <(_tracker_files "$tracker")
  fi
  local label="$level"
  [[ "$level" == ws ]] && label=workspace
  _link_unit "$from" "$root" "$level" "$dry" "$label $id -> $(_display "$root")" || return 1
  $dry || _tracker_write "$tracker" "$src" "$ws" "$space" "$target" "$root" "$named" ${LINKED[@]+"${LINKED[@]}"}
}

# --- Repositories -------------------------------------------------------------------------
#
# A space.yml at any level lists the repositories to clone into that level's directory:
#   repositories: [{url, path, ref?}]

# A path from space.yml must stay inside its level
_repo_path_ok() {
  case "$1" in
    "") return 1 ;;
    /*) return 1 ;;
    ..|../*|*/../*|*/..) return 1 ;;
  esac
  return 0
}

# The directory git clone would make for <url>: its last part, without a trailing / or .git
# (git@host:org/app.git, https://host/org/app, /srv/app.git: app). Nothing if it has none.
_repo_name() {
  local n="${1%/}"
  n="${n%.git}" n="${n%/}"
  n="${n##*/}" n="${n##*:}"
  [[ -n "$n" && "$n" != . && "$n" != .. ]] && printf '%s\n' "$n"
  return 0
}

# The repositories a space.yml declares, three lines each: url, path, ref. A path left out is
# the one git clone would use (_repo_name), and a trailing / is dropped.
_repo_entries() {
  [[ -f "$1" ]] || return 0
  local url path ref
  while IFS= read -r url && IFS= read -r path && IFS= read -r ref; do
    [[ -n "$url$path" ]] || continue
    [[ -n "$path" ]] || path=$(_repo_name "$url")
    path=$(printf '%s' "$path" | sed 's|/*$||')
    printf '%s\n%s\n%s\n' "$url" "$path" "$ref"
  done < <(yq -r '.repositories[]? | [(.url // ""), (.path // ""), (.ref // "")] | .[]' "$1" 2>/dev/null)
}

# The repository paths a space.yml declares, one per line
_repo_paths() {
  local url path ref
  while IFS= read -r url && IFS= read -r path && IFS= read -r ref; do
    [[ -n "$path" ]] && printf '%s\n' "$path"
  done < <(_repo_entries "$1")
  return 0
}

# Clone the repositories <file> declares into the level at <root>
# Usage: _repositories <root> <file> <dry:true|false>
_repositories() {
  local root="$1" file="$2" dry="$3"
  command -v git >/dev/null 2>&1 || fail "$EX_UNAVAIL" "install needs git"

  # One field per line rather than @tsv: tab is IFS whitespace, so `IFS=$TAB read` collapses
  # adjacent tabs and an entry with a field left out would slide the rest along by one.
  local url path ref target cloned=0 present=0 failed=0 seen=$'\n'
  while IFS= read -r url && IFS= read -r path && IFS= read -r ref; do
    if [[ -z "$url" ]] || ! _repo_path_ok "$path"; then
      warn "a repository needs a url, and a path inside its level (git's name for it when left out): url='$url' path='$path'"
      failed=$((failed + 1))
      continue
    fi
    # Two repositories in one place would pass the second off as present
    if [[ "$seen" == *$'\n'"$path"$'\n'* ]]; then
      warn "two repositories in $path: give one of them a path ($url)"
      failed=$((failed + 1))
      continue
    fi
    seen="$seen$path"$'\n'

    target="$root/$path"
    if [[ -d "$target/.git" ]]; then
      # Deliberately no pull: a pull can conflict or fail, and what is checked out is the user's
      echo "  present $path"
      present=$((present + 1))
      continue
    fi
    if [[ -e "$target" || -L "$target" ]]; then
      warn "in the way and not a git repo: $path"
      failed=$((failed + 1))
      continue
    fi
    if $dry; then
      echo "  would clone $path <- $url"
      cloned=$((cloned + 1))
      continue
    fi

    mkdir -p "$(dirname "$target")"
    if ! git clone -q -- "$url" "$target"; then
      warn "clone failed: $url"
      rm -rf "$target"
      failed=$((failed + 1))
      continue
    fi
    # A ref is checked out after the clone rather than passed as --branch, so a commit SHA works
    if [[ -n "$ref" ]] && ! git -C "$target" checkout -q "$ref"; then
      warn "cloned $path but could not check out '$ref'"
      failed=$((failed + 1))
      continue
    fi
    echo "  cloned $path"
    cloned=$((cloned + 1))
  done < <(_repo_entries "$file")

  [[ $((cloned + present + failed)) -eq 0 ]] ||
    printf '  %d cloned, %d present, %d failed\n' "$cloned" "$present" "$failed"
  [[ $failed -eq 0 ]]
}

# Clone the repositories of the space.yml at one installed level, if it has one: the stowed
# link in the tree, or the source's file on a dry run
# Usage: _level_repositories <root> <from> <dry>
_level_repositories() {
  local root="$1" from="$2" dry="$3" file="$1/space.yml"
  [[ -f "$file" ]] || file="$from/space.yml"
  [[ -f "$file" ]] || return 0
  _repositories "$root" "$file" "$dry"
}

# --- install ------------------------------------------------------------------------------

# The spaces a space depends on, as <ws>/<space> (anfs_resolve's deps callback). A bare name is a
# sibling in the same workspace.
_space_deps() {
  local file="$1/space.yml" ws dep
  [[ -f "$file" ]] || return 0
  ws=$(basename -- "$(dirname -- "$1")")
  while IFS= read -r dep; do
    [[ -n "$dep" ]] || continue
    case "$dep" in
      */*) printf '%s\n' "$dep" ;;
      *)   printf '%s/%s\n' "$ws" "$dep" ;;
    esac
  done < <(yq -r '.depends[]? // ""' "$file" 2>/dev/null)
}

# Append source/ws/space to WANTED for every space of <src>'s workspace <ws> (all of them: *).
# A level with no spaces is still installed: the spec names it.
_want_workspace() {
  local src="$1" ws="$2" d
  for d in "$(_src_dir "$src")/spaces"/$ws/*/; do
    [[ -d "$d" ]] || continue
    d="${d%/}"
    _is_level "$d" && _is_level "$(dirname -- "$d")" || continue
    WANTED+=("$src/$(basename -- "$(dirname -- "$d")")/$(basename -- "$d")")
  done
}

# Turn the install spec into source/ws/space entries (WANTED), and note the level it names
# (SPEC_LEVEL: source, ws or space; SPEC_SRC, SPEC_WS): the source and workspace levels' own
# repositories are cloned only when the spec names them or a level above. Or return 1.
WANTED=() SPEC_LEVEL="" SPEC_SRC="" SPEC_WS=""
_expand_spec() {
  local spec="$1" a b i
  SPEC_LEVEL=space SPEC_SRC="" SPEC_WS=""
  case "$spec" in
    */)
      a="${spec%/}"
      anfs_is_source "$a" || { warn "'$a' is not an anfs source with spaces (anfs src list)"; return 1; }
      SPEC_LEVEL=source SPEC_SRC="$a"
      _want_workspace "$a" '*'
      ;;
    */*/*)
      WANTED+=("$spec")
      ;;
    */*)
      a="${spec%%/*}" b="${spec#*/}"
      # source/ws when that names one, else a bare ws/space for the resolver
      if anfs_is_source "$a" && _is_level "$(_src_dir "$a")/spaces/$b"; then
        SPEC_LEVEL=ws SPEC_SRC="$a" SPEC_WS="$b"
        _want_workspace "$a" "$b"
      else
        WANTED+=("$spec")
      fi
      ;;
    *)
      # A bare workspace: the highest-priority source that has it; failing that, a source
      for i in ${ANFS_SRC_NAMES[@]+"${!ANFS_SRC_NAMES[@]}"}; do
        if _is_level "${ANFS_SRC_DIRS[$i]}/spaces/$spec"; then
          SPEC_LEVEL=ws SPEC_SRC="${ANFS_SRC_NAMES[$i]}" SPEC_WS="$spec"
          _want_workspace "${ANFS_SRC_NAMES[$i]}" "$spec"
          return 0
        fi
      done
      if anfs_is_source "$spec"; then
        SPEC_LEVEL=source SPEC_SRC="$spec"
        _want_workspace "$spec" '*'
        return 0
      fi
      warn "no workspace or source named '$spec'"
      return 1
      ;;
  esac
}

# Refuse a target inside a source checkout (the source would be stowed into itself, and what
# install clones would land in it) or inside another source's installed tree
_target_check() {
  local target="$1" s j
  if s=$(_source_holding "$target"); then
    warn "$(_display "$target") is inside the source $s: install somewhere else"
    return 1
  fi
  for j in ${ISRC_NAME[@]+"${!ISRC_NAME[@]}"}; do
    s="${ISRC_TARGET[$j]}/${ISRC_NAME[$j]}"
    if [[ "$target" == "$s" || "$target" == "$s"/* ]]; then
      warn "$(_display "$target") is inside $(_display "$s"), where ${ISRC_NAME[$j]} is installed"
      return 1
    fi
  done
}

# The spec for the level at the current directory, which must hold a space.yml: in an installed
# tree or in a source's spaces/
_spec_here() {
  local here
  [[ -f space.yml ]] || usage_err "wsm install SPEC [DIR] (no space.yml in the current directory)"
  _installed_load
  here=$(_canon "$PWD") || here="$PWD"
  if ! _context "$here" || ! $CTX_SPACES; then
    fail "$EX_NOTFOUND" "not inside a source's spaces/ or an installed tree: wsm install SPEC"
  fi
  case $([[ -z "$CTX_REL" ]] && echo 0 || _parts "$CTX_REL") in
    0) printf '%s/\n' "$CTX_SRC" ;;
    1|2) printf '%s/%s\n' "$CTX_SRC" "$CTX_REL" ;;
    *) fail "$EX_NOTFOUND" "not a source, workspace or space directory: $(_display "$here")" ;;
  esac
}

cmd_install() {
  local dry=false spec="" dir="" arg u="wsm install [SPEC [DIR]] [--dry-run]"
  for arg in "$@"; do
    case "$arg" in
      --dry-run) dry=true ;;
      -*)        usage_err "$u" ;;
      *)
        if [[ -z "$spec" ]]; then spec="$arg"
        elif [[ -z "$dir" ]]; then dir="$arg"
        else usage_err "$u"
        fi
        ;;
    esac
  done
  if [[ -z "$spec" ]]; then
    spec=$(_spec_here)
    echo "install $spec"
  fi
  if ! _valid_name "${spec%/}" || [[ "$spec" == */ && "${spec%/}" == */* ]] || [[ $(_parts "${spec%/}") -gt 3 ]]; then
    case "$spec" in
      .|..|/*|./*|../*|"~"*) warn "'$spec' is a directory, not a space: wsm install SPEC $spec" ;;
    esac
    usage_err "$u"
  fi
  _require_yq

  anfs_sources spaces
  WANTED=()
  _expand_spec "$spec" || exit "$EX_NOTFOUND"

  # Dependency order; a missing space or a cycle exits here, before anything is stowed
  ANFS_ORDER=() ANFS_ORDER_DIRS=()
  if [[ ${#WANTED[@]} -gt 0 ]]; then
    ( anfs_resolve spaces _space_deps "${WANTED[@]}" ) >/dev/null || exit "$EX_NOTFOUND"
    anfs_resolve spaces _space_deps "${WANTED[@]}"
  fi
  _installed_load

  # A source lives in one target: where it is installed, else DIR, else the spaces home. DIR is
  # held to that only for the sources the spec names; a dependency from another source goes
  # wherever that source already is.
  local want i id src w t
  local -a srcs=() targets=() named=() all=()
  [[ -z "$SPEC_SRC" ]] || named+=("$SPEC_SRC")
  for w in ${WANTED[@]+"${WANTED[@]}"}; do
    _in_list "${w%%/*}" ${named[@]+"${named[@]}"} || named+=("${w%%/*}")
  done
  all=(${named[@]+"${named[@]}"})
  for w in ${ANFS_ORDER[@]+"${ANFS_ORDER[@]}"}; do all+=("${w%%/*}"); done
  want=$(_canon_maybe "$(_abs "${dir:-$(_spaces_home)}")")
  for src in ${all[@]+"${all[@]}"}; do
    _in_list "$src" ${srcs[@]+"${srcs[@]}"} && continue
    t=$(_src_target "$src")
    if [[ -n "$t" && -n "$dir" && "$t" != "$want" ]] && _in_list "$src" "${named[@]}"; then
      fail "$EX_NOTFOUND" "$src is installed in $(_display "$t"), and a source lives in one target: wsm remove $src/ first, or leave out DIR"
    fi
    [[ -n "$t" ]] || { _target_check "$want" || exit "$EX_NOTFOUND"; t="$want"; }
    srcs+=("$src") targets+=("$t")
  done

  local rest ws space sdir done_units=" " failed=0 j d
  # The level the spec names, and for a source every workspace in it, whether or not it has
  # spaces: installed by name, with their repositories
  if [[ -n "$SPEC_SRC" ]]; then
    src="$SPEC_SRC" sdir=$(_src_dir "$SPEC_SRC")/spaces
    for j in "${!srcs[@]}"; do [[ "${srcs[$j]}" == "$src" ]] && t="${targets[$j]}"; done
    $dry || mkdir -p -- "$t" || die "cannot create $t"
    done_units="$done_units$src "
    if _install_unit "$src" "" "" "$t" "$dry" "$([[ "$SPEC_LEVEL" == source ]] && echo true || echo false)"; then
      if [[ "$SPEC_LEVEL" == source ]]; then
        _level_repositories "$t/$src" "$sdir" "$dry" || failed=$((failed + 1))
      fi
    else
      failed=$((failed + 1))
    fi
    for d in "$sdir"/*/; do
      d="${d%/}"
      _is_level "$d" || continue
      ws="${d##*/}"
      [[ "$SPEC_LEVEL" == source || "$ws" == "$SPEC_WS" ]] || continue
      done_units="$done_units$src/$ws "
      if _install_unit "$src" "$ws" "" "$t" "$dry" true; then
        _level_repositories "$t/$src/$ws" "$sdir/$ws" "$dry" || failed=$((failed + 1))
      else
        failed=$((failed + 1))
      fi
    done
  fi

  for i in ${ANFS_ORDER[@]+"${!ANFS_ORDER[@]}"}; do
    id="${ANFS_ORDER[$i]}"
    src="${id%%/*}" rest="${id#*/}"
    ws="${rest%%/*}" space="${rest#*/}"
    sdir=$(_src_dir "$src")/spaces
    for j in "${!srcs[@]}"; do [[ "${srcs[$j]}" == "$src" ]] && t="${targets[$j]}"; done
    if ! $dry; then
      mkdir -p -- "$t" || die "cannot create $t"
    fi

    # The levels above the space, once each (their repositories only when named, above)
    if [[ "$done_units" != *" $src "* ]]; then
      done_units="$done_units$src "
      _install_unit "$src" "" "" "$t" "$dry" || failed=$((failed + 1))
    fi
    if [[ "$done_units" != *" $src/$ws "* ]]; then
      done_units="$done_units$src/$ws "
      _install_unit "$src" "$ws" "" "$t" "$dry" || failed=$((failed + 1))
    fi

    _install_unit "$src" "$ws" "$space" "$t" "$dry" || { failed=$((failed + 1)); continue; }
    _level_repositories "$t/$id" "${ANFS_ORDER_DIRS[$i]}" "$dry" || failed=$((failed + 1))
  done
  [[ $failed -eq 0 ]]
}

# --- Matching installed spaces ------------------------------------------------------------

# Indexes of the installed spaces <spec> names, into MATCHES: source/, source/ws/space,
# ws/space or source/ws, and space or ws
MATCHES=()
_match_installed() {
  local spec="$1" j s w p
  MATCHES=()
  for j in ${INST_ID[@]+"${!INST_ID[@]}"}; do
    s="${INST_SRC[$j]}" w="${INST_WS[$j]}" p="${INST_SPACE[$j]}"
    case "$spec" in
      */)    [[ "$s/" == "$spec" ]] ;;
      */*/*) [[ "$s/$w/$p" == "$spec" ]] ;;
      */*)   [[ "$w/$p" == "$spec" || "$s/$w" == "$spec" ]] ;;
      *)     [[ "$p" == "$spec" || "$w" == "$spec" ]] ;;
    esac && MATCHES+=("$j")
  done
  [[ ${#MATCHES[@]} -gt 0 ]]
}

# --- Where you are ------------------------------------------------------------------------
#
# new, add and install work out the source (and workspace) from a path: inside an installed tree,
# <target>/<src>/..., or inside a source checkout, <source>/spaces/... CTX_REL is the path below
# the source's spaces/ (empty at its top, or outside spaces/ in a checkout: CTX_SPACES=false).

CTX_SRC="" CTX_REL="" CTX_KIND="" CTX_ROOT="" CTX_SPACES=true
_context() {
  local p="$1" j root d
  CTX_SRC="" CTX_REL="" CTX_KIND="" CTX_ROOT="" CTX_SPACES=true
  for j in ${ISRC_NAME[@]+"${!ISRC_NAME[@]}"}; do
    root="${ISRC_TARGET[$j]}/${ISRC_NAME[$j]}"
    if [[ "$p" == "$root" || "$p" == "$root"/* ]]; then
      CTX_SRC="${ISRC_NAME[$j]}" CTX_KIND=installed CTX_ROOT="$root"
      CTX_REL="${p#"$root"}" CTX_REL="${CTX_REL#/}"
      return 0
    fi
  done
  CTX_SRC=$(_source_holding "$p") || { CTX_SRC=""; return 1; }
  CTX_KIND=source
  d=$(_canon "$(gitsrc_dir "$CTX_SRC")")
  CTX_ROOT="$d/spaces"
  if [[ "$p" == "$d/spaces" || "$p" == "$d/spaces"/* ]]; then
    CTX_REL="${p#"$d/spaces"}" CTX_REL="${CTX_REL#/}"
  else
    CTX_SPACES=false
  fi
}

# --- Commands -----------------------------------------------------------------------------

cmd_remove() {
  local spec j rc=0 f
  local -a specs=() drop=() sws=()
  for spec in "$@"; do
    case "$spec" in
      -*) usage_err "wsm remove SPEC..." ;;
      *)  specs+=("$spec") ;;
    esac
  done
  [[ ${#specs[@]} -gt 0 ]] || usage_err "wsm remove SPEC..."

  _installed_load
  anfs_sources spaces
  local found id
  local -a levels=()
  for spec in "${specs[@]}"; do
    found=false
    if _match_installed "$spec"; then
      found=true
      for j in "${MATCHES[@]}"; do
        _in_list "$j" ${drop[@]+"${drop[@]}"} || drop+=("$j")
      done
    fi
    # A workspace the spec names goes too, even one installed by name: source/ws or a bare ws
    for j in ${IWS_ID[@]+"${!IWS_ID[@]}"}; do
      id="${IWS_ID[$j]}"
      case "$spec" in
        */|*/*/*) false ;;
        */*)   [[ "$id" == "$spec" ]] ;;
        *)     [[ "${id#*/}" == "$spec" ]] ;;
      esac || continue
      found=true
      _in_list "$id" ${levels[@]+"${levels[@]}"} || levels+=("$id")
    done
    # And a source: source/, or a bare name that matched nothing else
    local whole=false
    case "$spec" in */) whole=true ;; */*) ;; *) $found || whole=true ;; esac
    for j in ${ISRC_NAME[@]+"${!ISRC_NAME[@]}"}; do
      $whole && [[ "${ISRC_NAME[$j]}" == "${spec%/}" ]] || continue
      found=true
      if _match_installed "${spec%/}/"; then
        for f in "${MATCHES[@]}"; do
          _in_list "$f" ${drop[@]+"${drop[@]}"} || drop+=("$f")
        done
      fi
      for f in ${IWS_ID[@]+"${IWS_ID[@]}"}; do
        [[ "${f%%/*}" == "${spec%/}" ]] || continue
        _in_list "$f" ${levels[@]+"${levels[@]}"} || levels+=("$f")
      done
      _in_list "${ISRC_NAME[$j]}" ${levels[@]+"${levels[@]}"} || levels+=("${ISRC_NAME[$j]}")
    done
    if ! $found; then
      warn "not installed: $spec"
      rc=$EX_NOTFOUND
    fi
  done

  for j in ${drop[@]+"${drop[@]}"}; do
    _unlink_unit "${INST_FILE[$j]}"
    _in_list "${INST_SRC[$j]}/${INST_WS[$j]}" ${sws[@]+"${sws[@]}"} || sws+=("${INST_SRC[$j]}/${INST_WS[$j]}")
    printf 'removed %s %s\n' "${INST_ID[$j]}" "$(_display "${INST_DIR[$j]}")"
  done
  # Workspaces before sources: a source's tree is gone only once nothing below it is installed
  for id in ${levels[@]+"${levels[@]}"}; do
    [[ "$id" == */* ]] || continue
    _has_spaces "${id%%/*}" "${id#*/}" && continue
    f=$(_tracker_path "$id")
    [[ -f "$f" ]] || continue
    printf 'removed %s %s\n' "$id" "$(_display "$(yq -r '.dir' "$f")")"
    _unlink_unit "$f"
    _in_list "$id" ${sws[@]+"${sws[@]}"} || sws+=("$id")
  done
  for id in ${levels[@]+"${levels[@]}"}; do
    [[ "$id" != */* ]] || continue
    _has_spaces "$id" && continue
    local -a left=()
    for f in "$WSM_INSTALLED/$id"/*.yml; do [[ -f "$f" ]] && left+=("$f"); done
    [[ ${#left[@]} -eq 0 ]] || continue
    f=$(_tracker_path "$id")
    [[ -f "$f" ]] || continue
    printf 'removed %s/ %s\n' "$id" "$(_display "$(yq -r '.dir' "$f")")"
    _unlink_unit "$f"
  done
  _unlink_orphans ${sws[@]+"${sws[@]}"}
  return "$rc"
}

# Resolve a cd/path query into one LABEL and DIR: a space first (source/ws/space, ws/space,
# space), then a workspace (source/ws, ws), then a source (source/, source). Exits 1 on no match
# and 2 on several, so it must be called directly, never in $(...).
Q_LABEL="" Q_DIR=""
_resolve_query() {
  local q="$1" j s w p
  local -a labels=() dirs=()
  for j in ${INST_ID[@]+"${!INST_ID[@]}"}; do
    s="${INST_SRC[$j]}" w="${INST_WS[$j]}" p="${INST_SPACE[$j]}"
    case "$q" in
      */) false ;;
      */*/*) [[ "$s/$w/$p" == "$q" ]] ;;
      */*)   [[ "$w/$p" == "$q" ]] ;;
      *)     [[ "$p" == "$q" ]] ;;
    esac || continue
    labels+=("$s/$w/$p") dirs+=("${INST_DIR[$j]}")
  done
  if [[ ${#labels[@]} -eq 0 ]]; then
    for j in ${INST_ID[@]+"${!INST_ID[@]}"}; do
      s="${INST_SRC[$j]}" w="${INST_WS[$j]}"
      case "$q" in
        */|*/*/*) false ;;
        */*)   [[ "$s/$w" == "$q" ]] ;;
        *)     [[ "$w" == "$q" ]] ;;
      esac || continue
      _in_list "$s/$w" ${labels[@]+"${labels[@]}"} && continue
      labels+=("$s/$w") dirs+=("$(dirname -- "${INST_DIR[$j]}")")
    done
    # A workspace installed with no space in it
    for j in ${IWS_ID[@]+"${!IWS_ID[@]}"}; do
      case "$q" in
        */|*/*/*) false ;;
        */*)   [[ "${IWS_ID[$j]}" == "$q" ]] ;;
        *)     [[ "${IWS_ID[$j]#*/}" == "$q" ]] ;;
      esac || continue
      _in_list "${IWS_ID[$j]}" ${labels[@]+"${labels[@]}"} && continue
      labels+=("${IWS_ID[$j]}") dirs+=("${IWS_DIR[$j]}")
    done
  fi
  if [[ ${#labels[@]} -eq 0 ]]; then
    for j in ${ISRC_NAME[@]+"${!ISRC_NAME[@]}"}; do
      [[ "${ISRC_NAME[$j]}" == "${q%/}" ]] || continue
      labels+=("${ISRC_NAME[$j]}/") dirs+=("${ISRC_TARGET[$j]}/${ISRC_NAME[$j]}")
    done
  fi
  [[ ${#labels[@]} -gt 0 ]] || fail "$EX_NOTFOUND" "no installed space or workspace matching '$q'"
  if [[ ${#labels[@]} -gt 1 ]]; then
    warn "'$q' is ambiguous:"
    for j in "${!labels[@]}"; do
      printf '%s  %s\n' "${labels[$j]}" "$(_display "${dirs[$j]}")" >&2
    done
    exit "$EX_AMBIGUOUS"
  fi
  Q_LABEL="${labels[0]}" Q_DIR="${dirs[0]}"
}

# The source directory an installed directory was stowed from: <src>/spaces/<the same path>
_source_of() {
  local d="$1" j root
  for j in ${ISRC_NAME[@]+"${!ISRC_NAME[@]}"}; do
    root="${ISRC_TARGET[$j]}/${ISRC_NAME[$j]}"
    if [[ "$d" == "$root" || "$d" == "$root"/* ]]; then
      d="${d#"$root"}"
      printf '%s/spaces%s\n' "$(_src_dir "${ISRC_NAME[$j]}")" "$d"
      return 0
    fi
  done
  fail "$EX_NOTFOUND" "no source directory for $(_display "$1")"
}

cmd_path() {
  local source=false q="" arg u="wsm path [-s|--source] [QUERY]"
  for arg in "$@"; do
    case "$arg" in
      -s|--source) source=true ;;
      -*) usage_err "$u" ;;
      *)  [[ -z "$q" ]] || usage_err "$u"; q="$arg" ;;
    esac
  done
  _installed_load

  # -s with a source-qualified name needs nothing installed: <src>/spaces/<the rest>
  local first d
  if $source && [[ -n "$q" ]]; then
    first="${q%%/*}"
    if _is_registered "$first"; then
      d="$(_src_dir "$first")/spaces"
      [[ "$q" != */?* ]] || d="$d/${q#*/}"
      d="${d%/}"
      [[ -d "$d" ]] || fail "$EX_NOTFOUND" "no such directory in $first: $(_display "$d")"
      printf '%s\n' "$d"
      return 0
    fi
  fi

  # No query: the deepest installed space, workspace or source directory containing the current
  # directory
  if [[ -z "$q" ]]; then
    local here j best=""
    local -a cands=()
    here=$(_canon "$PWD") || here="$PWD"
    for j in ${INST_ID[@]+"${!INST_ID[@]}"}; do
      cands+=("${INST_DIR[$j]}" "$(dirname -- "${INST_DIR[$j]}")")
    done
    for j in ${ISRC_NAME[@]+"${!ISRC_NAME[@]}"}; do
      cands+=("${ISRC_TARGET[$j]}/${ISRC_NAME[$j]}")
    done
    cands+=(${IWS_DIR[@]+"${IWS_DIR[@]}"})
    for d in ${cands[@]+"${cands[@]}"}; do
      [[ "$here" == "$d" || "$here" == "$d"/* ]] || continue
      [[ ${#d} -gt ${#best} ]] && best="$d"
    done
    [[ -n "$best" ]] || fail "$EX_NOTFOUND" "not inside an installed space"
    if $source; then _source_of "$best"; else printf '%s\n' "$best"; fi
    return 0
  fi

  _resolve_query "$q"
  if $source; then
    _source_of "$Q_DIR"
    return 0
  fi
  printf '%s\n' "$Q_DIR"
  # A gone directory still prints, so the cd wrapper can act on it
  if [[ ! -d "$Q_DIR" ]]; then
    warn "$Q_LABEL is stale: $(_display "$Q_DIR") is gone"
    exit "$EX_STALE"
  fi
}

# Print tab-separated rows: columns aligned on a terminal, the tabs kept otherwise
_columns() {
  local -a rows=() widths=() cols=()
  local line i out
  while IFS= read -r line; do rows+=("$line"); done
  [[ ${#rows[@]} -gt 0 ]] || return 0
  if [[ ! -t 1 ]]; then
    printf '%s\n' "${rows[@]}"
    return 0
  fi
  for line in "${rows[@]}"; do
    IFS=$'\t' read -r -a cols <<<"$line"
    for i in "${!cols[@]}"; do
      [[ ${#cols[$i]} -gt ${widths[$i]:-0} ]] && widths[$i]=${#cols[$i]}
    done
  done
  for line in "${rows[@]}"; do
    IFS=$'\t' read -r -a cols <<<"$line"
    out=""
    for i in "${!cols[@]}"; do
      if [[ $i -lt $((${#cols[@]} - 1)) ]]; then
        out="$out$(printf '%-*s  ' "${widths[$i]}" "${cols[$i]}")"
      else
        out="$out${cols[$i]}"
      fi
    done
    printf '%s\n' "$out"
  done
}

# Whether level id <id> (src/, src/ws, src/ws/space) is in the subtree <filter> names
_in_filter() {
  local id="${1%/}" f="${2%/}"
  [[ -z "$f" || "$id" == "$f" || "$id" == "$f"/* ]]
}

# One row for a level: its id, and where it is installed (- when it is not)
_ls_row() {
  local id="$1" d
  d=$(_installed_dir "${id%/}")
  if [[ -z "$d" ]]; then
    printf '%s\t-\n' "$id"
  else
    printf '%s\t%s%s\n' "$id" "$(_display "$d")" "$([[ -d "$d" ]] || echo ' (stale)')"
  fi
}

# One row per repository a level's space.yml declares: where it goes, its url and its state
_ls_repositories() {
  local id="$1" from="$2" file="$2/space.yml" d url path ref state
  [[ -f "$file" ]] || return 0
  d=$(_installed_dir "${id%/}")
  while IFS= read -r url && IFS= read -r path && IFS= read -r ref; do
    if [[ -z "$path" ]]; then
      state="no path"
    elif [[ -z "$d" ]]; then
      state="not installed"
    else
      state=$(gitsrc_dir_status "$d/$path")
      [[ "$state" != local ]] || state="not a repo"
    fi
    printf '%s\t%s\t%s\n' "${id%/}/$path" "${url:--}" "$state"
  done < <(_repo_entries "$file")
}

# `wsm ls [SPEC] [-r|--repositories]`: every source, workspace and space the sources define, each
# with where it is installed; SPEC (source/, source/ws, source/ws/space) narrows it to that
# subtree. With -r, the repositories their space.yml files declare instead, and their state.
cmd_ls() {
  local repos=false filter="" arg u="wsm ls [SPEC] [-r|--repositories]"
  for arg in "$@"; do
    case "$arg" in
      -r|--repositories) repos=true ;;
      -*)                usage_err "$u" ;;
      *)
        [[ -z "$filter" ]] || usage_err "$u"
        _valid_name "${arg%/}" && [[ $(_parts "${arg%/}") -le 3 ]] || usage_err "$u"
        filter="$arg"
        ;;
    esac
  done
  _require_yq
  _installed_load
  anfs_sources spaces

  local i name sd w s rows="" j
  for i in ${ANFS_SRC_NAMES[@]+"${!ANFS_SRC_NAMES[@]}"}; do
    name="${ANFS_SRC_NAMES[$i]}" sd="${ANFS_SRC_DIRS[$i]}/spaces"
    [[ -z "$filter" ]] || _in_filter "$name/" "$filter" || [[ "${filter%%/*}" == "$name" ]] || continue
    if _in_filter "$name/" "$filter"; then
      if $repos; then rows="$rows$(_ls_repositories "$name/" "$sd")"$'\n'
      else rows="$rows$(_ls_row "$name/")"$'\n'
      fi
    fi
    for w in "$sd"/*/; do
      w="${w%/}"
      _is_level "$w" || continue
      w="${w##*/}"
      if _in_filter "$name/$w" "$filter"; then
        if $repos; then rows="$rows$(_ls_repositories "$name/$w" "$sd/$w")"$'\n'
        else rows="$rows$(_ls_row "$name/$w")"$'\n'
        fi
      fi
      for s in "$sd/$w"/*/; do
        s="${s%/}"
        _is_level "$s" || continue
        s="${s##*/}"
        _in_filter "$name/$w/$s" "$filter" || continue
        if $repos; then rows="$rows$(_ls_repositories "$name/$w/$s" "$sd/$w/$s")"$'\n'
        else rows="$rows$(_ls_row "$name/$w/$s")"$'\n'
        fi
      done
    done
  done
  # Installed spaces their source no longer defines
  if ! $repos; then
    for j in ${INST_ID[@]+"${!INST_ID[@]}"}; do
      _in_filter "${INST_ID[$j]}" "$filter" || continue
      [[ -d "$(_src_dir "${INST_SRC[$j]}")/spaces/${INST_WS[$j]}/${INST_SPACE[$j]}" ]] && continue
      rows="$rows${INST_ID[$j]}"$'\t'"$(_display "${INST_DIR[$j]}") (not in the source)"$'\n'
    done
  fi
  rows=$(printf '%s' "$rows" | grep . || true)
  [[ -n "$rows" || -z "$filter" ]] || fail "$EX_NOTFOUND" "nothing defined under $filter"
  [[ -n "$rows" ]] || return 0
  printf '%s\n' "$rows" | _columns
}

# `wsm new [[SOURCE/]WS/]SPACE`: the parts left out come from where you are, in a source checkout
# or an installed tree. The space is created in the source, and installed into its workspace's
# target when that workspace is installed.
cmd_new() {
  local u="wsm new [[SOURCE/]WS/]SPACE" spec src="" ws="" space here
  [[ $# -eq 1 && "$1" != -* ]] || usage_err "$u"
  spec="$1"
  _valid_name "$spec" || usage_err "$u"
  _installed_load
  gitsrc_collect

  case $(_parts "$spec") in
    3) src="${spec%%/*}" ws="${spec#*/}" ws="${ws%/*}" space="${spec##*/}" ;;
    2|1)
      here=$(_canon "$PWD") || here="$PWD"
      _context "$here" ||
        fail "$EX_NOTFOUND" "not inside a source or an installed tree: wsm new SOURCE/WS/SPACE"
      src="$CTX_SRC"
      if [[ "$spec" == */* ]]; then
        ws="${spec%/*}" space="${spec#*/}"
      else
        $CTX_SPACES && [[ -n "$CTX_REL" ]] ||
          fail "$EX_NOTFOUND" "not inside a workspace of $src: wsm new WS/$spec"
        ws="${CTX_REL%%/*}" space="$spec"
      fi
      ;;
    *) usage_err "$u" ;;
  esac
  [[ "$ws" != .* && "$space" != .* ]] || fail "$EX_USAGE" "a hidden directory is never a workspace or a space"
  _is_registered "$src" || fail "$EX_NOTFOUND" "no source '$src' on this machine (anfs src list)"

  local srcdir dir
  srcdir=$(gitsrc_dir "$src")
  [[ -d "$srcdir" ]] || fail "$EX_NOTFOUND" "source '$src' is not cloned (anfs src update)"
  dir="$srcdir/spaces/$ws/$space"
  [[ -e "$dir" ]] && fail "$EX_EXISTS" "already exists: $(_display "$dir")"
  mkdir -p -- "$dir"
  cat > "$dir/space.yml" <<EOF
# $ws/$space: \`wsm install $src/$ws/$space\` stows this directory's files into <target>/$src/$ws/$space
#depends: [other]          # spaces installed first: a sibling by name, or <ws>/<space>
repositories: []
#  - url: git@github.com:you/thing
#    path: repos/thing
#    ref: main             # optional
EOF
  printf 'created %s\n' "$(_display "$dir/space.yml")"

  local j inst=false
  for j in ${INST_ID[@]+"${!INST_ID[@]}"}; do
    [[ "${INST_SRC[$j]}/${INST_WS[$j]}" == "$src/$ws" ]] && inst=true
  done
  if $inst; then
    cmd_install "$src/$ws/$space"
  else
    echo "next: wsm install $src/$ws/$space"
  fi
  echo "commit it in $(_display "$srcdir")"
}

# Plain files under <dir>, as paths: not links (wsm's, or the user's own), not inside a git repo
# (a clone), not .DS_Store
_walk_local() {
  local e
  for e in "$1"/* "$1"/.[!.]* "$1"/..?*; do
    if [[ -L "$e" ]]; then
      continue
    elif [[ -d "$e" ]]; then
      [[ -e "$e/.git" ]] || _walk_local "$e"
    elif [[ -f "$e" ]]; then
      [[ "${e##*/}" == .DS_Store ]] || printf '%s\n' "$e"
    fi
  done
}

# The level a path below a source's spaces/ belongs to, by depth: a file in the first directory
# below spaces/ is a workspace's, below its second a space's; a hidden directory is never a level.
# Sets U_ID, U_WS, U_SPACE and U_FILE (the path within that level).
U_ID="" U_WS="" U_SPACE="" U_FILE=""
_unit_of() {
  local src="$1" rel="$2" a b rest
  U_ID="$src" U_WS="" U_SPACE="" U_FILE="$rel"
  [[ "$rel" == */* ]] || return 0
  a="${rel%%/*}" rest="${rel#*/}"
  [[ "$a" != .* ]] || return 0
  U_ID="$src/$a" U_WS="$a" U_FILE="$rest"
  [[ "$rest" == */* ]] || return 0
  b="${rest%%/*}"
  [[ "$b" != .* ]] || return 0
  U_ID="$src/$a/$b" U_SPACE="$b" U_FILE="${rest#*/}"
}

# Whether <rel> (below the spaces/ of source dir <srcdir>) is inside a repository the space.yml of
# its level, or of a level above, declares
_in_repository() {
  local srcdir="$1" src="$2" rel="$3" p l under
  _unit_of "$src" "$rel"
  for l in "" "$U_WS" "$U_WS/$U_SPACE"; do
    case "$l" in
      "") under="$rel" ;;
      /*|*/) continue ;;
      *) [[ "$rel" == "$l"/* ]] || continue; under="${rel#"$l"/}" ;;
    esac
    while IFS= read -r p; do
      [[ "$under" == "$p" || "$under" == "$p"/* ]] && return 0
    done < <(_repo_paths "$srcdir/spaces${l:+/$l}/space.yml")
  done
  return 1
}

# Move one file of an installed tree into its source and link it back as stow would (relative,
# to the canonical file), so the next install sees it as stowed. <explicit> is false when it was
# found under a directory given to add, which skips quietly what an explicit file would be refused
# for, and leaves a changed copy of a linked file alone.
# Usage: _add_one <canonical path> <explicit:true|false>
ADDED_SRCS=()
_add_one() {
  local path="$1" explicit="$2" src rel srcdir tracker dest d tracked=false
  _context "$path" || { warn "not in an installed tree: $(_display "$path")"; return 1; }
  if [[ "$CTX_KIND" != installed ]]; then
    warn "already in the source $CTX_SRC: $(_display "$path")"
    return 1
  fi
  src="$CTX_SRC" rel="$CTX_REL"
  if [[ -L "$path" ]]; then
    $explicit && warn "a link, not added: $(_display "$path")"
    return 0
  fi
  if [[ ! -f "$path" ]]; then
    warn "not a file: $(_display "$path")"
    return 1
  fi
  [[ "${path##*/}" != .DS_Store ]] || return 0

  # Never part of a clone
  d=$(dirname -- "$path")
  while [[ "$d" == "$CTX_ROOT"/* ]]; do
    if [[ -e "$d/.git" ]]; then
      $explicit && warn "inside a git repo, not added: $(_display "$path")"
      $explicit && return 1 || return 0
    fi
    d=$(dirname -- "$d")
  done

  srcdir=$(_src_dir "$src")
  if _in_repository "$srcdir" "$src" "$rel"; then
    $explicit && warn "inside a repository of $U_ID, not added: $(_display "$path")"
    $explicit && return 1 || return 0
  fi
  _unit_of "$src" "$rel"
  tracker=$(_tracker_path "$U_ID")
  if [[ ! -f "$tracker" ]]; then
    warn "$U_ID is not installed: $(_display "$path")"
    return 1
  fi
  if git -C "$srcdir" check-ignore -q -- "spaces/$rel" 2>/dev/null; then
    $explicit && warn "ignored by $src's .gitignore, not added: $(_display "$path")"
    $explicit && return 1 || return 0
  fi

  # Read whole first: grep -q stopping early would fail the pipeline under pipefail
  local recorded
  recorded=$'\n'$(_tracker_files "$tracker")$'\n'
  [[ "$recorded" == *$'\n'"$U_FILE"$'\n'* ]] && tracked=true
  dest="$srcdir/spaces/$rel"
  if [[ -e "$dest" || -L "$dest" ]]; then
    # A linked file replaced by a plain copy (some tools save by renaming over the link): named
    # explicitly, the copy goes back to the source, where git shows what changed
    if $tracked && $explicit; then
      mv -f -- "$path" "$dest"
      ln -s -- "$(_relpath "$(dirname -- "$path")" "$(_canon_file "$dest")")" "$path"
      printf 'updated %s (git diff in %s)\n' "$src/$rel" "$(_display "$srcdir")"
      _in_list "$src" ${ADDED_SRCS[@]+"${ADDED_SRCS[@]}"} || ADDED_SRCS+=("$src")
      return 0
    fi
    if $tracked; then
      warn "a linked file was replaced by a copy: wsm add $(_display "$path") puts it back in the source"
      return 0
    fi
    warn "$src already has $rel: wsm install $U_ID stows it (move yours aside first)"
    return 1
  fi

  mkdir -p -- "$(dirname -- "$dest")"
  mv -- "$path" "$dest"
  ln -s -- "$(_relpath "$(dirname -- "$path")" "$(_canon_file "$dest")")" "$path"
  _tracker_add_file "$tracker" "$U_FILE"
  printf 'added %s\n' "$src/$rel"
  _in_list "$src" ${ADDED_SRCS[@]+"${ADDED_SRCS[@]}"} || ADDED_SRCS+=("$src")
}

cmd_add() {
  local arg p rc=0 f
  [[ $# -gt 0 ]] || usage_err "wsm add FILE..."
  _require_yq
  _installed_load
  anfs_sources spaces
  ADDED_SRCS=()
  for arg in "$@"; do
    if [[ ! -e "$arg" && ! -L "$arg" ]]; then
      warn "no such file: $arg"
      rc=1
      continue
    fi
    p=$(_canon_file "$arg") || { warn "cannot resolve $arg"; rc=1; continue; }
    if [[ -d "$p" && ! -L "$arg" ]]; then
      if [[ -e "$p/.git" ]]; then
        warn "a git repo, not added: $(_display "$p")"
        rc=1
        continue
      fi
      while IFS= read -r f; do
        _add_one "$f" false || rc=1
      done < <(_walk_local "$p")
    else
      _add_one "$p" true || rc=1
    fi
  done
  for f in ${ADDED_SRCS[@]+"${ADDED_SRCS[@]}"}; do
    echo "commit it in $(_display "$(_src_dir "$f")")"
  done
  return "$rc"
}

# `wsm status [SOURCE...]`: for each installed source, what its tree and the source disagree on
cmd_status() {
  local arg
  local -a want=()
  for arg in "$@"; do
    case "$arg" in
      -*) usage_err "wsm status [SOURCE...]" ;;
      *)  want+=("${arg%/}") ;;
    esac
  done
  _require_yq
  _installed_load
  anfs_sources spaces

  local j src root srcdir f rel prefix dir level tracked any=false hint_add=false hint_install=false
  local -a trackers=() lines=() locals=()
  for j in ${ISRC_NAME[@]+"${!ISRC_NAME[@]}"}; do
    src="${ISRC_NAME[$j]}"
    [[ ${#want[@]} -eq 0 ]] || _in_list "$src" "${want[@]}" || continue
    any=true
    root="${ISRC_TARGET[$j]}/$src"
    srcdir=$(_src_dir "$src")
    lines=() tracked=$'\n'

    trackers=()
    for f in "$WSM_INSTALLED/$src.yml" "$WSM_INSTALLED/$src"/*.yml "$WSM_INSTALLED/$src"/*/*.yml; do
      [[ -f "$f" ]] && trackers+=("$f")
    done
    for f in ${trackers[@]+"${trackers[@]}"}; do
      dir=$(yq -r '.dir' "$f")
      prefix="${dir#"$root"}" prefix="${prefix#/}"
      level=space
      case "$prefix" in "") level=source ;; */*) ;; *) level=ws ;; esac
      local -a recorded=()
      while IFS= read -r rel; do
        [[ -n "$rel" ]] || continue
        recorded+=("$rel")
        tracked="$tracked${prefix:+$prefix/}$rel"$'\n'
        if [[ -L "$dir/$rel" ]]; then
          [[ -e "$dir/$rel" ]] || { lines+=("broken    ${prefix:+$prefix/}$rel"); hint_install=true; }
        elif [[ -f "$dir/$rel" ]]; then
          lines+=("changed   ${prefix:+$prefix/}$rel (a copy where the link was)"); hint_add=true
        else
          lines+=("missing   ${prefix:+$prefix/}$rel"); hint_install=true
        fi
      done < <(_tracker_files "$f")
      while IFS= read -r rel; do
        [[ -n "$rel" ]] || continue
        _in_list "$rel" ${recorded[@]+"${recorded[@]}"} && continue
        lines+=("unlinked  ${prefix:+$prefix/}$rel (new in the source)"); hint_install=true
      done < <(_unit_files "$srcdir/spaces${prefix:+/$prefix}" "$level")
    done

    # Local files: not recorded, not in a repository, not ignored by the source's .gitignore
    locals=()
    while IFS= read -r f; do
      rel="${f#"$root"/}"
      [[ "$tracked" == *$'\n'"$rel"$'\n'* ]] && continue
      _in_repository "$srcdir" "$src" "$rel" && continue
      locals+=("$rel")
    done < <([[ -d "$root" ]] && _walk_local "$root")
    if [[ ${#locals[@]} -gt 0 ]]; then
      local ignored
      ignored=$'\n'$(printf 'spaces/%s\n' "${locals[@]}" | git -C "$srcdir" check-ignore --stdin 2>/dev/null || true)$'\n'
      for rel in "${locals[@]}"; do
        [[ "$ignored" == *$'\n'"spaces/$rel"$'\n'* ]] && continue
        lines+=("local     $rel"); hint_add=true
      done
    fi

    printf '%s  %s\n' "$src" "$(_display "$root")"
    if [[ ${#lines[@]} -eq 0 ]]; then
      echo "  clean"
    else
      printf '  %s\n' "${lines[@]}"
    fi
  done
  $any || { [[ ${#want[@]} -eq 0 ]] && echo "Nothing installed" || fail "$EX_NOTFOUND" "not installed: ${want[*]}"; }
  $hint_add && echo "wsm add FILE... moves local files (and changed copies) into the source"
  $hint_install && echo "wsm install SPEC restows what the source has"
  return 0
}

cmd_completion() {
  case "${1:-}" in
    zsh)
      cat <<'COMPLETION'
#compdef wsm

# Installed spaces, as source/ws/space and the bare names a query also takes
_wsm_installed() {
  local -a ids
  ids=(${(f)"$(command wsm ls 2>/dev/null | awk -F'\t' '$2 != "-" && $1 !~ /\/$/ {print $1}')"})
  compadd -a ids
  compadd -- ${ids##*/}
}

_wsm() {
  local -a subcmds=(
COMPLETION
      cli_zsh_commands
      cat <<'COMPLETION'
  )

  if (( CURRENT == 2 )); then
    _describe 'command' subcmds
    return
  fi

  case "${words[2]}" in
    ls)
      compadd -- -r --repositories ${(f)"$(command wsm ls 2>/dev/null | cut -f1)"}
      ;;
    cd|path)
      compadd -- -s --source
      _wsm_installed
      ;;
    remove)
      _wsm_installed
      ;;
    install)
      if (( CURRENT == 3 )); then
        compadd -- --dry-run ${(f)"$(command wsm ls 2>/dev/null | cut -f1)"}
      else
        _path_files -/
      fi
      ;;
    add)
      _files
      ;;
    status)
      compadd -- ${(f)"$(command wsm ls 2>/dev/null | awk -F'\t' '$2 != "-" && $1 ~ /\/$/ {sub(/\/$/, "", $1); print $1}')"}
      ;;
    implode)
      compadd -- -y
      ;;
    completion)
      (( CURRENT == 3 )) && compadd zsh
      ;;
  esac
}

if [[ "${funcstack[1]}" == "_wsm" ]]; then
  _wsm "$@"
else
  compdef _wsm wsm
fi
COMPLETION
      ;;
    *)
      echo "Usage: wsm completion <zsh>" >&2
      return 1
      ;;
  esac
}

# `wsm implode [-y]`: unstow every installed level and delete wsm's state. What the spaces hold
# besides the links (cloned repos, your files) is never touched.
cmd_implode() {
  local yes=false arg j f
  for arg in "$@"; do
    case "$arg" in
      -y|--yes) yes=true ;;
      *) usage_err "wsm implode [-y]" ;;
    esac
  done

  _installed_load
  {
    echo "wsm implode removes:"
    for j in ${INST_ID[@]+"${!INST_ID[@]}"}; do
      echo "  links        ${INST_ID[$j]} in $(_display "${INST_DIR[$j]}")"
    done
    for j in ${ISRC_NAME[@]+"${!ISRC_NAME[@]}"}; do
      echo "  links        ${ISRC_NAME[$j]}/ in $(_display "${ISRC_TARGET[$j]}/${ISRC_NAME[$j]}") (and its workspaces)"
    done
    echo "  state        $(_display "$WSM_STATE_HOME")"
    echo "Kept: everything else in the spaces (cloned repos, your files)"
  } >&2

  if ! $yes; then
    [[ -t 0 ]] || die "implode unstows every space; pass -y to confirm without a terminal"
    local answer
    read -r -p "Implode wsm? [y/N] " answer
    [[ "$answer" == [yY]* ]] || die "nothing removed"
  fi

  anfs_sources spaces
  # Spaces, then the workspace and source levels above them
  for f in "$WSM_INSTALLED"/*/*/*.yml "$WSM_INSTALLED"/*/*.yml "$WSM_INSTALLED"/*.yml; do
    [[ -f "$f" ]] && _unlink_unit "$f"
  done
  rm -rf -- "${WSM_STATE_HOME:?}"
  echo "wsm imploded" >&2
}

# --- Dispatch -----------------------------------------------------------------------------

if [[ "${1:-}" == --version ]]; then
  printf 'wsm %s\n' "$WSM_VERSION"
else
  cli_dispatch "$@"
fi
