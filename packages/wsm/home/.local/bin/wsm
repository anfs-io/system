#!/usr/bin/env bash
# wsm — work space manager
#
# A space is any directory of a source's spaces/ that holds a space.yml, at any depth. Its id is
# its path, qualified by the source: spaces/space.yml is the space <source>, spaces/tech/web/
# space.yml the space <source>/tech/web. Directories without a space.yml are only directories.
#
#   <source>/spaces/space.yml              the space <source>
#   <source>/spaces/a/b/c/space.yml        the space <source>/a/b/c (a and a/b are directories)
#
# A file belongs to the nearest enclosing space: the closest directory above it with a space.yml.
# A file under no space is not linked, and is warned about once per run.
#
# `wsm install` links each space's files into $WSM_SPACES_HOME/<source>/<path>/ (lib/anfs/link.sh),
# as ppm links a package's home/ into $HOME, then clones the repositories its space.yml declares.
# `wsm new` and `wsm add` go the other way: what you create in that tree is moved into the source
# and linked back, so the source holds everything but the clones.
#
# Nothing is recorded. The sources' spaces/ say what exists; the links say what is installed: a
# space is installed when <root>/<source>/<path>/space.yml is a link to its space.yml. Each file's
# state is its link checked against the source (anfs_link_check), and the links a source no longer
# has a file for (leftovers) are found by walking only the directories of <root>/<source>/ that
# mirror a directory of the source's spaces/, plus one level for a space that vanished. Nothing
# else under the root is ever walked, so a clone of any size costs one directory entry.
#
# Runs on the bash floor (5.2; lib/anfs/bash.sh gets it there from macOS's 3.2).
set -euo pipefail
# A job's copy of this tool runs instead when ANFS_WORK names one (lib/anfs/work.sh)
[ -z "${ANFS_WORK:-}" ] || [ ! -f "$HOME/.local/lib/anfs/work.sh" ] || . "$HOME/.local/lib/anfs/work.sh"

# Bumped by hand at release time. The pre-commit hook bumps package.yml, which the stowed script
# cannot read at runtime, so the two are kept in step manually.
WSM_VERSION=0.11.0

# Paths, sources and the command line come from anfs
if [[ ! -f "$HOME/.local/lib/anfs/paths.sh" ]]; then
  echo "wsm: ~/.local/lib/anfs is missing or out of date; run: ppm install -f core/anfs" >&2
  exit 69
fi
# The bash floor, first: re-execs under bash 5 when this is macOS's 3.2
# shellcheck source=/dev/null
source "$HOME/.local/lib/anfs/bash.sh"
# shellcheck source=/dev/null
source "$HOME/.local/lib/anfs/paths.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB_DIR/log.sh"
# The platform, the linker, the manifests (links:, files:), copies and agent skills. lib/anfs is
# one link into core/anfs, so a library a pull brings is there at once
for _wsm_lib in platform link manifest files skill; do
  # shellcheck source=/dev/null
  source "$ANFS_LIB_DIR/$_wsm_lib.sh"
done
# shellcheck source=/dev/null
source "$ANFS_LIB_DIR/callbacks.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB_DIR/sources.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB_DIR/resolve.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB_DIR/cli.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB_DIR/table.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB_DIR/config.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB_DIR/repo.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB_DIR/move.sh"
anfs_gitsrc_env
anfs_tool_paths wsm

# Exit codes
EX_NOTFOUND=1 EX_AMBIGUOUS=2 EX_USAGE=64 EX_UNAVAIL=69 EX_EXISTS=73

# Events (lib/anfs/callbacks.sh): the spaces this run installed that were not installed before,
# and the ones it removed, as ids (<source> for a source's root space). _wsm_emit tells whoever
# registered with wsm, once, when the command is over; wsm does not know who that is.
WSM_EV_INSTALLED=() WSM_EV_REMOVED=()
_wsm_emit() {
  local -a installed=("${WSM_EV_INSTALLED[@]}") removed=("${WSM_EV_REMOVED[@]}")
  WSM_EV_INSTALLED=() WSM_EV_REMOVED=()
  [[ ${#removed[@]} -eq 0 ]] || anfs_callbacks_run wsm remove "${removed[@]}"
  [[ ${#installed[@]} -eq 0 ]] || anfs_callbacks_run wsm install "${installed[@]}"
}
# A directory for the run's own files (the lists the check reads), made when first needed
WSM_TMP=""
_wsm_tmp() { [[ -n "$WSM_TMP" ]] || WSM_TMP=$(mktemp -d "${TMPDIR:-/tmp}/wsm.XXXXXX"); }
# On EXIT, so a run that installed some spaces and then failed still reports those
trap '_wsm_emit; [[ -z "$WSM_TMP" ]] || rm -rf -- "$WSM_TMP"' EXIT

# Names are paths of any depth (lib/anfs resolve.sh): the first segment is the source when it is
# one, and a resource is a directory holding a space.yml
ANFS_NAME_NEST=true
ANFS_RESOLVE_MARKER=space.yml
# A space is one directory, the highest-priority one: spaces do not layer like packages
ANFS_RESOLVE_FIRST=true

CLI_TOOL=wsm
CLI_EX_USAGE=64
CLI_VERSION="$WSM_VERSION"
cli_cmd list "The spaces the sources define, and the state of each installed one" --alias ls --arg "[spec]"
cli_cmd install "Link spaces into \$WSM_SPACES_HOME/<id> and clone their repositories,
dependencies first. SPEC is an id (source, source/path, or a path) or a
prefix ending in / (source/, source/path/); none is the space at ." \
  --opt "-n --dry-run: Say what would be done" \
  --opt "-f --force: Move what is in the way aside (\$WSM_STATE_HOME/backup) and link" \
  --opt "-y --yes: Do not ask before installing a prefix" --arg "[spec...]"
cli_cmd remove "Unlink installed spaces; clones and your files stay" \
  --alias rm --opt "-y --yes: Do not ask before unlinking" --arg "space..."
cli_cmd new "Create a space in a source: SOURCE/PATH anywhere, or a PATH below
where you are. Installed too when the space around it is" --arg "space"
cli_cmd add "Move files from the spaces tree into the source and link them back" --arg "file..."
cli_cmd cd "Change to an installed space (requires the wsm shell function)" \
  --opt "-s --source: Its directory in the source" --arg "[query]"
cli_cmd path "Print that path; no QUERY means the installed space containing ." \
  --opt "-s --source: Its directory in the source" --arg "[query]"
cli_cmd implode "Unlink every installed space and delete wsm's state" --opt "-y --yes: Do not ask before imploding"
cli_group repo "The repositories the spaces' space.yml files declare"
cli_cmd "repo list" "Each repository under SPEC, and its git state" --alias ls --arg "[spec]"
cli_cmd "repo install" "Clone what the installed spaces under SPEC declare and is missing, or
the one REPOSITORY (as repo list names it); nothing is linked, nothing is pulled" \
  --opt "-n --dry-run: Say what would be done" --arg "[spec|repository]"
cli_cmd "repo ssh" "Switch the clones under SPEC from GitHub https to ssh (their origin);
space.yml is the source's and is not edited" --arg "[spec]"
cli_cmd "repo push" "Push the current branch of each clone to its upstream (plain git
push: never forced, no --set-upstream); one with uncommitted changes
still pushes its commits. Name repositories (as repo list does), or specs
(an id: that space's; a prefix like cnfs/: every space under it), or --all" \
  --opt "--all: Every repository ahead of its upstream" \
  --opt "-n --dry-run: Say what would be pushed: the branch, its upstream, the commits" \
  --arg "[spec-or-repository...]"
cli_group skill "The agent skills the spaces' space.yml files declare, installed into each space"
cli_cmd "skill list" "Each skill an installed space declares, and its state there" --alias ls --arg "[spec]"
cli_cmd "skill install" "Install the skills of the installed spaces under SPEC into their
directories, for every detected agent (wsm install does this too)" \
  --opt "-n --dry-run: Say what would be done" --arg "[spec]"
cli_cmd "skill remove" "Remove a space's declared skills from it (a SPEC), or one of them
(<space id>/<name>); skills it does not declare stay" \
  --alias rm --opt "-y --yes: Do not ask before removing" --arg "spec..."
anfs_move_cli space spec
anfs_config_declare
cli_standard

cmd_cd() {
  echo "wsm cd needs the wsm shell function (source ~/.config/sh/wsm.sh)" >&2
  exit 1
}

cli_help_epilogue() {
  cat <<'EOF'
A space is any directory of a source's spaces/ with a space.yml, at any depth; its id is the
source and its path (spaces/space.yml is the space <source>). A file belongs to the nearest
space above it; a file under no space is not linked.

  depends: [lgat/tech, org]   # installed first: an id, or a path in this source (or a lower one)
  repositories:               # cloned into the space's directory
    - url: git@github.com:you/thing
      path: repos/thing       # optional: git's name for it
      ref: main               # optional
  skills:                     # installed into the space's directory, for this space only
    - repo: owner/repo        # owner/repo, a URL or a path, as the skills CLI takes it
      skills: [a-skill]       # optional: all of them when left out
    - repo: ./skills          # relative: from this space.yml in the source
  links:                      # how the space's files are linked (each on its own by default)
    - docs/                   # a directory as one link
    - {path: notes.md, platforms: [macos]}   # only on those platforms
    - src: ~/.local/share/anfs/sources   # a link out of the tree (relative); ~ and $VAR expanded;
      dest: sources           #   relative: from the space's directory; dest defaults to the basename
  files: [local.conf]         # copied when missing, then yours: never overwritten, left by remove

install links each space into $WSM_SPACES_HOME/<source>/<path>/ (a relative link per file, so
directories stay real), then clones its repositories. A prefix (lgat/, lgat/tech/) is every space
at or under it; installing a space does not install the spaces above it. Re-running install links
what is missing and removes the links whose file left the source; it never pulls. Anything in the
way fails the space; -f moves it aside, and remove never puts it back.

install copies the files: that are missing, then makes the links: out of the tree (a src that is
not there is said, not made) and installs the skills,
for the agents ppm installed (meta.agent; installing one installs them). remove takes the skills
and the links that still point at their src first.

A repository is cloned when it is missing and never pulled or deleted: what is checked out is
yours. repo ssh switches a clone's origin from GitHub https to ssh; repo push pushes the ones you
name, those under a spec (repo push cnfs/) that are ahead, or every one ahead of its upstream (--all).

Nothing is recorded: list reads the state off the links (ok, partial with what is missing, wrong,
in the way or left over, or not in the source).

move takes a space and every space under it to another source, with its history (commits in
both, nothing pushed); when it is installed its directory moves too, clones and your files
inside untouched, and its links are made again. Ids are not rewritten: what names the old id (a
depends:, a stack, an ovm vault link) is listed by the check, and is yours to edit.

QUERY (cd, path) is an installed id, or the end of one (web, tech/web); failing those, a source
names its directory. An ambiguous query exits 2.
EOF
  printf '\nSpaces home: %s\n' "$(_display "$(_spaces_home)")"
}

# --- Output helpers -----------------------------------------------------------------------

# Messages and the log are anfs's (lib/anfs/log.sh)
warn() { anfs_warn "$@"; }
die()  { anfs_die "$@"; }
fail() { anfs_fail "$@"; }
usage_err() { cli_usage "$@"; }

# Shorten a leading $HOME for display only
_display() { anfs_display "$1"; }

# Absolute, symlinks resolved, no trailing slash
_canon() { anfs_canon "$1"; }

# A path as given, made absolute without touching the filesystem
_abs() {
  case "$1" in
    /*) printf '%s\n' "${1%/}" ;;
    .)  printf '%s\n' "$PWD" ;;
    *)  printf '%s\n' "$PWD/${1%/}" ;;
  esac
}

# The canonical form of a path that may not exist yet: its deepest existing directory resolved,
# the rest appended
_canon_maybe() {
  local p="$1" rest="" c
  while [[ ! -d "$p" && "$p" == */* ]]; do
    rest="/${p##*/}$rest" p="${p%/*}"
    [[ -n "$p" ]] || p=/
  done
  c=$(_canon "$p") || c="$p"
  printf '%s\n' "${c%/}$rest"
}

# The canonical path of an existing file or directory: its directory resolved, the name kept
_canon_file() {
  local d
  [[ -d "$1" && ! -L "$1" ]] && { _canon "$1"; return; }
  d=$(_canon "$(dirname -- "$1")") || return 1
  printf '%s/%s\n' "${d%/}" "$(basename -- "$1")"
}

# $WSM_SPACES_HOME, read from wsm.env (or wsm.local.env) unexpanded, so ~ and $HOME are ours
_spaces_home() {
  local d="${WSM_SPACES_HOME:-$HOME/spaces}"
  case "$d" in
    "~"|"~/"*)          d="$HOME${d#\~}" ;;
    '$HOME'|'$HOME/'*)  d="$HOME${d#\$HOME}" ;;
  esac
  printf '%s\n' "$d"
}

_require_yq() { anfs_require yq "https://github.com/mikefarah/yq"; }

_in_list() {
  local want="$1" x
  shift
  for x in "$@"; do [[ "$x" == "$want" ]] && return 0; done
  return 1
}

# A spec: path segments, none empty, . or .., no glob characters or whitespace, nothing that reads
# as a path (a leading / or ~); a trailing / makes it a prefix
_valid_spec() {
  local rest="${1%/}" p
  [[ -n "$rest" && "$1" != *// ]] || return 1
  while :; do
    p="${rest%%/*}"
    case "$p" in
      ""|.|..|"~"*|*[*?[]*|*[[:space:]]*) return 1 ;;
    esac
    [[ "$rest" == */* ]] || return 0
    rest="${rest#*/}"
  done
}

# Refuse a spec that is not one (64), saying so when it reads as a directory: install has no DIR
_spec_ok() {
  _valid_spec "$1" && return 0
  case "$1" in
    .|..|/*|./*|../*|"~"*) warn "'$1' is a directory, not a space: the spaces go in \$WSM_SPACES_HOME ($(_display "$(_spaces_home)"))" ;;
  esac
  cli_usage_err "'$1' is not a space or a prefix"
}

_rmdir_empty_up() {
  local dir="$1" stop="$2"
  while [[ "$dir" == "$stop"/* ]]; do
    rmdir -- "$dir" 2>/dev/null || return 0
    dir="${dir%/*}"
  done
}

# --- Sources ------------------------------------------------------------------------------

_is_registered() {
  [[ -n "${GITSRC_NAMES[*]+x}" ]] || gitsrc_collect
  _in_list "$1" ${GITSRC_NAMES[@]+"${GITSRC_NAMES[@]}"}
}

# The source whose checkout holds canonical <path>, or return 1
_source_holding() {
  local n d
  [[ -n "${GITSRC_NAMES[*]+x}" ]] || gitsrc_collect
  for n in ${GITSRC_NAMES[@]+"${GITSRC_NAMES[@]}"}; do
    d=$(_canon "$(gitsrc_dir "$n")") || continue
    [[ "$1" == "$d" || "$1" == "$d"/* ]] && { printf '%s\n' "$n"; return 0; }
  done
  return 1
}

# The root every source is installed in: $WSM_SPACES_HOME, canonical (it may not exist yet)
ROOT=""
_root_load() {
  [[ -z "$ROOT" ]] || return 0
  local d="${WSM_SPACES_HOME:-$HOME/spaces}"
  case "$d" in
    "~"|"~/"*)          d="$HOME${d#\~}" ;;
    '$HOME'|'$HOME/'*)  d="$HOME${d#\$HOME}" ;;
  esac
  [[ "$d" == /* ]] || d="$PWD/$d"
  _anfs_link_canon "$d"
  ROOT="$_ANFS_P"
}

# --- The spaces, from the sources ---------------------------------------------------------
#
# Once per run: one find per source's spaces/. From it, in bash:
#   SPACE_IDS             every space, the sources' priority order, then by path
#   SPACE_SRC[id]         its source; SPACE_PATH[id] its path below spaces/ (empty: the root space)
#   SPACE_DIR[id]         its directory in the source
#   SPACE_FILES[id]       its own files, relative to it, one per line (not a child space's)
#   SRC_SD[src]           <source dir>/spaces
#   SRC_DIRS[src]         the source's directories below spaces/, one per line (the first, empty,
#                         is spaces/ itself); SRC_DIRSET["src|dir"] the same as a set
#   SRC_OWNER["src|rel"]  the space a file below spaces/ belongs to

SPACE_IDS=()
declare -A SPACE_SRC=() SPACE_PATH=() SPACE_DIR=() SPACE_FILES=() SRC_SD=() SRC_DIRS=() SRC_DIRSET=() SRC_OWNER=()
SPACES_LOADED=false UNOWNED_WARNED=false

_spaces_load() {
  $SPACES_LOADED && return 0
  SPACES_LOADED=true
  anfs_sources spaces
  local i src sd rel d p id f found nown=0 first="" dir
  local -a files=() starts=() rels=() paths=()
  local -A here=() src_of=() src_idx=()
  for i in ${ANFS_SRC_NAMES[@]+"${!ANFS_SRC_NAMES[@]}"}; do
    src="${ANFS_SRC_NAMES[$i]}" sd="${ANFS_SRC_DIRS[$i]}/spaces"
    SRC_SD[$src]="$sd" SRC_DIRSET["$src|"]=1 SRC_DIRS[$src]=$'\n'
    src_of[$sd]="$src" src_idx[$src]="$i"
    # The trailing / follows a local-path source's link; BSD find then prints <sd>//<rel>
    starts+=("$sd/")
  done
  [[ ${#starts[@]} -gt 0 ]] || return 0
  # One find for every source, one sort: <source>/<rel> per file (a path may not hold a newline)
  # Sorted, a source's files are together: its directory is looked up once
  local cur="" cursrc=""
  local -a found_files=()
  # mapfile, not a read loop: read takes a pipe a byte at a time
  mapfile -t found_files < <(find "${starts[@]}" \( -type f -o -type l \) ! -name .DS_Store -print 2>/dev/null | LC_ALL=C sort)
  for f in ${found_files[@]+"${found_files[@]}"}; do
    if [[ -z "$cur" || "$f" != "$cur"/* ]]; then
      cur=""
      for dir in "${!src_of[@]}"; do
        [[ "$f" == "$dir"/* ]] && { cur="$dir" cursrc="${src_of[$dir]}"; break; }
      done
      [[ -n "$cur" ]] || continue
    fi
    rel="${f#"$cur"/}" rel="${rel#/}"
    [[ -n "$rel" ]] && files+=("$cursrc/$rel")
  done

  # The spaces: every directory holding a space.yml, in the sources' order, then by path
  for f in ${files[@]+"${files[@]}"}; do
    [[ "${f##*/}" == space.yml ]] || continue
    src="${f%%/*}" rel="${f#*/}" p=""
    [[ "$rel" != */* ]] || p="${rel%/*}"
    here["$src|$p"]=1
    paths+=("${src_idx[$src]}"$'\t'"$src"$'\t'"$p")
  done
  if [[ ${#paths[@]} -gt 0 ]]; then
    while IFS=$'\t' read -r i src p; do
      id="$src${p:+/$p}"
      SPACE_IDS+=("$id")
      SPACE_SRC[$id]="$src" SPACE_PATH[$id]="$p" SPACE_DIR[$id]="${SRC_SD[$src]}${p:+/$p}" SPACE_FILES[$id]=""
    done < <(printf '%s\n' "${paths[@]}" | LC_ALL=C sort -t$'\t' -k1,1n -k3,3)
  fi

  SPACES_ALL=(${files[@]+"${files[@]}"})
}

# Every file's space, the nearest enclosing one (SPACE_FILES, SRC_OWNER), and the source's
# directories (SRC_DIRS, the walk's): what list, install and remove need, and path does not
SPACES_ALL=() FILES_LOADED=false
_files_load() {
  $FILES_LOADED && return 0
  FILES_LOADED=true
  local src rel d p id f found nown=0 first="" lastd=$'\n' lastp=""
  local -A here=()
  for id in ${SPACE_IDS[@]+"${SPACE_IDS[@]}"}; do here["${SPACE_SRC[$id]}|${SPACE_PATH[$id]}"]=1; done
  # Sorted, a directory's files are together: its space is looked up once
  for f in ${SPACES_ALL[@]+"${SPACES_ALL[@]}"}; do
    src="${f%%/*}" rel="${f#*/}" d=""
    [[ "$rel" != */* ]] || d="${rel%/*}"
    if [[ "$src|$d" != "$lastd" ]]; then
      lastd="$src|$d"
      p="$d"
      while [[ -z "${SRC_DIRSET["$src|$p"]:-}" ]]; do
        SRC_DIRSET["$src|$p"]=1 SRC_DIRS[$src]+="$p"$'\n'
        if [[ "$p" == */* ]]; then p="${p%/*}"; else p=""; fi
      done
      p="$d" found=false
      while :; do
        if [[ -n "${here["$src|$p"]:-}" ]]; then found=true; break; fi
        [[ -n "$p" ]] || break
        if [[ "$p" == */* ]]; then p="${p%/*}"; else p=""; fi
      done
      lastp="$p"
    else
      p="$lastp"
    fi
    if $found; then
      id="$src${p:+/$p}"
      if [[ -n "$p" ]]; then rel="${rel#"$p"/}"; fi
      SPACE_FILES[$id]+="$rel"$'\n'
      SRC_OWNER["$src|${f#*/}"]="$id"
    else
      nown=$((nown + 1))
      [[ -n "$first" ]] || first="$f"
    fi
  done
  if [[ $nown -gt 0 ]] && ! $UNOWNED_WARNED; then
    UNOWNED_WARNED=true
    warn "not in any space, not linked: $first$([[ $nown -eq 1 ]] || echo " (and $((nown - 1)) more)")"
  fi
}

# Forget what was loaded (wsm new, after it creates a space)
_spaces_reset() {
  SPACES_LOADED=false FILES_LOADED=false SPACE_IDS=() SPACES_ALL=()
  SPACE_SRC=() SPACE_PATH=() SPACE_DIR=() SPACE_FILES=() SRC_SD=() SRC_DIRS=() SRC_DIRSET=() SRC_OWNER=()
  INSTALLED=() FSTATE=() FABS=() STATE_DONE=() SRC_LEFT=() VANISHED_IDS=() VANISHED_SRC=() VANISHED_PATH=()
}

# The nearest space enclosing directory <dir> (below <src>'s spaces/), itself included, into
# REPLY; 1 when there is none. With <installed>, only an installed one (or <extra>).
_space_of() {
  local src="$1" p="$2" installed="${3:-false}" extra="${4:-}" id
  while :; do
    id="$src${p:+/$p}"
    if [[ -n "${SPACE_DIR[$id]:-}" ]] &&
       { ! $installed || [[ -n "${INSTALLED[$id]:-}" || "$id" == "$extra" ]]; }; then
      REPLY="$id"
      return 0
    fi
    [[ -n "$p" ]] || break
    if [[ "$p" == */* ]]; then p="${p%/*}"; else p=""; fi
  done
  REPLY=""
  return 1
}

# --- Specs --------------------------------------------------------------------------------
#
# A spec is an id or a prefix ending in /. Its first segment is the source when that is the alias
# of a source with spaces/; otherwise it is a path, in the highest-priority source that has a
# space at it (a prefix: at or under it). _spec_parse sets SP_SRC (empty: no source has it),
# SP_PATH and SP_PREFIX; _spec_match <id> says whether a space is one the spec names.

SP_SRC="" SP_PATH="" SP_PREFIX=false
_spec_parse() {
  local spec="$1" first id p
  SP_PREFIX=false
  [[ "$spec" != */ ]] || { SP_PREFIX=true; spec="${spec%/}"; }
  first="${spec%%/*}"
  if anfs_is_source "$first"; then
    SP_SRC="$first" SP_PATH=""
    [[ "$spec" != */* ]] || SP_PATH="${spec#*/}"
    return 0
  fi
  SP_SRC="" SP_PATH="$spec"
  for id in ${SPACE_IDS[@]+"${SPACE_IDS[@]}"}; do
    p="${SPACE_PATH[$id]}"
    if [[ "$p" == "$SP_PATH" ]] || { $SP_PREFIX && [[ "$p" == "$SP_PATH"/* ]]; }; then
      SP_SRC="${SPACE_SRC[$id]}"
      return 0
    fi
  done
}

# Whether <src> <path> is what the parsed spec names
_spec_match_path() {
  [[ -n "$SP_SRC" && "$1" == "$SP_SRC" ]] || return 1
  [[ "$2" == "$SP_PATH" ]] && return 0
  $SP_PREFIX && [[ -z "$SP_PATH" || "$2" == "$SP_PATH"/* ]]
}
_spec_match() { _spec_match_path "${SPACE_SRC[$1]}" "${SPACE_PATH[$1]}"; }

# The ids the specs name, into EXPANDED (each once, the sources' order then the path order).
# A spec that names no space fails (1) before anything is touched.
EXPANDED=()
_specs_expand() {
  local spec id any
  local -A seen=()
  EXPANDED=()
  for spec in "$@"; do
    _spec_parse "$spec"
    any=false
    for id in ${SPACE_IDS[@]+"${SPACE_IDS[@]}"}; do
      _spec_match "$id" || continue
      any=true
      [[ -z "${seen[$id]:-}" ]] || continue
      seen[$id]=1
      EXPANDED+=("$id")
    done
    $any && continue
    if [[ "$spec" != */* ]] && anfs_is_source "$spec"; then
      fail "$EX_NOTFOUND" "$spec has no space.yml at spaces/, so no space $spec: $spec/ is every space in it"
    fi
    fail "$EX_NOTFOUND" "no space matches '$spec' (wsm ls)"
  done
}

# --- The state, from the links ------------------------------------------------------------
#
# Nothing is stored. _state_load reads, per source, the links under <root>/<source>/:
#   INSTALLED[id]          set when the space's space.yml is a link to it (anfs_link_check ok)
#   FSTATE["src|rel"]      every file's state (full only): ok, missing, wrong, in the way
#   SRC_LEFT[src]          the leftover links (full only): dangling links into the source's
#                          spaces/ that no file of the source owns, one per line, below spaces/
#   VANISHED_IDS           a leftover space.yml where the source has no space: "not in the source"
# Light (false) checks only the space.yml links, for path, cd, new, add and repo; full (true) every
# file and the leftovers, for list, install and remove.

declare -A INSTALLED=() FSTATE=() FABS=() STATE_DONE=() SRC_LEFT=() VANISHED_SRC=() VANISHED_PATH=()
VANISHED_IDS=()

# Usage: _state_load <full:true|false> [source...]   (after _spaces_load and _root_load)
# One anfs_link_check for every source at once (one readlink for all their links); a source the
# check refuses (a name with a tab) is warned about and reads as not installed.
_state_load() {
  local full="$1" src id p r state f rc=0 list k=0 i
  shift
  [[ "$full" != true ]] || _files_load
  local -a srcs=("$@") args=() done_srcs=() counts=() names=() files=()
  [[ ${#srcs[@]} -gt 0 ]] || srcs=(${ANFS_SRC_NAMES[@]+"${ANFS_SRC_NAMES[@]}"})
  if [[ "$full" == true ]]; then
    # what each space links is its manifest's: every space of these sources read in one yq
    local -a sids=()
    for id in ${SPACE_IDS[@]+"${SPACE_IDS[@]}"}; do
      _in_list "${SPACE_SRC[$id]}" "${srcs[@]}" && sids+=("$id")
    done
    _meta_load ${sids[@]+"${sids[@]}"}
  fi
  for src in ${srcs[@]+"${srcs[@]}"}; do
    [[ -n "${SRC_SD[$src]:-}" ]] || continue
    [[ "${STATE_DONE[$src]:-}" != full ]] || continue
    ! [[ "$full" == false && -n "${STATE_DONE[$src]:-}" ]] || continue
    if [[ "$full" == true ]]; then STATE_DONE[$src]=full; else STATE_DONE[$src]=light; fi
    r="$ROOT/$src"
    [[ -d "$r" ]] || continue
    list="" i=0
    for id in "${SPACE_IDS[@]}"; do
      [[ "${SPACE_SRC[$id]}" == "$src" ]] || continue
      p="${SPACE_PATH[$id]}"
      if [[ "$full" == true ]]; then
        _files_of "$id"
        for f in ${FILES[@]+"${FILES[@]}"}; do
          list+="${p:+$p/}$f"$'\n' i=$((i + 1))
          names+=("$src|${p:+$p/}$f")
        done
      else
        list+="${p:+$p/}space.yml"$'\n' i=$((i + 1))
        names+=("$src|${p:+$p/}space.yml")
      fi
    done
    _wsm_tmp
    printf '%s' "$list" > "$WSM_TMP/check.$k"
    args+=("${SRC_SD[$src]}" "$r" "$WSM_TMP/check.$k")
    done_srcs+=("$src") counts+=("$i")
    k=$((k + 1))
  done
  [[ ${#args[@]} -gt 0 ]] || return 0
  # The states come in the order of the lists (_ANFS_ST), triplet by triplet
  if anfs_link_check "${args[@]}" >/dev/null 2>&1; then
    for i in "${!names[@]}"; do FSTATE["${names[$i]}"]="${_ANFS_ST[$i]}"; done
    for i in ${_ANFS_ABS[@]+"${!_ANFS_ABS[@]}"}; do FABS["${names[$i]}"]=1; done
  else
    # One at a time, to keep what can be read
    k=0
    for i in "${!done_srcs[@]}"; do
      if anfs_link_check "${args[@]:$((i * 3)):3}" >/dev/null; then
        for f in "${!_ANFS_ST[@]}"; do FSTATE["${names[$((k + f))]}"]="${_ANFS_ST[$f]}"; done
        for f in ${_ANFS_ABS[@]+"${!_ANFS_ABS[@]}"}; do FABS["${names[$((k + f))]}"]=1; done
      else
        warn "cannot read what is installed of ${done_srcs[$i]}"
      fi
      k=$((k + counts[i]))
    done
  fi
  for src in ${done_srcs[@]+"${done_srcs[@]}"}; do
    for id in "${SPACE_IDS[@]}"; do
      [[ "${SPACE_SRC[$id]}" == "$src" ]] || continue
      p="${SPACE_PATH[$id]}"
      [[ "${FSTATE["$src|${p:+$p/}space.yml"]:-}" != ok ]] || INSTALLED[$id]=1
    done
    [[ "$full" != true ]] || _leftovers_scan "$src"
  done
}


# The leftovers of <src> (SRC_LEFT, VANISHED_*): for every directory of the source's spaces/ whose
# mirror under <root>/<src> is a real directory, its entries (bash globs, no find): a dangling link
# there that is no file's of the source, and for an entry that is a real directory and no mirror,
# only <entry>/space.yml. The links' texts are read with one readlink.
_leftovers_scan() {
  local src="$1" r="$ROOT/$1" sd csd d m e rel t i n=0 id vp
  local -a cand=() crel=() texts=()
  sd="${SRC_SD[$src]}"
  _anfs_link_canon "$sd"; csd="$_ANFS_P"
  SRC_LEFT[$src]=""
  while IFS= read -r d; do
    m="$r${d:+/$d}"
    [[ -d "$m" && ! -L "$m" ]] || continue
    for e in "$m"/* "$m"/.[!.]* "$m"/..?*; do
      rel="${d:+$d/}${e##*/}"
      if [[ -L "$e" ]]; then
        [[ -z "${SRC_OWNER["$src|$rel"]:-}" && ! -e "$e" ]] || continue
        cand+=("$e") crel+=("$rel")
      elif [[ -d "$e" && -z "${SRC_DIRSET["$src|$rel"]:-}" ]]; then
        [[ -L "$e/space.yml" && ! -e "$e/space.yml" ]] || continue
        cand+=("$e/space.yml") crel+=("$rel/space.yml")
      fi
    done
  done <<< "${SRC_DIRS[$src]}"
  [[ ${#cand[@]} -gt 0 ]] || return 0

  while IFS= read -r t; do texts[$n]="$t"; n=$((n + 1)); done < <(printf '%s\0' "${cand[@]}" | xargs -0 readlink -- 2>/dev/null)
  [[ $n -eq ${#cand[@]} ]] || { texts=(); for i in "${!cand[@]}"; do texts[$i]=$(readlink -- "${cand[$i]}" 2>/dev/null) || texts[$i]=""; done; }
  for i in "${!cand[@]}"; do
    t="${texts[$i]}"
    [[ -n "$t" ]] || continue
    [[ "$t" == /* ]] || t="${cand[$i]%/*}/$t"
    # Dangling: its deepest existing directory resolved, the rest as written
    _anfs_link_canon "$t"
    [[ "$_ANFS_P" == "$csd"/* ]] || continue
    rel="${crel[$i]}"
    if [[ "${rel##*/}" == space.yml ]]; then
      vp=""
      [[ "$rel" != */* ]] || vp="${rel%/*}"
      id="$src${vp:+/$vp}"
      if [[ -z "${SPACE_DIR[$id]:-}" ]]; then
        _in_list "$id" ${VANISHED_IDS[@]+"${VANISHED_IDS[@]}"} || VANISHED_IDS+=("$id")
        VANISHED_SRC[$id]="$src" VANISHED_PATH[$id]="$vp"
        continue
      fi
    fi
    SRC_LEFT[$src]+="$rel"$'\n'
  done
}

# The leftovers that count against <id>: those whose nearest installed space (or <id>, as it is
# being installed) it is, below the source's spaces/, into LEFT
LEFT=()
_leftovers_of() {
  local id="$1" src="${SPACE_SRC[$1]}" rel d
  LEFT=()
  while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    d=""
    [[ "$rel" != */* ]] || d="${rel%/*}"
    _space_of "$src" "$d" true "$id" && [[ "$REPLY" == "$id" ]] && LEFT+=("$rel")
  done <<< "${SRC_LEFT[$src]:-}"
  return 0
}

# The directory of space <id> under the root: _home_of into REPLY, _space_home printed
_home_of() {
  local src="${SPACE_SRC[$1]:-${VANISHED_SRC[$1]:-}}" p="${SPACE_PATH[$1]:-${VANISHED_PATH[$1]:-}}"
  REPLY="$ROOT/$src${p:+/$p}"
}
_space_home() { _home_of "$1"; printf '%s\n' "$REPLY"; }

# What space <id> links, into FILES: its own files, as its manifest says (a directory link is one
# entry, another platform's paths are left out; _mf_plan). mapfile: a read loop takes a pipe a byte
# at a time.
FILES=()
_files_of() {
  FILES=()
  _mf_plan "$1"
  [[ -z "${MF_LINKS[$1]}" ]] || mapfile -t FILES <<< "${MF_LINKS[$1]%$'\n'}"
}

# A JSON string for <text> into REPLY, as table.sh's _anfs_json_str prints it
_json() {
  local t="$1"
  t="${t//\\/\\\\}" t="${t//\"/\\\"}" t="${t//$'\t'/\\t}" t="${t//$'\r'/\\r}" t="${t//$'\n'/\\n}"
  REPLY="\"$t\""
}

# One row of a list into ROWS, as anfs_row makes it, in this shell
ROWS=""
_row() { local IFS="$ANFS_US"; ROWS+="$*"$'\n'; }

# The counts of an installed space: C_MISSING C_WRONG C_WAY C_LEFT; and the NOTE in REPLY
C_MISSING=0 C_WRONG=0 C_WAY=0 C_LEFT=0
_space_counts() {
  local id="$1" src="${SPACE_SRC[$1]}" p="${SPACE_PATH[$1]}" f note=""
  C_MISSING=0 C_WRONG=0 C_WAY=0 C_LEFT=0
  _files_of "$id"
  for f in ${FILES[@]+"${FILES[@]}"}; do
    case "${FSTATE["$src|${p:+$p/}$f"]:-missing}" in
      missing) C_MISSING=$((C_MISSING + 1)) ;;
      wrong) C_WRONG=$((C_WRONG + 1)) ;;
      "in the way") C_WAY=$((C_WAY + 1)) ;;
    esac
  done
  # links: count like files; a missing src does not (it is not wsm's to make)
  local i line
  _links_eval "$id"
  for i in ${LK_STATE[@]+"${!LK_STATE[@]}"}; do
    case "${LK_STATE[$i]}" in
      missing) C_MISSING=$((C_MISSING + 1)) ;;
      wrong) C_WRONG=$((C_WRONG + 1)) ;;
      "in the way") C_WAY=$((C_WAY + 1)) ;;
    esac
  done
  # files: a copy that is missing or in the way counts; one that differs is the user's
  _copies_plan "$id"
  while IFS= read -r line; do
    case "$line" in
      missing$'\t'*) C_MISSING=$((C_MISSING + 1)) ;;
      "in the way"$'\t'*) C_WAY=$((C_WAY + 1)) ;;
    esac
  done <<< "$CP_LINES"
  _leftovers_of "$id"
  C_LEFT=${#LEFT[@]}
  [[ $C_MISSING -eq 0 ]] || note+="${note:+, }$C_MISSING missing"
  [[ $C_WRONG -eq 0 ]] || note+="${note:+, }$C_WRONG wrong"
  [[ $C_WAY -eq 0 ]] || note+="${note:+, }$C_WAY in the way"
  [[ $C_LEFT -eq 0 ]] || note+="${note:+, }$C_LEFT leftover$([[ $C_LEFT -eq 1 ]] || echo s)"
  REPLY="$note"
}

# --- Linking ------------------------------------------------------------------------------

# Move what is in the way at <root>/<src>/<rel> aside, as ppm does: to
# $WSM_STATE_HOME/backup/<src>/<rel>, or .1, .2 when that is taken. Nothing restores it.
_backup() {
  local src="$1" rel="$2" dest n=1
  dest="$WSM_STATE_HOME/backup/$src/$rel"
  while [[ -e "$dest" || -L "$dest" ]]; do
    dest="$WSM_STATE_HOME/backup/$src/$rel.$n"
    n=$((n + 1))
  done
  mkdir -p -- "${dest%/*}"
  mv -- "$ROOT/$src/$rel" "$dest"
  echo "  moved aside $(_display "$ROOT/$src/$rel") -> $(_display "$dest")"
}

# Whether a plan's detail is an obstacle on the way (or another package's links): never moved
_wsm_blocked() {
  case "$1" in
    *" on the way: "*|"a file where a directory goes: "*|"inside a directory link: "*|*"with links into another package: "*) return 0 ;;
  esac
  return 1
}

# Link one space's files into <root>/<source>/<path> (lib/anfs/link.sh), as its manifest says (a
# directory link is one link), and copy its files: when missing (lib/anfs/files.sh): a relative link
# per file, so every directory is real and what install clones lands in the root, never in the
# source. All or nothing: anything in the way of a link or a copy fails the space before anything
# is linked or copied, unless -f moves it aside. Then its leftovers go. An invalid manifest fails
# the space, every error said.
# Usage: _install_space <id> <dry> <force>
_install_space() {
  local id="$1" dry="$2" force="$3" src="${SPACE_SRC[$1]}" p="${SPACE_PATH[$1]}" sd r dir
  local plan class rest f why rc=0 made=0 total=0 conflicts=0 list copies=0 e
  local -a aside=() left=() cpaside=()
  sd="${SRC_SD[$src]}" r="$ROOT/$src" dir=$(_space_home "$id")
  _mf_plan "$id"
  if [[ -n "${MF_ERR[$id]}" ]]; then
    warn "invalid space.yml, $id not installed:"
    while IFS= read -r e; do [[ -z "$e" ]] || warn "  - $e"; done <<< "${MF_ERR[$id]}"
    return 1
  fi
  _files_of "$id"
  list=""
  for f in "${FILES[@]}"; do list+="${p:+$p/}$f"$'\n'; done
  echo "space $id -> $(_display "$dir")"

  # The copies first: one in the way stops the links too
  _copies_plan "$id"
  local cpbad=0
  while IFS= read -r class; do
    rest="${class#*$'\t'}" class="${class%%$'\t'*}"
    [[ -n "$class" ]] || continue
    f="${rest%%$'\t'*}" why=""
    [[ "$rest" != *$'\t'* ]] || why="${rest#*$'\t'}"
    case "$class" in
      missing) copies=$((copies + 1)) ;;
      "in the way")
        if $force && ! _wsm_blocked "$why"; then
          cpaside+=("$f") copies=$((copies + 1))
        else
          warn "in the way: $(_display "$dir/$f")${why:+ ($why)}"
          cpbad=$((cpbad + 1))
        fi
        ;;
    esac
  done <<< "$CP_LINES"

  # Every link is as apply writes it (the check said so, relative): nothing to plan
  local fresh=true
  for f in "${FILES[@]}"; do
    [[ "${FSTATE["$src|${p:+$p/}$f"]:-}" == ok && -z "${FABS["$src|${p:+$p/}$f"]:-}" ]] || { fresh=false; break; }
  done
  if $fresh && ! $force && [[ $cpbad -eq 0 ]]; then
    _leftovers_of "$id"
    left=(${LEFT[@]+"${LEFT[@]}"})
    if ! $dry; then
      for f in ${left[@]+"${left[@]}"}; do
        rm -f -- "$r/$f"
        [[ "$f" != */* ]] || _rmdir_empty_up "$r/${f%/*}" "$r"
      done
      _copies_apply "$id" || return 1
    fi
    printf '  %s 0 of %d file(s)' "$($dry && echo "would link" || echo linked)" "${#FILES[@]}"
    [[ $copies -eq 0 ]] || printf ', %s %d' "$($dry && echo "would copy" || echo copied)" "$copies"
    [[ ${#left[@]} -eq 0 ]] || printf ', %s %d leftover(s)' "$($dry && echo "would unlink" || echo unlinked)" "${#left[@]}"
    printf '\n'
    return 0
  fi

  # Not a dry run and no copy in the way: apply at once, which links only when nothing is in the
  # way, and prints the plan it carried out (one classification); else the plan alone
  _wsm_tmp
  printf '%s' "$list" > "$WSM_TMP/install.list"
  local applied=false
  if $dry || [[ $cpbad -gt 0 ]]; then
    plan=$(anfs_link_plan "$sd" "$r" "$WSM_TMP/install.list") || rc=$?
  else
    plan=$(anfs_link_apply "$sd" "$r" "$WSM_TMP/install.list") || rc=$?
    [[ $rc -ne 0 ]] || applied=true
  fi
  [[ $rc -ne 2 ]] || return 1
  local -a plines=()
  mapfile -t plines <<< "$plan"
  for class in "${plines[@]}"; do
    rest="${class#*$'\t'}" class="${class%%$'\t'*}"
    [[ -n "$class" ]] || continue
    f="${rest%%$'\t'*}" why=""
    [[ "$rest" != *$'\t'* ]] || why="${rest#*$'\t'}"
    total=$((total + 1))
    case "$class" in
      link|replace) made=$((made + 1)) ;;
      other|conflict)
        # What is on the way to it is not the file's to move: -f never clears that
        if $force && ! _wsm_blocked "$why"; then
          aside+=("$f")
          made=$((made + 1))
        else
          warn "in the way: $(_display "$r/$f")${why:+ ($why)}"
          conflicts=$((conflicts + 1))
        fi
        ;;
    esac
  done
  conflicts=$((conflicts + cpbad))
  if [[ $conflicts -gt 0 ]]; then
    $force || warn "wsm install -f $id moves them aside"
    return 1
  fi
  _leftovers_of "$id"
  left=(${LEFT[@]+"${LEFT[@]}"})

  if ! $dry; then
    for f in ${aside[@]+"${aside[@]}"}; do _backup "$src" "$f"; done
    if ! $applied && [[ $made -gt 0 ]] && ! anfs_link_apply "$sd" "$r" "$WSM_TMP/install.list" >/dev/null; then
      warn "linking failed for $(_display "$dir")"
      return 1
    fi
    for f in ${left[@]+"${left[@]}"}; do
      rm -f -- "$r/$f"
      [[ "$f" != */* ]] || _rmdir_empty_up "$r/${f%/*}" "$r"
    done
    for f in ${cpaside[@]+"${cpaside[@]}"}; do _backup "$src" "${p:+$p/}$f"; done
    _copies_apply "$id" || return 1
  else
    for f in ${aside[@]+"${aside[@]}"}; do echo "  would move aside $(_display "$r/$f")"; done
    for f in ${cpaside[@]+"${cpaside[@]}"}; do echo "  would move aside $(_display "$dir/$f")"; done
  fi

  printf '  %s %d of %d file(s)' "$($dry && echo "would link" || echo linked)" "$made" "$total"
  [[ $copies -eq 0 ]] || printf ', %s %d' "$($dry && echo "would copy" || echo copied)" "$copies"
  [[ ${#left[@]} -eq 0 ]] || printf ', %s %d leftover(s)' "$($dry && echo "would unlink" || echo unlinked)" "${#left[@]}"
  printf '\n'
}

# Copy space <id>'s files: that are missing (lib/anfs/files.sh); what is there is left as it is
_copies_apply() {
  local id="$1"
  [[ -n "${MF_COPIES[$id]:-}" ]] || return 0
  _home_of "$id"
  mkdir -p -- "$REPLY"
  anfs_files_apply "${SPACE_DIR[$id]}" "$REPLY" <(printf '%s' "${MF_COPIES[$id]}") >/dev/null ||
    { warn "copying failed for $(_display "$REPLY")"; return 1; }
}

# Unlink an installed space: its files that still point at their source file, its leftovers, then
# its space.yml last (an interrupted remove leaves it partial, not invisible), then the directories
# that leaves empty, up to <root>/<source>. Clones, the user's files and a child space's links keep
# a directory alive.
_remove_space() {
  local id="$1" src="${SPACE_SRC[$1]}" p="${SPACE_PATH[$1]}" r dir f
  local -a dirs=()
  r="$ROOT/$src" dir=$(_space_home "$id")
  # What the space put there besides its files: its skills (the CLI), then its links:
  _remove_skills "$id" || true
  _remove_links "$id"
  _files_of "$id"
  for f in ${FILES[@]+"${FILES[@]}"}; do
    [[ "$f" != space.yml ]] || continue
    [[ "${FSTATE["$src|${p:+$p/}$f"]:-}" == ok ]] || continue
    rm -f -- "$dir/$f"
    [[ "$f" != */* ]] || dirs+=("$dir/${f%/*}")
  done
  _leftovers_of "$id"
  for f in ${LEFT[@]+"${LEFT[@]}"}; do
    rm -f -- "$r/$f"
    if [[ "$f" == */* ]]; then dirs+=("$r/${f%/*}"); else dirs+=("$r"); fi
  done
  rm -f -- "$dir/space.yml"
  unset "INSTALLED[$id]"
  for f in ${dirs[@]+"${dirs[@]}"}; do _rmdir_empty_up "$f" "$ROOT"; done
  _rmdir_empty_up "$dir" "$ROOT"
}

# Whether link <path> points into canonical <dir> (live or dangling)
_points_into() {
  local t
  t=$(readlink -- "$1") || return 1
  [[ "$t" == /* ]] || t="${1%/*}/$t"
  _anfs_link_canon "$t"
  [[ "$_ANFS_P" == "$2"/* ]]
}

# The links a space that left the source still has under <dir>, dangling into the source's
# spaces/: every directory walked (it was named), but not a clone, nor a live space's directory
_remove_vanished_walk() {
  local dir="$1" src="$2" csd="$3" e rel
  for e in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
    if [[ -L "$e" ]]; then
      [[ "$e" != "$4" ]] || continue
      [[ ! -e "$e" ]] && _points_into "$e" "$csd" && rm -f -- "$e"
    elif [[ -d "$e" ]]; then
      [[ ! -e "$e/.git" ]] || continue
      rel="${e#"$ROOT/$src"/}"
      [[ -z "${SPACE_DIR["$src/$rel"]:-}" ]] || continue
      _remove_vanished_walk "$e" "$src" "$csd" "$4"
      rmdir -- "$e" 2>/dev/null || true
    fi
  done
  return 0
}

_remove_vanished() {
  local id="$1" src="${VANISHED_SRC[$1]}" dir csd
  dir=$(_space_home "$id")
  csd=$(_canon "${SRC_SD[$src]}") || csd="${SRC_SD[$src]}"
  _remove_vanished_walk "$dir" "$src" "$csd" "$dir/space.yml"
  rm -f -- "$dir/space.yml"
  _rmdir_empty_up "$dir" "$ROOT"
}

# --- Repositories -------------------------------------------------------------------------
#
# A space's space.yml lists the repositories to clone into its directory:
#   repositories: [{url, path?, ref?}]
# A repository's id is <space id>/<path>. A path may not lie inside a child space or contain one,
# so the longest prefix of an id that is a space is its space.

# A path from space.yml must stay inside its space
_repo_path_ok() {
  case "$1" in
    "") return 1 ;;
    /*) return 1 ;;
    ..|../*|*/../*|*/..) return 1 ;;
  esac
  return 0
}

# The repositories a space.yml declares, three lines each: url, path, ref. A path left out is
# the one git clone would use (anfs_repo_name, lib/anfs/repo.sh), and a trailing / is dropped.
_repo_entries() {
  [[ -f "$1" ]] || return 0
  local url path ref
  while IFS= read -r url && IFS= read -r path && IFS= read -r ref; do
    [[ -n "$url$path" ]] || continue
    [[ -n "$path" ]] || { anfs_repo_name_reply "$url"; path="$REPLY"; }
    while [[ "$path" == */ ]]; do path="${path%/}"; done
    printf '%s\n%s\n%s\n' "$url" "$path" "$ref"
  done < <(yq -r '.repositories[]? | [(.url // ""), (.path // ""), (.ref // "")] | .[]' "$1" 2>/dev/null)
}

# Why repository <path> of space <id> cannot be, into REPLY (empty when it can): a path that
# leaves the space, or one inside a child space or holding one
_repo_invalid() {
  local id="$1" path="$2" c cp full src="${SPACE_SRC[$1]}"
  REPLY=""
  _repo_path_ok "$path" || { REPLY="a path inside the space is needed"; return 0; }
  full="${SPACE_PATH[$id]:+${SPACE_PATH[$id]}/}$path"
  for c in "${SPACE_IDS[@]}"; do
    [[ "$c" != "$id" && "${SPACE_SRC[$c]}" == "$src" ]] || continue
    cp="${SPACE_PATH[$c]}"
    [[ -z "${SPACE_PATH[$id]}" || "$cp" == "${SPACE_PATH[$id]}"/* ]] || continue
    if [[ "$full" == "$cp" || "$full" == "$cp"/* ]]; then REPLY="inside the space $c"; return 0; fi
    if [[ "$cp" == "$full"/* ]]; then REPLY="holds the space $c"; return 0; fi
  done
  return 0
}

# Clone the repositories space <id> declares into its directory, or only the one at <only>
# Usage: _space_repositories <id> <dry:true|false> [only]
_space_repositories() {
  local id="$1" dry="$2" only="${3:-}" root file why
  root=$(_space_home "$id") file="${SPACE_DIR[$id]}/space.yml"
  command -v git >/dev/null 2>&1 || fail "$EX_UNAVAIL" "install needs git"

  # One field per line rather than @tsv: tab is IFS whitespace, so `IFS=$TAB read` collapses
  # adjacent tabs and an entry with a field left out would slide the rest along by one.
  local url path ref target cloned=0 present=0 failed=0 seen=$'\n'
  while IFS= read -r url && IFS= read -r path && IFS= read -r ref; do
    [[ -z "$only" || "$path" == "$only" ]] || continue
    if [[ -z "$url" || -z "$path" ]]; then
      warn "a repository needs a url, and a path (git's name for it when left out): url='$url' path='$path'"
      failed=$((failed + 1))
      continue
    fi
    _repo_invalid "$id" "$path"
    why="$REPLY"
    if [[ -n "$why" ]]; then
      warn "invalid repository $id/$path: $why"
      failed=$((failed + 1))
      continue
    fi
    # Two repositories in one place would pass the second off as present
    if [[ "$seen" == *$'\n'"$path"$'\n'* ]]; then
      warn "two repositories in $path: give one of them a path ($url)"
      failed=$((failed + 1))
      continue
    fi
    seen="$seen$path"$'\n'

    target="$root/$path"
    # Deliberately never a pull (no anfs_repo_update): a pull can conflict or fail, and what is
    # checked out is the user's
    if [[ -d "$target/.git" ]]; then
      echo "  present $path"
      present=$((present + 1))
      continue
    fi
    if [[ -e "$target" || -L "$target" ]]; then
      warn "in the way and not a git repo: $path"
      failed=$((failed + 1))
      continue
    fi
    if $dry; then
      echo "  would clone $path <- $url"
      cloned=$((cloned + 1))
      continue
    fi

    # lib/anfs/repo.sh: a failed clone or checkout of the ref leaves nothing at the path
    if ! anfs_repo_clone "$url" "$target" "$ref"; then
      warn "clone failed: $url${ref:+ at '$ref'}"
      failed=$((failed + 1))
      continue
    fi
    echo "  cloned $path"
    cloned=$((cloned + 1))
  done < <(_repo_entries "$file")

  [[ $((cloned + present + failed)) -eq 0 ]] ||
    printf '  %d cloned, %d present, %d failed\n' "$cloned" "$present" "$failed"
  [[ $failed -eq 0 ]]
}

# A repository id split at the longest prefix that is a space: REPO_SPACE and REPO_PATH, or 1
REPO_SPACE="" REPO_PATH=""
_repo_split() {
  local id="$1" pre rest=""
  pre="$id"
  while [[ "$pre" == */* ]]; do
    rest="${pre##*/}${rest:+/$rest}" pre="${pre%/*}"
    if [[ -n "${SPACE_DIR[$pre]:-}" ]]; then
      REPO_SPACE="$pre" REPO_PATH="$rest"
      return 0
    fi
  done
  return 1
}

# Whether <rel> (below space <id>) is inside one of the space's repositories
_in_repository() {
  local id="$1" rel="$2" url path ref
  while IFS= read -r url && IFS= read -r path && IFS= read -r ref; do
    [[ -n "$path" ]] || continue
    [[ "$rel" == "$path" || "$rel" == "$path"/* ]] && return 0
  done < <(_repo_entries "${SPACE_DIR[$id]}/space.yml")
  return 1
}

# --- The manifest: links:, files: and skills: -------------------------------------------------
#
# A space.yml's links: and files: are the vocabulary a package.yml has (lib/anfs/manifest.sh):
#   links:  - docs/                       a directory of the space as one link
#           - {path: p, platforms: [...]} only on those platforms
#           - {src: s, dest: d}           a link at d (default: s's basename) to s, relative; ~ and
#                                         $VAR expanded, a relative s is from the space's directory
#   files:  - p | {path, platforms}       copied when missing, then the user's; remove leaves it
#   skills: [{repo, skills?}]             agent skills installed into the space's directory by the
#                                         skills CLI (lib/anfs/skill.sh, the space's directory as
#                                         the scope)
# Every space a command needs is read with one yq (_meta_load), skills: in the same call. A space
# whose manifest is refused is invalid: listed so, installed not at all.
#   MF_ROWS[id]                            its links:/files: rows; META_SKILLS[id] its skills:
#   MF_LINKS MF_SRCS MF_COPIES MF_OFF MF_DIRS MF_ERR [id]   its plan (_mf_plan), as ANFS_MF_*

declare -A MF_ROWS=() META_SKILLS=() META_DONE=() MF_DONE=()
declare -A MF_LINKS=() MF_SRCS=() MF_COPIES=() MF_OFF=() MF_DIRS=() MF_ERR=() MF_INVALID=()
WSM_PLATFORM=""
_meta_load() {
  local id f i line rest sep="$ANFS_US"
  local -a files=() ids=()
  for id in "$@"; do
    [[ -z "${META_DONE[$id]:-}" && -n "${SPACE_DIR[$id]:-}" ]] || continue
    META_DONE[$id]=1 MF_ROWS[$id]="" META_SKILLS[$id]=""
    files+=("${SPACE_DIR[$id]}/space.yml") ids+=("$id")
  done
  [[ ${#files[@]} -gt 0 ]] || return 0
  local out
  out=$(ANFS_MF_YQ_EXTRA='(.skills[]? | select(tag == "!!map") | [fileIndex, "X", (.repo // ""), ((.skills // []) | join(",")), (.skills | tag)] | join(strenv(ANFS_MF_SEP)))' \
    anfs_manifest_read "${files[@]}")
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    i="${line%%$'\t'*}" rest="${line#*$'\t'}"
    id="${ids[$i]:-}"
    [[ -n "$id" ]] || continue
    case "$rest" in
      extra$'\t'*) META_SKILLS[$id]+="${rest#extra$'\t'}"$'\n' ;;
      *) MF_ROWS[$id]+="$line"$'\n' ;;
    esac
  done <<< "$out"
}

# The plan of space <id>'s manifest for this platform, into MF_*[id] (once): its own files are the
# candidates (_files_load first), and what only wsm knows is refused too: a directory link that is,
# holds or lies in a child space or a repository, a directory link where the skills CLI writes (a
# hidden directory, when the space declares skills:), and space.yml in files: or a path entry (it
# is how wsm knows the space is installed: always linked).
_mf_plan() {
  local id="$1" d c cp p url path ref err="" line
  [[ -z "${MF_DONE[$id]:-}" ]] || return 0
  MF_DONE[$id]=1
  _meta_load "$id"
  MF_SRCS[$id]="" MF_COPIES[$id]="" MF_OFF[$id]="" MF_DIRS[$id]="" MF_ERR[$id]="" MF_INVALID[$id]=""
  if [[ -z "${MF_ROWS[$id]}" ]]; then
    MF_LINKS[$id]="${SPACE_FILES[$id]}"
    return 0
  fi
  [[ -n "$WSM_PLATFORM" ]] || WSM_PLATFORM=$(platform)
  _wsm_tmp
  printf '%s' "${SPACE_FILES[$id]}" > "$WSM_TMP/mf.files"
  _home_of "$id"
  ANFS_MF_SRC_BASE="$REPLY" anfs_manifest_plan "${MF_ROWS[$id]}" "${SPACE_DIR[$id]}" "$WSM_PLATFORM" "$WSM_TMP/mf.files" || true
  err="$ANFS_MF_ERR"
  # What only wsm knows
  while IFS= read -r line; do
    line="${line#*$'\t'}"
    case "$line" in
      file$'\t'space.yml$'\t'*|path$'\t'space.yml$'\t'*)
        err+="space.yml is how wsm knows the space is installed: it is always linked"$'\n' ;;
    esac
  done <<< "${MF_ROWS[$id]}"
  while IFS= read -r d; do
    [[ -n "$d" ]] || continue
    for c in "${SPACE_IDS[@]}"; do
      [[ "$c" != "$id" && "${SPACE_SRC[$c]}" == "${SPACE_SRC[$id]}" ]] || continue
      cp="${SPACE_PATH[$c]}" p="${SPACE_PATH[$id]:+${SPACE_PATH[$id]}/}$d"
      if [[ "$cp" == "$p" || "$cp" == "$p"/* ]]; then err+="the directory link $d/ holds the space $c"$'\n'
      elif [[ "$p" == "$cp"/* ]]; then err+="the directory link $d/ is inside the space $c"$'\n'; fi
    done
    while IFS= read -r url && IFS= read -r path && IFS= read -r ref; do
      [[ -n "$path" ]] || continue
      if [[ "$path" == "$d" || "$path" == "$d"/* || "$d" == "$path"/* ]]; then
        err+="the directory link $d/ and the repository $path overlap"$'\n'
      fi
    done < <(_repo_entries "${SPACE_DIR[$id]}/space.yml")
    if [[ -n "${META_SKILLS[$id]}" && "$d" == .* ]]; then
      err+="the directory link $d/ is where the skills CLI writes (this space declares skills:)"$'\n'
    fi
  done <<< "$ANFS_MF_DIRS$(printf '%s' "${MF_ROWS[$id]}" | awk -F'\t' '$2 == "dir" { print $3 }')"
  if [[ -n "$err" ]]; then
    MF_ERR[$id]=$(printf '%s' "$err" | awk '!seen[$0]++')$'\n'
    MF_LINKS[$id]="${SPACE_FILES[$id]}"
    return 0
  fi
  MF_LINKS[$id]="$ANFS_MF_LINKS" MF_SRCS[$id]="$ANFS_MF_SRCS" MF_COPIES[$id]="$ANFS_MF_COPIES"
  MF_OFF[$id]="$ANFS_MF_OFF" MF_DIRS[$id]="$ANFS_MF_DIRS" MF_INVALID[$id]="$ANFS_MF_INVALID"
}

# Whether <home> is a space's directory wsm may act in: set, absolute, strictly below the root (which
# must be set) and an existing directory, not a link. Every links:/skills: function asks this before
# it touches the disk, so an empty ROOT or path can never make it write, remove or glob at / or $HOME.
_home_ok() {
  local h="$1"
  [[ -n "$ROOT" && "$ROOT" == /?* && -n "$h" && "$h" == "$ROOT"/?* ]] || { warn "refusing to act on '$h': not below the spaces root"; return 1; }
  [[ "$h" != *"/../"* && "$h" != */.. ]] || { warn "refusing to act on '$h'"; return 1; }
  [[ -d "$h" && ! -L "$h" ]] || return 1
}

# --- links: {src} ---

# The links out of the tree of space <id> (its manifest's src: entries for this platform):
# LK_SRC, LK_DEST (relative to the space's directory) and LK_STATE (anfs_link_src_state: ok,
# missing, missing src, wrong, in the way; invalid: an entry wrong on its own, an unset variable
# and the like, its src as written and LK_WHY why: skipped, the rest made)
LK_SRC=() LK_DEST=() LK_STATE=() LK_WHY=()
_links_eval() {
  local id="$1" home dest src why
  LK_SRC=() LK_DEST=() LK_STATE=() LK_WHY=()
  _mf_plan "$id"
  _home_of "$id"
  home="$REPLY"
  while IFS=$'\t' read -r dest src; do
    [[ -n "$dest" ]] || continue
    LK_SRC+=("$src") LK_DEST+=("$dest") LK_STATE+=("$(anfs_link_src_state "$home/$dest" "$src")") LK_WHY+=("")
  done <<< "${MF_SRCS[$id]:-}"
  while IFS=$'\t' read -r dest src why; do
    [[ -n "$dest" ]] || continue
    LK_SRC+=("$src") LK_DEST+=("$dest") LK_STATE+=(invalid) LK_WHY+=("$why")
  done <<< "${MF_INVALID[$id]:-}"
}

# Make the links out of the tree of space <id>, relative (anfs_link_one). What is there and right
# stays (an absolute one too); a src that does not exist is said and not made (no failure); a link
# elsewhere or anything else in the way fails the entry, unless -f moves it aside (_backup; nothing
# restores it).
# Usage: _space_links <id> <dry> <force>
_space_links() {
  local id="$1" dry="$2" force="$3" i home st d rel failed=0
  _links_eval "$id"
  [[ ${#LK_DEST[@]} -gt 0 ]] || return 0
  _home_of "$id"
  home="$REPLY"
  if ! $dry && ! _home_ok "$home"; then
    warn "no directory for $id's links: $(_display "$home")"
    return 1
  fi
  for i in "${!LK_DEST[@]}"; do
    st="${LK_STATE[$i]}" d="${LK_DEST[$i]}"
    rel="${SPACE_PATH[$id]:+${SPACE_PATH[$id]}/}$d"
    case "$st" in
      ok) continue ;;
      invalid)
        warn "invalid link in $id, skipped: ${LK_WHY[$i]} (src: ${LK_SRC[$i]})"
        failed=$((failed + 1))
        continue
        ;;
      "missing src")
        echo "  missing src $d -> $(_display "${LK_SRC[$i]}") (not linked)"
        continue
        ;;
      wrong|"in the way")
        if ! $force; then
          warn "$st: $(_display "$home/$d") (link to $(_display "${LK_SRC[$i]}"); wsm install -f $id moves it aside)"
          failed=$((failed + 1))
          continue
        fi
        if $dry; then echo "  would move aside $(_display "$home/$d")"
        else _backup "${SPACE_SRC[$id]}" "$rel"; fi
        ;;
    esac
    if $dry; then
      echo "  would link $d -> $(_display "${LK_SRC[$i]}")"
    elif anfs_link_one "${LK_SRC[$i]}" "$home/$d"; then
      echo "  linked $d -> $(_display "${LK_SRC[$i]}")"
    else
      failed=$((failed + 1))
    fi
  done
  [[ $failed -eq 0 ]]
}

# Remove the links out of the tree of space <id> while they still point at their src; one the user
# repointed stays
_remove_links() {
  local id="$1" i home
  _links_eval "$id"
  [[ ${#LK_DEST[@]} -gt 0 ]] || return 0
  _home_of "$id"
  home="$REPLY"
  _home_ok "$home" || return 0
  for i in "${!LK_DEST[@]}"; do
    [[ "${LK_STATE[$i]}" != invalid ]] || continue
    anfs_unlink_src "$home/${LK_DEST[$i]}" "${LK_SRC[$i]}"
    [[ "${LK_DEST[$i]}" != */* ]] || _rmdir_empty_up "$home/${LK_DEST[$i]%/*}" "$home"
  done
  return 0
}

# --- files: ---

# The copies of space <id> planned (anfs_files_plan, from its directory in the source to its
# directory under the root), into CP_LINES ("<state>\t<path>[\t<detail>]"); nothing when it has
# none
CP_LINES=""
_copies_plan() {
  local id="$1"
  CP_LINES=""
  _mf_plan "$id"
  [[ -n "${MF_COPIES[$id]:-}" ]] || return 0
  _home_of "$id"
  CP_LINES=$(anfs_files_plan "${SPACE_DIR[$id]}" "$REPLY" <(printf '%s' "${MF_COPIES[$id]}") 2>/dev/null) || true
}

# --- skills: ---
#
# Only the declaring space: a child space's directory is never a scope for its parent's skills.

# The install rows of space <id> (lib/anfs/skill.sh's <label>|<repo>|<skills csv>|<agents csv>)
# into SK_ROWS, each repo as the CLI takes it: a path resolved through links (cd -P: the CLI does
# not follow linked directories), a relative one from the space.yml's directory in the source;
# every skill of a path by name (a real status for each), "*" for a remote. SK_BAD counts the
# entries that cannot be.
SK_ROWS=() SK_BAD=0
_skill_rows() {
  local id="$1" repo names tag d
  SK_ROWS=() SK_BAD=0
  _meta_load "$id"
  while IFS="$ANFS_US" read -r repo names tag; do
    [[ -n "$repo$names$tag" ]] || continue
    [[ -n "$repo" ]] || { warn "a skills: entry of $id has no repo"; SK_BAD=$((SK_BAD + 1)); continue; }
    case "$repo" in
      .|./*|../*|/*|"~"|"~/"*)
        d=$(anfs_skill_expand "$repo")
        [[ "$d" == /* ]] || d="${SPACE_DIR[$id]}/$d"
        if ! d=$(cd -P -- "$d" 2>/dev/null && pwd -P); then
          warn "no such skills directory in $id: $repo"
          SK_BAD=$((SK_BAD + 1))
          continue
        fi
        repo="$d"
        if [[ "$tag" == '!!null' ]]; then
          names=$(anfs_skill_dir_skills "$d" | paste -sd, -)
          [[ -n "$names" ]] || { warn "no <skill>/SKILL.md in $(_display "$d") ($id)"; SK_BAD=$((SK_BAD + 1)); continue; }
        fi
        ;;
      *) [[ "$tag" != '!!null' ]] || names='*' ;;
    esac
    [[ -n "$names" ]] || continue
    SK_ROWS+=("$id|$repo|$names|")
  done <<< "${META_SKILLS[$id]:-}"
}

# The names the CLI recorded in a space's skills-lock.json, "<name><US><source>" a line each (yq,
# no npx); nothing when there is none
_skill_lock() {
  local f="$1/skills-lock.json"
  [[ -f "$f" ]] || return 0
  WSM_SEP="$ANFS_US" yq -p json -r '.skills // {} | to_entries[] | .key + strenv(WSM_SEP) + (.value.source // "")' "$f" 2>/dev/null || true
}

# The skills space <id> declares, by name, into SK_NAMES: the named ones, and for a remote "*" what
# its skills-lock.json says came from that repo. Only these are ever removed (a skill the user
# added in the space by hand is not wsm's).
SK_NAMES=()
_skill_names() {
  local id="$1" row repo names n src lock=""
  local -a list=()
  SK_NAMES=()
  _skill_rows "$id" 2>/dev/null
  for row in ${SK_ROWS[@]+"${SK_ROWS[@]}"}; do
    repo="${row#*|}" repo="${repo%%|*}" names="${row#*|*|}" names="${names%|}"
    if [[ "$names" == '*' ]]; then
      if [[ -z "$lock" ]]; then _home_of "$id"; lock=$(_skill_lock "$REPLY")$'\n'; fi
      while IFS="$ANFS_US" read -r n src; do
        [[ -n "$n" && "$src" == "$repo" ]] && SK_NAMES+=("$n")
      done <<< "$lock"
      continue
    fi
    IFS=',' read -r -a list <<< "$names"
    SK_NAMES+=(${list[@]+"${list[@]}"})
  done
  return 0
}

# npx, checked once per run; without it a space's skills are skipped with one warning
NPX_OK=""
_npx_ok() {
  if [[ -z "$NPX_OK" ]]; then
    if anfs_skill_require 2>/dev/null; then NPX_OK=true
    else NPX_OK=false; warn "npx not found, so the spaces' skills are skipped: ppm install node, then wsm skill install"; fi
  fi
  $NPX_OK
}

# The agents, once per run (lib/anfs/skill.sh: ppm's packages that declare meta.agent)
AGENTS=""
AGENTS_DONE=false
_agents() { $AGENTS_DONE || { AGENTS=$(anfs_skill_agents); AGENTS_DONE=true; }; }

# Install the skills space <id> declares into its directory. A path's skills are copied again every
# run (they are the space's own, and edits arrive that way); a remote's when missing for an agent.
# No agent yet is waiting, and no npx a warning: neither fails.
# Usage: _space_skills <id> <dry>
_space_skills() {
  local id="$1" dry="$2" row home rc=0
  _skill_rows "$id"
  [[ ${#SK_ROWS[@]} -gt 0 || $SK_BAD -gt 0 ]] || return 0
  _home_of "$id"
  home="$REPLY"
  if $dry; then
    for row in ${SK_ROWS[@]+"${SK_ROWS[@]}"}; do
      row="${row#*|}"
      echo "  would install skills ${row#*|}"
    done
    [[ $SK_BAD -eq 0 ]]
    return
  fi
  if [[ ${#SK_ROWS[@]} -gt 0 ]] && ! _home_ok "$home"; then
    warn "no directory for $id's skills: $(_display "$home")"
    return 1
  fi
  if [[ ${#SK_ROWS[@]} -gt 0 ]] && _npx_ok; then
    _agents
    if [[ -z "$AGENTS" ]]; then
      echo "  skills: waiting for an agent (installing an agent package installs them)"
    else
      anfs_skill_load "$home"
      anfs_skill_sync_rows "$home" true "$AGENTS" < <(printf '%s\n' "${SK_ROWS[@]}") || rc=1
      printf '  skills: %d synced, %d up to date, %d failed\n' "$ANFS_SKILL_SYNCED" "$ANFS_SKILL_CURRENT" "$ANFS_SKILL_FAILED"
    fi
  fi
  [[ $SK_BAD -eq 0 && $rc -eq 0 ]]
}

# What the skills CLI leaves once a space has no skills: a skills-lock.json with none, and empty
# skills directories (.agents/skills, .claude/skills, ...) with their parents; rmdir only
_skills_tidy() {
  local home="$1" d n
  _home_ok "$home" || return 0
  if [[ -f "$home/skills-lock.json" ]]; then
    n=$(yq -p json -r '.skills // {} | length' "$home/skills-lock.json" 2>/dev/null) || n=""
    [[ "$n" != 0 ]] || rm -f -- "$home/skills-lock.json"
  fi
  for d in "$home"/.*/skills "$home"/.*/*/skills; do
    [[ -d "$d" && ! -L "$d" ]] || continue
    _rmdir_empty_up "$d" "$home"
  done
}

# Remove from space <id>'s directory the skills it declares that are installed there
# (anfs_skill_remove: for the agents each is on, never unscoped, then the shared copy and the lock
# entry), then tidy. Without npx they stay, said once.
# Usage: _remove_skills <id> [name...]   (the names: only those, if declared)
_remove_skills() {
  local id="$1" home n
  shift
  local -a want=("$@") names=()
  _skill_names "$id"
  [[ ${#SK_NAMES[@]} -gt 0 ]] || return 0
  _home_of "$id"
  home="$REPLY"
  _home_ok "$home" || return 0
  _npx_ok || return 0
  for n in "${SK_NAMES[@]}"; do
    [[ ${#want[@]} -eq 0 ]] || _in_list "$n" "${want[@]}" || continue
    _in_list "$n" ${names[@]+"${names[@]}"} || names+=("$n")
  done
  if [[ ${#names[@]} -gt 0 ]]; then
    if ! anfs_skill_remove "$home" "${names[@]}" >/dev/null; then
      warn "skills remove in $id failed: ${names[*]}"
      return 1
    fi
    [[ ${#ANFS_SKILL_REMOVED[@]} -eq 0 ]] || echo "  removed skills ${ANFS_SKILL_REMOVED[*]} from $id"
  fi
  _skills_tidy "$home"
}

# --- install ------------------------------------------------------------------------------

# The spaces a space depends on (anfs_resolve's deps callback): ids, or paths that resolve from
# the declaring source down. A trailing / is dropped: a dependency is one space.
_space_deps() {
  local file="$1/space.yml" dep
  [[ -f "$file" ]] || return 0
  while IFS= read -r dep; do
    [[ -n "$dep" ]] && printf '%s\n' "${dep%/}"
  done < <(yq -r '.depends[]? // ""' "$file" 2>/dev/null)
}

# Refuse a root inside a source checkout: the source would be linked into itself, and what
# install clones would land in it
_target_check() {
  local s
  if s=$(_source_holding "$ROOT"); then
    warn "$(_display "$ROOT") (WSM_SPACES_HOME) is inside the source $s: set it somewhere else"
    return 1
  fi
}

# Where you are: inside the tree, <root>/<src>/..., or inside a source checkout,
# <source>/spaces/... CTX_REL is the path below the source's spaces/ (empty at its top, or outside
# spaces/ in a checkout: CTX_SPACES=false).
CTX_SRC="" CTX_REL="" CTX_KIND="" CTX_SPACES=true
_context() {
  local p="$1" s d
  CTX_SRC="" CTX_REL="" CTX_KIND="" CTX_SPACES=true
  if [[ "$p" == "$ROOT"/* ]]; then
    s="${p#"$ROOT"/}" s="${s%%/*}"
    if _is_registered "$s"; then
      CTX_SRC="$s" CTX_KIND=tree
      CTX_REL="${p#"$ROOT/$s"}" CTX_REL="${CTX_REL#/}"
      return 0
    fi
  fi
  CTX_SRC=$(_source_holding "$p") || { CTX_SRC=""; return 1; }
  CTX_KIND=source
  d=$(_canon "$(gitsrc_dir "$CTX_SRC")")
  if [[ "$p" == "$d/spaces" || "$p" == "$d/spaces"/* ]]; then
    CTX_REL="${p#"$d/spaces"}" CTX_REL="${CTX_REL#/}"
  else
    CTX_SPACES=false
  fi
}

# The space at the current directory, which must hold a space.yml: in the tree or in a source's
# spaces/
_spec_here() {
  local here
  [[ -f space.yml ]] || usage_err "wsm install SPEC... (no space.yml in the current directory)"
  here=$(_canon "$PWD") || here="$PWD"
  if ! _context "$here" || ! $CTX_SPACES; then
    fail "$EX_NOTFOUND" "not inside a source's spaces/ or the spaces tree: wsm install SPEC"
  fi
  printf '%s\n' "$CTX_SRC${CTX_REL:+/$CTX_REL}"
}

cmd_install() {
  local dry=${CLI_OPT[dry-run]:-false} force=${CLI_OPT[force]:-false} spec id i failed=0 prefix=false
  local -a specs=("$@") srcs=()
  _root_load
  if [[ ${#specs[@]} -eq 0 ]]; then
    specs=("$(_spec_here)")
    echo "install ${specs[0]}"
  fi
  for spec in "${specs[@]}"; do
    _spec_ok "$spec"
    [[ "$spec" != */ ]] || prefix=true
  done
  _require_yq
  _spaces_load
  _specs_expand "${specs[@]}"
  ! $prefix || $dry || anfs_confirm "install ${specs[*]} installs every space under a prefix: ${EXPANDED[*]}" "Install them?"

  # Dependency order; a missing space or a cycle exits here, before anything is linked
  ANFS_ORDER=() ANFS_ORDER_DIRS=()
  ( anfs_resolve spaces _space_deps "${EXPANDED[@]}" ) >/dev/null || exit "$EX_NOTFOUND"
  anfs_resolve spaces _space_deps "${EXPANDED[@]}"
  for id in "${ANFS_ORDER[@]}"; do
    [[ -n "${SPACE_DIR[$id]:-}" ]] || fail "$EX_NOTFOUND" "no space $id (a dependency's name is an id or a path: wsm ls)"
    _in_list "${SPACE_SRC[$id]}" ${srcs[@]+"${srcs[@]}"} || srcs+=("${SPACE_SRC[$id]}")
  done

  _target_check || exit "$EX_NOTFOUND"
  _state_load true "${srcs[@]}"
  local -A was=()
  for id in "${ANFS_ORDER[@]}"; do [[ -z "${INSTALLED[$id]:-}" ]] || was[$id]=1; done
  $dry || mkdir -p -- "$ROOT" || die "cannot create $ROOT"

  for i in "${!ANFS_ORDER[@]}"; do
    id="${ANFS_ORDER[$i]}"
    if ! _install_space "$id" "$dry" "$force"; then
      failed=$((failed + 1))
      continue
    fi
    if ! $dry; then
      INSTALLED[$id]=1
      [[ -n "${was[$id]:-}" ]] || WSM_EV_INSTALLED+=("$id")
    fi
    _space_repositories "$id" "$dry" || failed=$((failed + 1))
    _space_links "$id" "$dry" "$force" || failed=$((failed + 1))
    _space_skills "$id" "$dry" || failed=$((failed + 1))
  done
  [[ $failed -eq 0 ]]
}

# --- Commands -----------------------------------------------------------------------------

# The installed spaces and the ones not in the source that <spec> names, into MATCHES
MATCHES=()
_match_installed() {
  local id
  MATCHES=()
  _spec_parse "$1"
  for id in ${SPACE_IDS[@]+"${SPACE_IDS[@]}"}; do
    [[ -n "${INSTALLED[$id]:-}" ]] && _spec_match "$id" && MATCHES+=("$id")
  done
  for id in ${VANISHED_IDS[@]+"${VANISHED_IDS[@]}"}; do
    _spec_match_path "${VANISHED_SRC[$id]}" "${VANISHED_PATH[$id]}" && MATCHES+=("$id")
  done
  [[ ${#MATCHES[@]} -gt 0 ]]
}

cmd_remove() {
  local spec id rc=0
  local -a drop=() order=()
  for spec in "$@"; do _spec_ok "$spec"; done
  _require_yq
  _spaces_load
  _root_load
  _state_load true
  for spec in "$@"; do
    if ! _match_installed "$spec"; then
      warn "not installed: $spec"
      rc=$EX_NOTFOUND
      continue
    fi
    for id in "${MATCHES[@]}"; do
      _in_list "$id" ${drop[@]+"${drop[@]}"} || drop+=("$id")
    done
  done
  [[ ${#drop[@]} -gt 0 ]] || return "$rc"
  anfs_confirm "remove unlinks ${drop[*]} (clones and your files stay)" "Remove?"
  # The deepest first, so a parent's directories are left empty for it to take
  mapfile -t order < <(for id in "${drop[@]}"; do printf '%s\t%s\n' "${#id}" "$id"; done | sort -rn | cut -f2-)
  for id in "${order[@]}"; do
    if [[ -n "${VANISHED_SRC[$id]:-}" ]]; then _remove_vanished "$id"; else _remove_space "$id"; fi
    printf 'removed %s %s\n' "$id" "$(_display "$(_space_home "$id")")"
    WSM_EV_REMOVED+=("$id")
  done
  return "$rc"
}

# --- move ---------------------------------------------------------------------------------
#
# `wsm move <source/path> <to-source> [-n] [-f]`: a space, and every space under it (its directory
# in the source holds them), moves to another source with its history (lib/anfs/move.sh: commits
# in both, nothing pushed). When it is installed, its directory under the root moves too, in one
# rename (the clones, the user's files and the copies go with it untouched), and the links are
# made again from the new source. Ids are not rewritten anywhere: a dependency, a stack or an ovm
# vault link that names <from>/<path> is listed by the check and edited by the person.

# A relative links: src or skills: repo of space <id> that leaves the moved directory <top> (a
# path below spaces/): what it names would be another source's after the move. One line each.
_move_escapes() {
  local id="$1" top="$2" line kind path repo names tag base
  _meta_load "$id"
  while IFS=$'\t' read -r _ kind path _; do
    [[ "$kind" == src ]] || continue
    case "$path" in /*|"~"*|'$'*) continue ;; esac
    # a links: src is relative to the space's directory under the root, which mirrors the source
    base="${SPACE_PATH[$id]}"
    _anfs_link_norm "/$base/$path"
    [[ "$_ANFS_P" == "/$top" || "$_ANFS_P" == "/$top"/* ]] || printf '%s: links: src %s\n' "$id" "$path"
  done <<< "${MF_ROWS[$id]:-}"
  while IFS="$ANFS_US" read -r repo names tag; do
    case "$repo" in .|./*|../*) ;; *) continue ;; esac
    _anfs_link_norm "/${SPACE_PATH[$id]}/$repo"
    [[ "$_ANFS_P" == "/$top" || "$_ANFS_P" == "/$top"/* ]] || printf '%s: skills: repo %s\n' "$id" "$repo"
  done <<< "${META_SKILLS[$id]:-}"
}

# The clones under space <id>'s directory, one path a line
_move_clones() {
  local url path ref home
  home=$(_space_home "$1")
  while IFS= read -r url && IFS= read -r path && IFS= read -r ref; do
    [[ -e "$home/$path/.git" ]] && printf '%s\n' "$path"
  done < <(_repo_entries "${SPACE_DIR[$1]}/space.yml")
}

# How many working trees a clone has (itself included)
_move_worktrees() { git -C "$1" worktree list --porcelain 2>/dev/null | grep -c '^worktree ' || true; }

cmd_move() {
  local id="${1%/}" to="${2%/}" dry=${CLI_OPT[dry-run]:-false} force=${CLI_OPT[force]:-false}
  local from p parent rc=0 i x c n bad="" installed=false
  local -a fl=() moved=() was=() news=() clones=()
  $force && fl=(-f)
  _spec_ok "$id"
  _require_yq
  _spaces_load
  _root_load
  from="${id%%/*}"
  if [[ "$id" != */* ]]; then
    anfs_is_source "$id" &&
      fail "$EX_USAGE" "$id is a source's root space: its directory is the source's whole spaces/; move the spaces under it instead"
    fail "$EX_USAGE" "'$id' names no source: wsm move <source>/<path> <to-source>"
  fi
  anfs_is_source "$from" || fail "$EX_USAGE" "'$id' names no source: wsm move <source>/<path> <to-source>"
  [[ -n "${SPACE_DIR[$id]:-}" ]] || fail "$EX_NOTFOUND" "no space $id (wsm ls)"
  p="${SPACE_PATH[$id]}" parent=""
  [[ "$p" != */* ]] || parent="${p%/*}"
  # The space and those under it, parents first
  for x in "${SPACE_IDS[@]}"; do
    [[ "${SPACE_SRC[$x]}" == "$from" ]] || continue
    [[ "${SPACE_PATH[$x]}" == "$p" || "${SPACE_PATH[$x]}" == "$p"/* ]] && moved+=("$x")
  done
  mapfile -t moved < <(for x in "${moved[@]}"; do printf '%s\t%s\n' "${#x}" "$x"; done | sort -n | cut -f2-)

  anfs_move_check "${fl[@]}" spaces "$id" "$to" _space_deps || rc=$?
  if (( rc != 0 )); then
    if (( rc == 1 )); then warn "move refused: -f moves despite what it says"; else warn "move refused"; fi
    return "$rc"
  fi

  # wsm's own refusals, before anything changes
  _state_load true "$from"
  for x in "${moved[@]}"; do
    [[ -n "${INSTALLED[$x]:-}" ]] || continue
    installed=true was+=("$x")
    _space_counts "$x"
    (( C_WRONG + C_WAY + C_LEFT == 0 )) ||
      bad+="  $x: $REPLY (wsm install -f $x first, so the relink meets nothing)"$'\n'
  done
  local home="$ROOT/$from/$p" dest="$ROOT/$to/$p" q=""
  if $installed || [[ -d "$home" ]]; then
    installed=true
    if [[ -e "$dest" || -L "$dest" ]]; then
      bad+="  $(_display "$dest") is there already"$'\n'
    else
      for x in "" ${parent//\// }; do
        q+="${x:+/$x}"
        if [[ -L "$ROOT/$to$q" || ( -e "$ROOT/$to$q" && ! -d "$ROOT/$to$q" ) ]]; then
          bad+="  $(_display "$ROOT/$to$q") is in the way (not a directory)"$'\n'
          break
        fi
      done
    fi
  fi
  if [[ -n "$bad" ]]; then
    printf '%s' "$bad" >&2
    warn "move refused"
    return 1
  fi
  # Relative paths out of the moved directory, in the check's form
  local esc="" st=refused
  $force && st=forced
  for x in "${moved[@]}"; do esc+="$(_move_escapes "$x" "$p")"$'\n'; done
  while IFS= read -r x; do
    [[ -z "$x" ]] || printf '%s\tpaths\t%s: relative, out of %s, so another source'"'"'s after the move\n' "$st" "$x" "$id"
  done <<< "$esc"
  if [[ -n "${esc//$'\n'/}" ]] && ! $force; then
    warn "move refused: -f moves despite what it says"
    return 1
  fi

  for x in "${moved[@]}"; do news+=("$to${SPACE_PATH[$x]:+/${SPACE_PATH[$x]}}"); done
  if $installed; then
    for x in "${was[@]}"; do
      while IFS= read -r c; do [[ -z "$c" ]] || clones+=("$(_space_home "$x")/$c"); done < <(_move_clones "$x")
    done
  fi

  if $dry; then
    anfs_move_tree -n spaces "$id" "$to" || return 1
    if $installed; then
      printf '%-8s %s -> %s (%d clone%s inside, untouched)\n' move "$(_display "$home")" "$(_display "$dest")" \
        "${#clones[@]}" "$([[ ${#clones[@]} -eq 1 ]] || echo s)"
      local rl=""
      for x in "${was[@]}"; do
        _files_of "$x"
        rl+="${rl:+; }$x: ${#FILES[@]} links"
      done
      printf '%-8s %s\n' relink "$rl"
      for c in ${clones[@]+"${clones[@]}"}; do
        n=$(_move_worktrees "$c")
        (( n > 1 )) && printf '%-8s %s (%d worktrees)\n' "worktree repair" "${c#"$home"/}" "$((n - 1))"
      done
      local -a nw=()
      for i in "${!moved[@]}"; do [[ -z "${INSTALLED[${moved[$i]}]:-}" ]] || nw+=("${news[$i]}"); done
      printf '%-8s wsm remove %s; install %s\n' events "${was[*]}" "${nw[*]}"
    else
      printf 'not installed: wsm install %s links it\n' "$to/$p"
    fi
    return 0
  fi

  anfs_move_tree spaces "$id" "$to" || return 1
  if ! $installed; then
    echo "not installed: wsm install $to/$p links it"
    return 0
  fi

  # The installed directory, in one rename: the clones and the user's files go with it
  if ! mkdir -p -- "$(dirname -- "$dest")" || ! mv -- "$home" "$dest"; then
    fail 1 "the source moved, its directory under $(_display "$ROOT") did not: move $(_display "$home") to $(_display "$dest"), then wsm install $to/$p"
  fi
  [[ -z "$parent" ]] || _rmdir_empty_up "$ROOT/$from/$parent" "$ROOT"
  _rmdir_empty_up "$ROOT/$from" "$ROOT"
  echo "moved $(_display "$home") -> $(_display "$dest")"

  # The links again, from the new source (a link dangling into the sources is replaced)
  _spaces_reset
  _spaces_load
  _state_load true "$to"
  local failed=0
  for i in "${!moved[@]}"; do
    _in_list "${moved[$i]}" "${was[@]}" || continue
    x="${news[$i]}"
    if [[ -z "${SPACE_DIR[$x]:-}" ]] || ! _install_space "$x" false false; then
      failed=$((failed + 1))
      continue
    fi
    INSTALLED[$x]=1
    _space_links "$x" false false || failed=$((failed + 1))
    _space_skills "$x" false || failed=$((failed + 1))
    WSM_EV_REMOVED+=("${moved[$i]}") WSM_EV_INSTALLED+=("$x")
  done

  # Worktrees elsewhere (anfs work) name the clone's old path in their .git file
  for c in ${clones[@]+"${clones[@]}"}; do
    c="$dest${c#"$home"}"
    n=$(_move_worktrees "$c")
    (( n > 1 )) || continue
    if git -C "$c" worktree repair >/dev/null 2>&1; then echo "  worktrees repaired: ${c#"$dest"/}"
    else warn "worktrees of $(_display "$c") not repaired: git -C $(_display "$c") worktree repair"; fi
  done
  echo "ids are not rewritten: what names ${id} (a vault link of ovm's, a depends:) now names nothing"
  (( failed == 0 )) || fail 1 "the source moved; wsm install $to/$p"
}

# Resolve a cd/path query into Q_DIR: an installed id; the installed ids that end in /<QUERY>; a
# source (<source>/ or <source>) names <root>/<source>. Exits 1 on no match and 2 on several, so
# it must be called directly, never in $(...).
Q_ID="" Q_DIR=""
_resolve_query() {
  local q="${1%/}" id
  local -a ids=()
  Q_ID="" Q_DIR=""
  if [[ -n "${INSTALLED[$q]:-}" ]]; then
    ids=("$q")
  else
    for id in "${SPACE_IDS[@]}"; do
      [[ -n "${INSTALLED[$id]:-}" && "$id" == */"$q" ]] && ids+=("$id")
    done
  fi
  if [[ ${#ids[@]} -eq 0 ]]; then
    if [[ "$q" != */* ]] && anfs_is_source "$q" && [[ -d "$ROOT/$q" ]]; then
      Q_DIR="$ROOT/$q"
      return 0
    fi
    fail "$EX_NOTFOUND" "no installed space matching '$1' (wsm ls)"
  fi
  if [[ ${#ids[@]} -gt 1 ]]; then
    warn "'$1' is ambiguous:"
    for id in "${ids[@]}"; do
      printf '%s  %s\n' "$id" "$(_display "$(_space_home "$id")")" >&2
    done
    exit "$EX_AMBIGUOUS"
  fi
  Q_ID="${ids[0]}" Q_DIR=$(_space_home "${ids[0]}")
}

cmd_path() {
  local source=${CLI_OPT[source]:-false} q="${1:-}" first d id best=""
  _spaces_load
  _root_load

  # -s with a source-qualified name needs nothing installed: <src>/spaces/<the rest>
  if $source && [[ -n "$q" ]]; then
    first="${q%%/*}"
    if anfs_is_source "$first"; then
      d="${SRC_SD[$first]}"
      [[ "$q" != */?* ]] || d="$d/${q#*/}"
      d="${d%/}"
      [[ -d "$d" ]] || fail "$EX_NOTFOUND" "no such directory in $first: $(_display "$d")"
      printf '%s\n' "$d"
      return 0
    fi
  fi
  _state_load false

  # No query: the deepest installed space containing the current directory
  if [[ -z "$q" ]]; then
    local here
    here=$(_canon "$PWD") || here="$PWD"
    for id in "${SPACE_IDS[@]}"; do
      [[ -n "${INSTALLED[$id]:-}" ]] || continue
      _home_of "$id"
      d="$REPLY"
      [[ "$here" == "$d" || "$here" == "$d"/* ]] || continue
      [[ ${#id} -le ${#best} ]] || best="$id"
    done
    [[ -n "$best" ]] || fail "$EX_NOTFOUND" "not inside an installed space"
    if $source; then printf '%s\n' "${SPACE_DIR[$best]}"; else _space_home "$best"; fi
    return 0
  fi

  _resolve_query "$q"
  if $source; then
    [[ -n "$Q_ID" ]] || { printf '%s\n' "${SRC_SD[${q%/}]}"; return 0; }
    printf '%s\n' "${SPACE_DIR[$Q_ID]}"
    return 0
  fi
  printf '%s\n' "$Q_DIR"
}

# `wsm ls [SPEC]`: every space the sources define (under SPEC), its state when installed, then the
# spaces the tree still has that the sources no longer define. `wsm ls <id> --json` adds the files.
cmd_list() {
  local spec="${1:-}" id rows="" json=false detail="" f note status
  ROWS=""
  [[ -z "$spec" ]] || _spec_ok "$spec"
  anfs_json_on && json=true
  _spaces_load
  _root_load
  local -a srcs=()
  if [[ -n "$spec" ]]; then
    _spec_parse "$spec"
    [[ -z "$SP_SRC" ]] || srcs=("$SP_SRC")
  fi
  [[ -z "$spec" || ${#srcs[@]} -gt 0 ]] || fail "$EX_NOTFOUND" "nothing defined under $spec"
  _state_load true ${srcs[@]+"${srcs[@]}"}
  # Every installed space's links: in one yq
  local -a inst=()
  for id in ${SPACE_IDS[@]+"${SPACE_IDS[@]}"}; do [[ -z "${INSTALLED[$id]:-}" ]] || inst+=("$id"); done
  _meta_load ${inst[@]+"${inst[@]}"}

  for id in ${SPACE_IDS[@]+"${SPACE_IDS[@]}"}; do
    [[ -z "$spec" ]] || _spec_match "$id" || continue
    [[ -z "$spec" ]] || $SP_PREFIX || detail="$id"
    # a refused manifest (links:, files:): invalid, its first error the note
    _mf_plan "$id"
    if [[ -n "${MF_ERR[$id]:-}" ]]; then
      note="${MF_ERR[$id]%%$'\n'*}"
      if [[ -n "${INSTALLED[$id]:-}" ]]; then _home_of "$id"; else REPLY=""; fi
      _row "$id" invalid "$REPLY" "$note" "" "" "" ""
      continue
    fi
    if [[ -z "${INSTALLED[$id]:-}" ]]; then
      _row "$id" "" "" "" "" "" "" ""
      continue
    fi
    _space_counts "$id"
    note="$REPLY"
    _home_of "$id"
    if [[ -z "$note" ]]; then status=ok; else status=partial; fi
    _row "$id" "$status" "$REPLY" "$note" "$C_MISSING" "$C_WRONG" "$C_WAY" "$C_LEFT"
  done
  for id in ${VANISHED_IDS[@]+"${VANISHED_IDS[@]}"}; do
    [[ -z "$spec" ]] || _spec_match_path "${VANISHED_SRC[$id]}" "${VANISHED_PATH[$id]}" || continue
    _home_of "$id"
    _row "$id" "not in the source" "$REPLY" "" "" "" "" ""
  done
  rows="$ROWS"
  [[ -n "$rows" || -z "$spec" ]] || fail "$EX_NOTFOUND" "nothing defined under $spec"

  # The lists other tools read: with --json (lib/anfs/table.sh), never by column. The counts are
  # --json only; NOTE is their summary.
  local out keys="space status dir note missing wrong in_the_way leftover"
  if ! $json || [[ -z "$detail" ]]; then
    printf '%s' "$rows" | anfs_table "SPACE STATUS DIR NOTE" "$keys"
    return 0
  fi
  out=$(printf '%s' "$rows" | anfs_table "SPACE STATUS DIR NOTE" "$keys")
  # One space by its id: its files and their states, relative to it
  local p="${SPACE_PATH[$detail]}" src="${SPACE_SRC[$detail]}" files="" sep=""
  _files_of "$detail"
  for f in ${FILES[@]+"${FILES[@]}"}; do
    _json "$f"; files+="$sep{\"file\":$REPLY"
    _json "${FSTATE["$src|${p:+$p/}$f"]:-missing}"; files+=",\"status\":$REPLY}"
    sep=,
  done
  _leftovers_of "$detail"
  for f in ${LEFT[@]+"${LEFT[@]}"}; do
    _json "${f#"${p:+$p/}"}"; files+="$sep{\"file\":$REPLY,\"status\":\"leftover\"}"
    sep=,
  done
  # Its links out of the tree and its copies (an installed space's): dest, src, state; path, state
  local links="" copies="" i line
  sep=""
  if [[ -n "${INSTALLED[$detail]:-}" ]]; then
    _links_eval "$detail"
    for i in ${LK_DEST[@]+"${!LK_DEST[@]}"}; do
      _json "${LK_DEST[$i]}"; links+="$sep{\"dest\":$REPLY"
      _json "${LK_SRC[$i]}"; links+=",\"src\":$REPLY"
      _json "${LK_STATE[$i]}"; links+=",\"status\":$REPLY}"
      sep=,
    done
    sep=""
    _copies_plan "$detail"
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      f="${line#*$'\t'}" f="${f%%$'\t'*}"
      _json "$f"; copies+="$sep{\"path\":$REPLY"
      _json "${line%%$'\t'*}"; copies+=",\"status\":$REPLY}"
      sep=,
    done <<< "$CP_LINES"
  fi
  printf '%s,"files":[%s],"links":[%s],"copies":[%s]}]\n' "${out%\}]}" "$files" "$links" "$copies"
}

# `wsm repo ls [SPEC]`: the repositories the space.yml files under SPEC declare, and their state
cmd_repo_list() {
  local spec="${1:-}" id url path ref state ahead d
  ROWS=""
  [[ -z "$spec" ]] || _spec_ok "$spec"
  _require_yq
  _spaces_load
  _root_load
  [[ -z "$spec" ]] || _spec_parse "$spec"
  _state_load false
  for id in ${SPACE_IDS[@]+"${SPACE_IDS[@]}"}; do
    [[ -z "$spec" ]] || _spec_match "$id" || continue
    while IFS= read -r url && IFS= read -r path && IFS= read -r ref; do
      ahead="" d=""
      if [[ -z "$path" ]]; then
        state="no path"
      elif _repo_invalid "$id" "$path" && [[ -n "$REPLY" ]]; then
        state=invalid
      elif [[ -z "${INSTALLED[$id]:-}" ]]; then
        state="not installed"
      else
        _home_of "$id"
        d="$REPLY/$path"
        state=$(anfs_repo_status "$d")
        [[ "$state" != local ]] || state="not a repo"
        ahead=$(anfs_repo_ahead "$d")
      fi
      _row "$id/$path" "$state" "$url" "$ahead" "$id" "$path" "$d"
    done < <(_repo_entries "${SPACE_DIR[$id]}/space.yml")
  done
  printf '%s' "$ROWS" | anfs_table "REPOSITORY STATUS URL" "repository status url ahead space path dir"
}

# `wsm repo install [SPEC|REPOSITORY] [-n]`: the clone half of install, for the spaces already
# installed; a repository's id clones that one
cmd_repo_install() {
  local dry=${CLI_OPT[dry-run]:-false} arg="${1:-}" id failed=0 any=false url path ref found=false
  _require_yq
  _spaces_load
  _root_load
  _state_load false
  [[ -z "$arg" ]] || _spec_ok "$arg"
  if [[ -n "$arg" ]]; then
    _spec_parse "$arg"
    for id in ${SPACE_IDS[@]+"${SPACE_IDS[@]}"}; do _spec_match "$id" && { any=true; break; }; done
  fi
  # A repository: the longest prefix that is a space, and the rest a path it declares
  if [[ -n "$arg" ]] && ! $any && _repo_split "$arg"; then
    while IFS= read -r url && IFS= read -r path && IFS= read -r ref; do
      [[ "$path" == "$REPO_PATH" ]] && found=true
    done < <(_repo_entries "${SPACE_DIR[$REPO_SPACE]}/space.yml")
    $found || fail "$EX_NOTFOUND" "$REPO_SPACE declares no repository $REPO_PATH (wsm repo ls $REPO_SPACE)"
    [[ -n "${INSTALLED[$REPO_SPACE]:-}" ]] ||
      fail "$EX_NOTFOUND" "$REPO_SPACE is not installed: wsm install $REPO_SPACE clones its repositories"
    _space_repositories "$REPO_SPACE" "$dry" "$REPO_PATH"
    return
  fi
  [[ -z "$arg" ]] || $any || fail "$EX_NOTFOUND" "no space or repository '$arg' (wsm ls, wsm repo ls)"
  for id in ${SPACE_IDS[@]+"${SPACE_IDS[@]}"}; do
    [[ -n "${INSTALLED[$id]:-}" ]] || continue
    [[ -z "$arg" ]] || _spec_match "$id" || continue
    echo "$id"
    _space_repositories "$id" "$dry" || failed=$((failed + 1))
  done
  [[ $failed -eq 0 ]]
}

# `wsm repo ssh [SPEC]`: as `anfs src ssh`, the origin of each clone under SPEC from GitHub https
# to ssh. space.yml is the source's and is not edited: an https URL in it is only noted.
cmd_repo_ssh() {
  local spec="${1:-}" id url path ref rid new noted any=false
  [[ -z "$spec" ]] || _spec_ok "$spec"
  _require_yq
  _spaces_load
  _root_load
  [[ -z "$spec" ]] || _spec_parse "$spec"
  _state_load false
  for id in ${SPACE_IDS[@]+"${SPACE_IDS[@]}"}; do
    [[ -z "$spec" ]] || _spec_match "$id" || continue
    any=true
    while IFS= read -r url && IFS= read -r path && IFS= read -r ref; do
      [[ -n "$path" ]] || continue
      _repo_invalid "$id" "$path"
      [[ -z "$REPLY" ]] || continue
      rid="$id/$path" noted=false
      if [[ "$url" == https://github.com/* ]]; then
        echo "$rid: https in space.yml"
        noted=true
      fi
      [[ -n "${INSTALLED[$id]:-}" ]] || continue
      _home_of "$id"
      [[ -d "$REPLY/$path/.git" ]] || continue
      if new=$(anfs_repo_ssh "$REPLY/$path"); then
        echo "$rid: origin -> $new"
      elif ! $noted; then
        echo "$rid: already SSH"
      fi
    done < <(_repo_entries "${SPACE_DIR[$id]}/space.yml")
  done
  [[ -z "$spec" ]] || $any || fail "$EX_NOTFOUND" "no space '$spec' (wsm ls)"
}

# `wsm repo push [SPEC|REPOSITORY...] [--all] [-n]`: every repository the spaces declare (a valid
# path), named as repo list names it, and its clone (none while its space is not installed), for
# lib/anfs/repo.sh's push command. An argument is a repository by that name, else a spec as repo
# list resolves it: its repositories in list order, those cloned on a branch with an upstream
# (pushed when ahead, up to date when not; the rest are passed over, as --all passes them over).
cmd_repo_push() {
  local id url path ref arg i rid n kids
  local -a sp=() names=() hit=()
  local -A seen=()
  _require_yq
  _spaces_load
  _root_load
  _state_load false
  ANFS_PUSH_IDS=() ANFS_PUSH_DIRS=()
  for id in ${SPACE_IDS[@]+"${SPACE_IDS[@]}"}; do
    while IFS= read -r url && IFS= read -r path && IFS= read -r ref; do
      [[ -n "$path" ]] || continue
      _repo_invalid "$id" "$path"
      [[ -z "$REPLY" ]] || continue
      ANFS_PUSH_IDS+=("$id/$path") sp+=("$id")
      if [[ -n "${INSTALLED[$id]:-}" ]]; then _home_of "$id"; ANFS_PUSH_DIRS+=("$REPLY/$path")
      else ANFS_PUSH_DIRS+=("")
      fi
    done < <(_repo_entries "${SPACE_DIR[$id]}/space.yml")
  done
  [[ $# -eq 0 ]] || ! ${CLI_OPT[all]:-false} || cli_usage_err "names or --all, not both"
  for arg in "$@"; do
    # An exact repository name wins; neither a repository nor a space: the helper's error
    rid=""
    for i in "${!ANFS_PUSH_IDS[@]}"; do [[ "${ANFS_PUSH_IDS[$i]}" != "$arg" ]] || { rid="$arg"; break; }; done
    if [[ -n "$rid" ]] || ! _valid_spec "$arg"; then
      [[ -n "${seen[$arg]:-}" ]] || { seen[$arg]=1; names+=("$arg"); }
      continue
    fi
    _spec_parse "$arg"
    hit=()
    for id in ${SPACE_IDS[@]+"${SPACE_IDS[@]}"}; do _spec_match "$id" && hit+=("$id"); done
    if [[ ${#hit[@]} -eq 0 ]]; then
      [[ -n "${seen[$arg]:-}" ]] || { seen[$arg]=1; names+=("$arg"); }
      continue
    fi
    n=0
    for i in "${!ANFS_PUSH_IDS[@]}"; do
      [[ " ${hit[*]} " == *" ${sp[$i]} "* ]] || continue
      n=$((n + 1))
      [[ -n "${ANFS_PUSH_DIRS[$i]}" ]] || continue
      git -C "${ANFS_PUSH_DIRS[$i]}" rev-parse -q --abbrev-ref '@{upstream}' >/dev/null 2>&1 || continue
      rid="${ANFS_PUSH_IDS[$i]}"
      [[ -n "${seen[$rid]:-}" ]] || { seen[$rid]=1; names+=("$rid"); }
    done
    (( n == 0 )) || continue
    if ! $SP_PREFIX; then
      # A bare id whose space has none, but whose children do: the prefix was meant
      SP_PREFIX=true kids=false
      for i in "${!ANFS_PUSH_IDS[@]}"; do _spec_match "${sp[$i]}" && { kids=true; break; }; done
      ! $kids || fail 1 "no repositories in space '$arg'; did you mean $arg/?"
      fail 1 "no repositories in space '$arg' (wsm repo ls $arg/)"
    fi
    fail 1 "no repositories in the spaces under '$arg' (wsm repo ls $arg)"
  done
  # Only specs, and none of their repositories can be pushed (not cloned, no upstream)
  if [[ $# -gt 0 && ${#names[@]} -eq 0 ]]; then
    if anfs_json_on; then echo '[]'; else echo "Nothing to push: no repository under $* is cloned with an upstream"; fi
    return 0
  fi
  anfs_repo_push_cli repository "wsm repo ls" ${names[@]+"${names[@]}"}
}

# `wsm new SPACE`: SOURCE/PATH anywhere, or a PATH below where you are (in the tree, or in a source
# checkout: below its spaces/). The space is created in the source, and installed when the space
# around it is.
cmd_new() {
  local u="wsm new [SOURCE/]PATH" spec="$1" src="" path here srcdir dir id enc
  [[ "$spec" != */ ]] && _valid_spec "$spec" || usage_err "$u"
  _spaces_load
  _root_load
  gitsrc_collect

  if _is_registered "${spec%%/*}"; then
    src="${spec%%/*}" path=""
    [[ "$spec" != */* ]] || path="${spec#*/}"
  else
    here=$(_canon "$PWD") || here="$PWD"
    _context "$here" ||
      fail "$EX_NOTFOUND" "not inside a source or the spaces tree: wsm new SOURCE/PATH"
    src="$CTX_SRC" path="$spec"
    ! $CTX_SPACES || [[ -z "$CTX_REL" ]] || path="$CTX_REL/$spec"
  fi

  srcdir=$(gitsrc_dir "$src")
  [[ -d "$srcdir" ]] || fail "$EX_NOTFOUND" "source '$src' is not cloned (anfs src update)"
  dir="$srcdir/spaces${path:+/$path}"
  id="$src${path:+/$path}"
  [[ ! -e "$dir/space.yml" ]] || fail "$EX_EXISTS" "already a space: $id ($(_display "$dir"))"
  mkdir -p -- "$dir"
  cat > "$dir/space.yml" <<EOF
# $id: \`wsm install $id\` links this directory's files into \$WSM_SPACES_HOME/$id
#depends: [other]          # spaces installed first: an id (<source>/<path>), or a path in this source
repositories: []
#  - url: git@github.com:you/thing
#    path: repos/thing     # optional: git's name for it
#    ref: main             # optional
#skills:                   # installed into this space's directory (wsm skill), for this space only
#  - repo: owner/repo      # owner/repo, a URL or a path, as the skills CLI takes it
#    skills: [a-skill]     # optional: every skill in it when left out
#  - repo: ./skills        # relative: from this space.yml in the source
#links:                    # how this space's files are linked (each file on its own by default)
#  - docs/                 # a directory as one link
#  - {path: notes.md, platforms: [macos]}   # only on those platforms (macos, linux, debian, fedora)
#  - src: ~/somewhere      # a link out of the tree: ~ and \$VAR expanded; relative: from the space's directory
#    dest: somewhere       # optional: src's basename; must stay inside the space
#files:                    # copied when missing, then yours: never overwritten, left by remove
#  - local.conf
EOF
  printf 'created %s\n' "$(_display "$dir/space.yml")"

  # The space around it, as loaded before this one existed
  enc=""
  if [[ -n "$path" ]] && [[ -n "${SRC_SD[$src]:-}" ]]; then
    _state_load false "$src"
    local p="$path"
    if [[ "$p" == */* ]]; then p="${p%/*}"; else p=""; fi
    _space_of "$src" "$p" true && enc="$REPLY"
  fi
  if [[ -n "$enc" ]]; then
    _spaces_reset
    cmd_install "$id"
  else
    echo "next: wsm install $id"
  fi
  echo "commit it in $(_display "$srcdir")"
}

# Plain files under <dir>, as paths: not links (wsm's, or the user's own), not inside a git repo
# (a clone), not .DS_Store
_walk_local() {
  local e
  for e in "$1"/* "$1"/.[!.]* "$1"/..?*; do
    if [[ -L "$e" ]]; then
      continue
    elif [[ -d "$e" ]]; then
      [[ -e "$e/.git" ]] || _walk_local "$e"
    elif [[ -f "$e" ]]; then
      [[ "${e##*/}" == .DS_Store ]] || printf '%s\n' "$e"
    fi
  done
}

# Move one file of the tree into its source and link it back (relative, to the canonical file:
# anfs_link_one), so the next install sees it as linked. <explicit> is false when it was found
# under a directory given to add, which skips quietly what an explicit file would be refused for,
# and leaves a copy of a source file alone.
# Usage: _add_one <canonical path> <explicit:true|false>
ADDED_SRCS=()
_add_one() {
  local path="$1" explicit="$2" src rel srcdir dest d id sub
  if ! _context "$path" || [[ "$CTX_KIND" != tree ]]; then
    if [[ "$CTX_KIND" == source ]]; then warn "already in the source $CTX_SRC: $(_display "$path")"
    else warn "not in the spaces tree: $(_display "$path")"; fi
    return 1
  fi
  src="$CTX_SRC" rel="$CTX_REL"
  if [[ -L "$path" ]]; then
    $explicit && warn "a link, not added: $(_display "$path")"
    return 0
  fi
  if [[ ! -f "$path" ]]; then
    warn "not a file: $(_display "$path")"
    return 1
  fi
  [[ "${path##*/}" != .DS_Store ]] || return 0

  # Never part of a clone
  d=$(dirname -- "$path")
  while [[ "$d" == "$ROOT/$src"/* ]]; do
    if [[ -e "$d/.git" ]]; then
      $explicit && warn "inside a git repo, not added: $(_display "$path")"
      $explicit && return 1 || return 0
    fi
    d=$(dirname -- "$d")
  done

  d=""
  [[ "$rel" != */* ]] || d="${rel%/*}"
  if ! _space_of "$src" "$d"; then
    warn "not in any space of $src, not added: $(_display "$path")"
    return 1
  fi
  id="$REPLY"
  sub="${rel#"${SPACE_PATH[$id]:+${SPACE_PATH[$id]}/}"}"
  if _written_by_skills "$id" "$sub"; then
    $explicit && warn "written by the skills CLI (wsm skill), not added: $(_display "$path")"
    $explicit && return 1 || return 0
  fi
  if _in_repository "$id" "$sub"; then
    $explicit && warn "inside a repository of $id, not added: $(_display "$path")"
    $explicit && return 1 || return 0
  fi
  if [[ -z "${INSTALLED[$id]:-}" ]]; then
    warn "$id is not installed: $(_display "$path")"
    return 1
  fi
  srcdir=$(gitsrc_dir "$src")
  if git -C "$srcdir" check-ignore -q -- "spaces/$rel" 2>/dev/null; then
    $explicit && warn "ignored by $src's .gitignore, not added: $(_display "$path")"
    $explicit && return 1 || return 0
  fi

  dest="${SRC_SD[$src]}/$rel"
  if [[ -e "$dest" || -L "$dest" ]]; then
    # A copy where the source has the file (some tools save by renaming over the link): named
    # explicitly, the copy goes back to the source, where git shows what changed
    if $explicit; then
      mv -f -- "$path" "$dest"
      anfs_link_one "$dest" "$path"
      printf 'updated %s (git diff in %s)\n' "$src/$rel" "$(_display "$srcdir")"
      _in_list "$src" ${ADDED_SRCS[@]+"${ADDED_SRCS[@]}"} || ADDED_SRCS+=("$src")
      return 0
    fi
    warn "a copy where $src has the file: wsm add $(_display "$path") puts it in the source"
    return 0
  fi

  mkdir -p -- "$(dirname -- "$dest")"
  mv -- "$path" "$dest"
  anfs_link_one "$dest" "$path"
  printf 'added %s\n' "$src/$rel"
  _in_list "$src" ${ADDED_SRCS[@]+"${ADDED_SRCS[@]}"} || ADDED_SRCS+=("$src")
}

# Whether <rel> (below space <id>) is what the skills CLI wrote there: its skills-lock.json, or a
# file of a skill that lock names, in .agents/skills/<name>/ or an agent's <.dir>[/sub]/skills/<name>/
declare -A LOCK_NAMES=()
_written_by_skills() {
  local id="$1" rel="$2" n src pre name
  [[ "$rel" != skills-lock.json ]] || return 0
  [[ "$rel" == .*/skills/* ]] || return 1
  if [[ -z "${LOCK_NAMES[$id]+x}" ]]; then
    _home_of "$id"
    LOCK_NAMES[$id]=$'\n'
    while IFS="$ANFS_US" read -r n src; do
      [[ -z "$n" ]] || LOCK_NAMES[$id]+="$n"$'\n'
    done < <(_skill_lock "$REPLY")
  fi
  pre="${rel%%/skills/*}" name="${rel#*/skills/}" name="${name%%/*}"
  # One or two directories above skills/, the first hidden: .agents, .claude, .pi/agent
  [[ "$pre" == .* && "$pre" != */*/* ]] || return 1
  [[ "${LOCK_NAMES[$id]}" == *$'\n'"$name"$'\n'* ]]
}

cmd_add() {
  local arg p rc=0 f
  _require_yq
  _spaces_load
  _root_load
  _state_load false
  ADDED_SRCS=()
  for arg in "$@"; do
    if [[ ! -e "$arg" && ! -L "$arg" ]]; then
      warn "no such file: $arg"
      rc=1
      continue
    fi
    p=$(_canon_file "$arg") || { warn "cannot resolve $arg"; rc=1; continue; }
    if [[ -d "$p" && ! -L "$arg" ]]; then
      if [[ -e "$p/.git" ]]; then
        warn "a git repo, not added: $(_display "$p")"
        rc=1
        continue
      fi
      while IFS= read -r f; do
        _add_one "$f" false || rc=1
      done < <(_walk_local "$p")
    else
      _add_one "$p" true || rc=1
    fi
  done
  for f in ${ADDED_SRCS[@]+"${ADDED_SRCS[@]}"}; do
    echo "commit it in $(_display "$(gitsrc_dir "$f")")"
  done
  return "$rc"
}

# --- skill --------------------------------------------------------------------------------

# The spaces under SPEC (all when none), into SEL: each a space id; a SPEC naming no space is 1
SEL=()
_skill_select() {
  local spec="${1:-}" id
  SEL=()
  [[ -z "$spec" ]] || _spec_parse "$spec"
  for id in ${SPACE_IDS[@]+"${SPACE_IDS[@]}"}; do
    [[ -z "$spec" ]] || _spec_match "$id" || continue
    SEL+=("$id")
  done
  [[ -z "$spec" || ${#SEL[@]} -gt 0 ]] || fail "$EX_NOTFOUND" "no space matches '$spec' (wsm ls)"
}

# `wsm skill ls [SPEC]`: every skill the spaces under SPEC declare, and its state in the space's
# directory: ok, partial, missing, waiting (no agent yet), * (a whole remote repo); null when the
# space is not installed. One `skills list` per installed space that declares any.
cmd_skill_list() {
  local spec="${1:-}" id row repo names n st
  local -a list=()
  ROWS=""
  [[ -z "$spec" ]] || _spec_ok "$spec"
  _require_yq
  _spaces_load
  _root_load
  _state_load false
  _skill_select "$spec"
  _meta_load ${SEL[@]+"${SEL[@]}"}
  for id in ${SEL[@]+"${SEL[@]}"}; do
    _skill_rows "$id"
    [[ ${#SK_ROWS[@]} -gt 0 ]] || continue
    if [[ -n "${INSTALLED[$id]:-}" ]]; then
      _agents
      if [[ -n "$AGENTS" ]]; then
        _npx_ok || exit "$EX_UNAVAIL"
        _home_of "$id"
        _home_ok "$REPLY" || exit "$EX_NOTFOUND"
        anfs_skill_load "$REPLY"
      fi
    fi
    for row in "${SK_ROWS[@]}"; do
      repo="${row#*|}" repo="${repo%%|*}" names="${row#*|*|}" names="${names%|}"
      IFS=',' read -r -a list <<< "$names"
      for n in "${list[@]}"; do
        if [[ -z "${INSTALLED[$id]:-}" ]]; then st=""
        elif [[ -z "$AGENTS" ]]; then st=waiting
        elif [[ "$n" == '*' ]]; then st='*'
        else st=$(anfs_skill_status "$n" "$AGENTS"); fi
        _row "$id/$n" "$st" "$repo" "$id" "$n"
      done
    done
  done
  printf '%s' "$ROWS" | anfs_table "SKILL STATUS REPO" "skill status repo space name"
}

# `wsm skill install [SPEC] [-n]`: the skills half of install, for the spaces already installed
cmd_skill_install() {
  local dry=${CLI_OPT[dry-run]:-false} spec="${1:-}" id failed=0
  [[ -z "$spec" ]] || _spec_ok "$spec"
  _require_yq
  _spaces_load
  _root_load
  _state_load false
  _skill_select "$spec"
  _meta_load ${SEL[@]+"${SEL[@]}"}
  for id in ${SEL[@]+"${SEL[@]}"}; do
    [[ -n "${INSTALLED[$id]:-}" && -n "${META_SKILLS[$id]:-}" ]] || continue
    echo "$id"
    _space_skills "$id" "$dry" || failed=$((failed + 1))
  done
  [[ $failed -eq 0 ]]
}

# `wsm skill rm SPEC...`: a space (or a prefix) loses every skill it declares; <space id>/<name>
# only that one, which it must declare
cmd_skill_remove() {
  local arg id n any rc=0
  local -a ids=() what=()
  local -A only=()
  _require_yq
  _spaces_load
  _root_load
  _state_load false
  for arg in "$@"; do
    _spec_ok "$arg"
    _spec_parse "$arg"
    any=false
    for id in ${SPACE_IDS[@]+"${SPACE_IDS[@]}"}; do
      _spec_match "$id" || continue
      any=true
      [[ -n "${INSTALLED[$id]:-}" ]] || continue
      _in_list "$id" ${ids[@]+"${ids[@]}"} || ids+=("$id")
      only[$id]="*"
    done
    $any && continue
    if _repo_split "${arg%/}" && [[ "$REPO_PATH" != */* ]]; then
      _skill_names "$REPO_SPACE"
      if ! _in_list "$REPO_PATH" ${SK_NAMES[@]+"${SK_NAMES[@]}"}; then
        warn "$REPO_SPACE declares no skill $REPO_PATH (wsm skill ls $REPO_SPACE)"
        rc=$EX_NOTFOUND
        continue
      fi
      if [[ -z "${INSTALLED[$REPO_SPACE]:-}" ]]; then
        warn "not installed: $REPO_SPACE"
        rc=$EX_NOTFOUND
        continue
      fi
      _in_list "$REPO_SPACE" ${ids[@]+"${ids[@]}"} || ids+=("$REPO_SPACE")
      [[ "${only[$REPO_SPACE]:-}" == "*" ]] || only[$REPO_SPACE]+="$REPO_PATH"$'\n'
      continue
    fi
    warn "no space or skill '$arg' (wsm ls, wsm skill ls)"
    rc=$EX_NOTFOUND
  done
  [[ ${#ids[@]} -gt 0 ]] || return "$rc"
  for id in "${ids[@]}"; do
    if [[ "${only[$id]}" == "*" ]]; then what+=("$id (every skill it declares)")
    else what+=("$id: $(printf '%s' "${only[$id]}" | paste -sd' ' -)"); fi
  done
  anfs_confirm "skill remove takes from their spaces: ${what[*]}" "Remove them?"
  _meta_load "${ids[@]}"
  for id in "${ids[@]}"; do
    if [[ "${only[$id]}" == "*" ]]; then
      _remove_skills "$id" || rc=1
    else
      local -a names=()
      mapfile -t names <<< "${only[$id]%$'\n'}"
      _remove_skills "$id" "${names[@]}" || rc=1
    fi
  done
  return "$rc"
}

# Plumbing for wsm's ppm callback (install.sh): agent <id>s were removed and no installed package
# declares them any more, so each installed space's declared skills are unlinked from them (the
# others keep them). Not in help or completion.
cmd___agents_rm() {
  local id agent display n home rc=0
  local -a names=()
  _spaces_load
  _root_load
  _state_load false
  local -a inst=()
  for id in ${SPACE_IDS[@]+"${SPACE_IDS[@]}"}; do [[ -z "${INSTALLED[$id]:-}" ]] || inst+=("$id"); done
  _meta_load ${inst[@]+"${inst[@]}"}
  for id in ${inst[@]+"${inst[@]}"}; do
    [[ -n "${META_SKILLS[$id]:-}" ]] || continue
    _skill_names "$id"
    [[ ${#SK_NAMES[@]} -gt 0 ]] || continue
    _home_of "$id"
    home="$REPLY"
    _home_ok "$home" || continue
    _npx_ok || return 0
    anfs_skill_load "$home"
    for agent in "$@"; do
      display=$(anfs_skill_display "$agent") || { warn "unknown agent '$agent'"; continue; }
      names=()
      for n in "${SK_NAMES[@]}"; do
        local have
        have=$(anfs_skill_installed_agents "$n") || continue
        [[ ",$have," == *",$display,"* ]] && names+=("$n")
      done
      [[ ${#names[@]} -gt 0 ]] || continue
      echo "unlink $agent in $id: ${names[*]}"
      anfs_skill_unlink "$home" "$agent" "${names[@]}" >/dev/null || { warn "skills remove for $agent in $id failed"; rc=1; }
    done
  done
  return "$rc"
}

# What cli.sh asks for on a tab press (complete_<kind>): one candidate per line, quickly. They
# read file names only, from one find over the sources' spaces/: no yq, no git, no check.

# Every space id, and every prefix with spaces at or under it (source/, source/a/)
complete_spec() {
  local f rel src p
  local -A seen=()
  while IFS= read -r f; do
    rel="${f#"$ANFS_SOURCES_HOME"/}" rel="${rel//\/\//\/}"
    src="${rel%%/*}" p="${rel#*/spaces/}" p="${p%space.yml}" p="${p%/}"
    printf '%s\n' "$src${p:+/$p}"
    while :; do
      [[ -n "${seen["$src/$p"]:-}" ]] || { seen["$src/$p"]=1; printf '%s/\n' "$src${p:+/$p}"; }
      [[ -n "$p" ]] || break
      if [[ "$p" == */* ]]; then p="${p%/*}"; else p=""; fi
    done
  done < <(find "$ANFS_SOURCES_HOME"/*/spaces/ -name space.yml 2>/dev/null)
}
# The installed spaces: those whose space.yml under the root is a link
complete_space() {
  local id root src p
  root=$(_spaces_home)
  while IFS= read -r id; do
    [[ "$id" != */ ]] || continue
    [[ -L "$root/$id/space.yml" ]] && printf '%s\n' "$id"
  done < <(complete_spec)
}
# The clones in the installed spaces (repo push), as <space id>/<path>: a <path>/.git up to three
# levels below the space's directory, no part of <path> a link (a links: entry out of the tree is
# not the space's clone). A clone in a child space is the same id from either.
complete_repository() {
  local id root g p q
  root=$(_spaces_home)
  while IFS= read -r id; do
    for g in "$root/$id"/*/.git "$root/$id"/*/*/.git "$root/$id"/*/*/*/.git; do
      [[ -e "$g" ]] || continue
      p="${g%/.git}" p="${p#"$root/$id/"}" q="$p"
      while [[ -n "$q" && ! -L "$root/$id/$q" ]]; do
        if [[ "$q" == */* ]]; then q="${q%/*}"; else q=""; fi
      done
      [[ -n "$q" ]] || printf '%s/%s\n' "$id" "$p"
    done
  done < <(complete_space) | awk '!seen[$0]++'
}
# What repo push takes: the clones (complete_repository), the installed spaces, and the prefixes
# above them (cnfs/, cnfs/apps/)
complete_spec_or_repository() {
  local id p
  complete_repository
  while IFS= read -r id; do
    printf '%s\n' "$id"
    p="$id"
    while [[ "$p" == */* ]]; do p="${p%/*}"; printf '%s/\n' "$p"; done
  done < <(complete_space) | awk '!seen[$0]++'
}
# The sources (move's destination)
complete_source() { gitsrc_collect 2>/dev/null; printf '%s\n' ${GITSRC_NAMES[@]+"${GITSRC_NAMES[@]}"}; }
# What cd and path take: an installed space by id, or by its last segment
complete_query() {
  local id
  while IFS= read -r id; do
    printf '%s\n' "$id"
    [[ "$id" != */* ]] || printf '%s\n' "${id##*/}"
  done < <(complete_space) | awk '!seen[$0]++'
}

# `wsm implode [-y]`: unlink every installed space (and those no longer in their source) and delete
# wsm's state, the backups -f made included. What the spaces hold besides the links (cloned repos,
# your files) is never touched.
cmd_implode() {
  local yes=${CLI_OPT[yes]:-false} id
  local -a all=() order=()
  _spaces_load
  _root_load
  _state_load true
  for id in ${SPACE_IDS[@]+"${SPACE_IDS[@]}"}; do [[ -z "${INSTALLED[$id]:-}" ]] || all+=("$id"); done
  all+=(${VANISHED_IDS[@]+"${VANISHED_IDS[@]}"})
  {
    echo "wsm implode removes:"
    for id in ${all[@]+"${all[@]}"}; do
      echo "  links        $id in $(_display "$(_space_home "$id")")"
    done
    echo "  state        $(_display "$WSM_STATE_HOME") (the backups install -f made included)"
    echo "Kept: everything else in the spaces (cloned repos, your files)"
  } >&2

  $yes || anfs_confirm "implode unlinks every space" "Implode wsm?"

  mapfile -t order < <(for id in ${all[@]+"${all[@]}"}; do printf '%s\t%s\n' "${#id}" "$id"; done | sort -rn | cut -f2-)
  for id in ${order[@]+"${order[@]}"}; do
    [[ -n "$id" ]] || continue
    if [[ -n "${VANISHED_SRC[$id]:-}" ]]; then _remove_vanished "$id"; else _remove_space "$id"; fi
    WSM_EV_REMOVED+=("$id")
  done
  rm -rf -- "${WSM_STATE_HOME:?}"
  echo "wsm imploded" >&2
}

# --- Dispatch -----------------------------------------------------------------------------

cli_dispatch "$@"
