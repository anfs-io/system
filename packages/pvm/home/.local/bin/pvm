#!/usr/bin/env bash
# pvm — Personal Vault Manager
#
# A vault is a directory of markdown documents with a pvm.yml at its root: an Obsidian vault, a
# plain tree, a git repo of docs. Vaults can live anywhere, so pvm never assumes where: pvm.yml
# is the marker and carries the vault's id, and a registry ($PVM_STATE_HOME/vaults) indexes the
# vaults this machine knows. The marker is the source of truth; the registry is a cache that
# `pvm scan` rebuilds, and a vault found at a new path is the same vault, moved.
#
# pvm does three things with a vault:
#
#   links      pvm.yml maps vault directories to wsm levels (source, source/ws, source/ws/space).
#              pvm puts a symlink in the level's directory pointing back into the vault, so the
#              documentation sits next to the code it describes. Knowledge of the links is the
#              vault's; the symlinks are machine-local and `pvm link apply` recreates them. wsm
#              tells pvm when a level is installed or removed (lib/anfs/callbacks.sh; this
#              package's install.sh registers), without knowing pvm exists.
#   documents  every document has frontmatter with a stable `id`, so it can be found whatever
#              its path becomes: `pvm docs`, `pvm path ID`, `pvm show ID`.
#   validate   documents are checked against the vault's `profile` (required keys, allowed
#              types). OKF itself only requires `type`; the profile is the real schema.
#
# Every command takes --json. Exit codes follow wsm: 1 not found, 2 ambiguous, 3 stale,
# 64 usage, 69 unavailable, 73 exists, 75 lock.
set -euo pipefail

PVM_VERSION=0.1.0

# Paths, messages, the log and the command line come from anfs
ANFS_LIB="$HOME/.local/lib/anfs"
if [[ ! -f "$ANFS_LIB/bash.sh" || ! -f "$ANFS_LIB/table.sh" ]]; then
  echo "pvm: $ANFS_LIB is missing or out of date; install core/anfs again" >&2
  exit 69
fi
# The bash floor, first: re-execs under bash 5 when this is macOS's 3.2
# shellcheck source=/dev/null
source "$ANFS_LIB/bash.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/paths.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/log.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/cli.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/table.sh"

anfs_tool_paths pvm
PVM_REGISTRY="$PVM_STATE_HOME/vaults"
PVM_LOCK="$PVM_STATE_HOME/vaults.lock"
# The symlinks pvm made: what `remove` events and `link validate` work from
PVM_LINKS="$PVM_STATE_HOME/links"
PVM_CONFIG=pvm.yml
PVM_HOME=$(cd "$HOME" && pwd -P)

EX_NOTFOUND=1 EX_AMBIGUOUS=2 EX_STALE=3
EX_USAGE=64 EX_UNAVAIL=69 EX_EXISTS=73 EX_LOCK=75

CLI_TOOL=pvm
CLI_EX_USAGE=$EX_USAGE

# Ids, of vaults and of documents: 10 characters of lowercase base32. Short enough to type and to
# sit inside a firstmate task id, and nothing in them needs quoting anywhere.
ID_RE='^[a-z2-7]{10}$'
# Rows passed between functions use anfs's field separator (lib/anfs/table.sh): unlike a tab,
# bash's `read` does not fold empty fields away around it
US="$ANFS_US"

CLI_VERSION="$PVM_VERSION"
cli_cmd init "Make a directory (default .) a vault: write pvm.yml, mint its id, register it" \
  --opt "--name NAME: The vault's name (default: the directory's)" --arg "[dir]"
cli_cmd new "Create a directory and init it" \
  --opt "--name NAME: The vault's name (default: the directory's)" --arg "dir"
cli_cmd list "The vaults this machine knows" --alias ls \
  --opt "--stale: Only the ones that are gone or changed id"
cli_cmd scan "Find pvm.yml under the directories (default ~) and register what is found" --arg "[dir...]"
cli_cmd remove "Drop a vault from the registry; its files are untouched" --alias rm --arg "vault"
cli_cmd prune "Drop every stale registry entry" --opt "-n --dry-run: Say what would be dropped"
cli_cmd path "Print the path of a vault (default: the one you are in) or of a document" --arg "[vault-or-doc]"
cli_cmd docs "List documents: id, type, title, space, path" \
  --opt "--type TYPE: Only that type" --opt "--space SPEC: Only the documents of that wsm level" --arg "[dir]"
cli_cmd show "Print a document by id" --opt "--body: Leave out the frontmatter" --arg "doc"
cli_group link "Vault directories linked into wsm levels"
cli_cmd "link add" "Link a directory (default .) into a level, and record it in pvm.yml" \
  --opt "--to SPEC: The wsm level: source, source/ws or source/ws/space" \
  --opt "--as NAME: The symlink's name (default: the directory's)" --arg "[dir]"
cli_cmd "link remove" "Remove a directory's links and their pvm.yml entries" --alias rm \
  --opt "--to SPEC: Only the link to that level" --arg "[dir]"
cli_cmd "link list" "The configured links and their state" --alias ls --arg "[dir]"
cli_cmd "link apply" "Create this vault's links that are missing" \
  --opt "--event EVENT: From wsm: install or remove, for the levels that follow" --arg "[spec...]"
cli_cmd "link validate" "Every vault's links that are missing, dangling or in conflict" --arg "[spec]"
cli_cmd validate "Check documents against the vault's profile" \
  --opt "--fix: Mint the ids that are missing" --opt "--strict: Exit 1 on any finding" --arg "[path]"
cli_standard

cli_help_epilogue() {
  cat <<EOF
A vault is named by its id, a unique id prefix (4+ characters) or its name. SPEC is a wsm level
as \`wsm list\` has it: source, source/ws or source/ws/space.

Registry: $(_display "$PVM_REGISTRY")
EOF
}

# --- Helpers ------------------------------------------------------------------------------

# Messages and the log are anfs's (lib/anfs/log.sh)
warn() { anfs_warn "$@"; }
die()  { anfs_die "$@"; }
fail() { anfs_fail "$@"; }
usage_err() { cli_usage "$@"; }

_display() { anfs_display "$1"; }

# The canonical path of an existing directory
_canon() { anfs_canon "$1"; }

_now() { printf '%(%Y-%m-%dT%H:%M:%S%z)T\n' -1; }

_require_yq() { anfs_require yq "it is anfs's base software: brew install yq"; }

_new_id() {
  local id=""
  while [[ ${#id} -lt 10 ]]; do
    id+=$(head -c 64 /dev/urandom | LC_ALL=C tr -dc 'a-z2-7' || true)
  done
  printf '%s\n' "${id:0:10}"
}

# Lists and --json are anfs's (lib/anfs/table.sh): anfs_row, anfs_table, anfs_result

# What a command says when it is done; quiet with --json, where anfs_result speaks instead
say() { anfs_json_on || printf '%s\n' "$*"; }

# --- The marker and config: pvm.yml -------------------------------------------------------

# The id in <root>/pvm.yml, or nothing when there is none or it is not an id
_cfg_id() {
  local id
  [[ -f "$1/$PVM_CONFIG" ]] || return 0
  id=$(yq -r '.id // ""' "$1/$PVM_CONFIG" 2>/dev/null) || return 0
  [[ "$id" =~ $ID_RE ]] && printf '%s\n' "$id"
  return 0
}

_cfg_name() {
  local name=""
  name=$(yq -r '.name // ""' "$1/$PVM_CONFIG" 2>/dev/null) || name=""
  printf '%s\n' "${name:-${1##*/}}"
}

# The root of the vault containing <dir>, or return 1. Checks $HOME itself but never walks above
# it, and stops at / for a start outside $HOME.
_find_root() {
  local dir
  dir=$(_canon "$1") || return 1
  while :; do
    [[ -f "$dir/$PVM_CONFIG" ]] && { printf '%s\n' "$dir"; return 0; }
    [[ "$dir" == "$PVM_HOME" || "$dir" == "/" ]] && return 1
    dir=$(dirname -- "$dir")
  done
}

# The vault you are in, or die
_here() {
  _find_root "$PWD" || fail "$EX_NOTFOUND" "not inside a vault (no $PVM_CONFIG here or above): pvm init, or name one"
}

# --- Registry -----------------------------------------------------------------------------
#
# id <TAB> name <TAB> added <TAB> path, the path last so it may hold spaces. Parallel arrays, in
# file order; a slot with an empty id is deleted.

REG_ID=() REG_NAME=() REG_ADDED=() REG_PATH=()

_registry_load() {
  local id name added path i dup
  REG_ID=() REG_NAME=() REG_ADDED=() REG_PATH=()
  [[ -f "$PVM_REGISTRY" ]] || return 0
  while IFS=$'\t' read -r id name added path || [[ -n "$id" ]]; do
    [[ "$id" =~ $ID_RE && "$path" == /* ]] || continue
    dup=false
    for i in "${!REG_ID[@]}"; do
      [[ "${REG_ID[$i]}" == "$id" || "${REG_PATH[$i]}" == "$path" ]] && dup=true
    done
    $dup && continue
    REG_ID+=("$id") REG_NAME+=("$name") REG_ADDED+=("$added") REG_PATH+=("$path")
  done < "$PVM_REGISTRY"
}

# Write REG_* out atomically, sorted by name then path so the file does not churn. Lock held.
_registry_write() {
  local tmp="$PVM_REGISTRY.tmp.$$" i
  (umask 077; : > "$tmp") || fail "$EX_LOCK" "cannot write $tmp"
  for i in "${!REG_ID[@]}"; do
    [[ -n "${REG_ID[$i]}" ]] || continue
    printf '%s\t%s\t%s\t%s\n' "${REG_ID[$i]}" "${REG_NAME[$i]}" "${REG_ADDED[$i]}" "${REG_PATH[$i]}"
  done | LC_ALL=C sort -t$'\t' -k2,2 -k4,4 >> "$tmp"
  mv -- "$tmp" "$PVM_REGISTRY" || fail "$EX_LOCK" "cannot replace $PVM_REGISTRY"
}

# Index of the entry with this id / at this path, or -1
_reg_by_id() {
  local i
  for i in "${!REG_ID[@]}"; do
    [[ -n "${REG_ID[$i]}" && "${REG_ID[$i]}" == "$1" ]] && { echo "$i"; return 0; }
  done
  echo -1
}
_reg_by_path() {
  local i
  for i in "${!REG_ID[@]}"; do
    [[ -n "${REG_ID[$i]}" && "${REG_PATH[$i]}" == "$1" ]] && { echo "$i"; return 0; }
  done
  echo -1
}

# True when the entry no longer describes a live vault: the path is gone, or the pvm.yml there
# no longer holds the recorded id
_is_stale() {
  [[ -d "${REG_PATH[$1]}" ]] || return 0
  [[ "$(_cfg_id "${REG_PATH[$1]}")" != "${REG_ID[$1]}" ]]
}

# --- Locking ------------------------------------------------------------------------------
#
# mkdir is the atomic step; the file inside records when, because a directory's mtime cannot be
# read portably. Retry for 5s, then break a lock older than 60s: its holder is not coming back.

PVM_LOCK_HELD=false

_lock_try() {
  local tries=0
  while ! mkdir "$PVM_LOCK" 2>/dev/null; do
    tries=$((tries + 1))
    [[ $tries -ge 50 ]] && return 1
    sleep 0.1
  done
  printf '%(%s)T\n' -1 > "$PVM_LOCK/created" 2>/dev/null || true
  PVM_LOCK_HELD=true
  anfs_on_exit _lock_release
  trap '_lock_release; exit 130' INT TERM HUP
}

_lock_acquire() {
  local created now
  $PVM_LOCK_HELD && return 0
  mkdir -p "$PVM_STATE_HOME" || fail "$EX_LOCK" "cannot create $PVM_STATE_HOME"
  _lock_try && return 0
  created=$(cat -- "$PVM_LOCK/created" 2>/dev/null) || created=0
  [[ "$created" =~ ^[0-9]+$ ]] || created=0
  printf -v now '%(%s)T' -1
  if (( now - created > 60 )); then
    warn "clearing a stale lock at $PVM_LOCK"
    rm -rf "$PVM_LOCK"
    _lock_try && return 0
  fi
  fail "$EX_LOCK" "could not acquire $PVM_LOCK after 5s"
}

_lock_release() {
  $PVM_LOCK_HELD || return 0
  PVM_LOCK_HELD=false
  rm -rf "$PVM_LOCK"
}

# --- register -----------------------------------------------------------------------------
#
# The one operation init, scan and auto-registration go through. In memory: the caller holds the
# lock, loads the registry and writes it back, so scan batches a whole run into one write.
# REG_STATUS says what happened: added, unchanged, updated (renamed, or a new id at a known
# path) or moved (a known id at a new path; REG_OLD is where it was).

REG_STATUS="" REG_OLD=""

# Usage: _register <canonical root> <name> <id>
_register() {
  local root="$1" name="$2" id="$3" by_id by_path
  REG_STATUS="" REG_OLD=""
  by_id=$(_reg_by_id "$id")
  by_path=$(_reg_by_path "$root")

  if [[ $by_id -ge 0 && "${REG_PATH[$by_id]}" == "$root" ]]; then
    if [[ "$name" != "${REG_NAME[$by_id]}" ]]; then
      REG_NAME[by_id]="$name"
      REG_STATUS=updated
    else
      REG_STATUS=unchanged
    fi
    return 0
  fi
  # The vault moved: keep when it was first seen, and drop whatever sat at the new path
  if [[ $by_id -ge 0 ]]; then
    REG_OLD="${REG_PATH[$by_id]}"
    [[ $by_path -lt 0 ]] || REG_ID[by_path]=""
    REG_PATH[by_id]="$root" REG_NAME[by_id]="$name"
    REG_STATUS=moved
    return 0
  fi
  # A new id where a vault was: its pvm.yml was replaced
  if [[ $by_path -ge 0 ]]; then
    REG_ID[by_path]="$id" REG_NAME[by_path]="$name" REG_ADDED[by_path]=$(_now)
    REG_STATUS=updated
    return 0
  fi
  REG_ID+=("$id") REG_NAME+=("$name") REG_ADDED+=("$(_now)") REG_PATH+=("$root")
  REG_STATUS=added
}

_register_locked() {
  _lock_acquire
  _registry_load
  _register "$1" "$2" "$3"
  [[ "$REG_STATUS" == unchanged ]] || _registry_write
  _lock_release
}

# Register the vault you are in when the registry does not have it as it is. Takes the lock only
# when something has to change, so the common case is a read.
_auto_register() {
  local root id name i
  root=$(_find_root "$PWD") || return 0
  id=$(_cfg_id "$root")
  [[ -n "$id" ]] || return 0
  name=$(_cfg_name "$root")
  _registry_load
  i=$(_reg_by_id "$id")
  [[ $i -ge 0 && "${REG_PATH[$i]}" == "$root" && "${REG_NAME[$i]}" == "$name" ]] && return 0
  _register_locked "$root" "$name" "$id"
  anfs_debug "registry: $REG_STATUS $name ($id) at $root${REG_OLD:+, was $REG_OLD}"
}

# The entry <query> names, as V_I (index into REG_*): an id, a unique id prefix of 4 or more, or
# a name. Returns 1 for no match, 2 for more than one (the candidates are in V_MATCHES).
V_I=-1 V_MATCHES=()
_vault_resolve() {
  local q="$1" i
  V_I=-1 V_MATCHES=()
  for i in "${!REG_ID[@]}"; do
    [[ "${REG_ID[$i]}" == "$q" ]] && { V_I=$i; return 0; }
  done
  if [[ ${#q} -ge 4 && "$q" =~ ^[a-z2-7]+$ ]]; then
    for i in "${!REG_ID[@]}"; do
      [[ -n "${REG_ID[$i]}" && "${REG_ID[$i]}" == "$q"* ]] && V_MATCHES+=("$i")
    done
  fi
  if [[ ${#V_MATCHES[@]} -eq 0 ]]; then
    for i in "${!REG_ID[@]}"; do
      [[ -n "${REG_ID[$i]}" && "${REG_NAME[$i]}" == "$q" ]] && V_MATCHES+=("$i")
    done
  fi
  case ${#V_MATCHES[@]} in
    0) return 1 ;;
    1) V_I=${V_MATCHES[0]}; return 0 ;;
    *) return 2 ;;
  esac
}

_ambiguous() {
  local i
  warn "'$1' matches more than one vault:"
  for i in "${V_MATCHES[@]}"; do
    printf '  %s  %s  %s\n' "${REG_ID[$i]}" "${REG_NAME[$i]}" "$(_display "${REG_PATH[$i]}")" >&2
  done
  exit "$EX_AMBIGUOUS"
}

# The roots of the live vaults, into LIVE (parallel: LIVE_ID, LIVE_NAME)
LIVE=() LIVE_ID=() LIVE_NAME=()
_live_vaults() {
  local i
  LIVE=() LIVE_ID=() LIVE_NAME=()
  _registry_load
  for i in "${!REG_ID[@]}"; do
    _is_stale "$i" && continue
    LIVE+=("${REG_PATH[$i]}") LIVE_ID+=("${REG_ID[$i]}") LIVE_NAME+=("${REG_NAME[$i]}")
  done
}

# --- init, new, ls, scan, forget, prune ---------------------------------------------------

cmd_init() {
  local dir="${1:-}" name="${CLI_OPT[name]:-}"
  _require_yq
  local root parent id file made=false
  root=$(_canon "${dir:-.}") || fail "$EX_NOTFOUND" "no such directory: ${dir:-.}"
  file="$root/$PVM_CONFIG"
  if [[ "$root" != / && "$root" != "$PVM_HOME" ]] && parent=$(_find_root "$(dirname -- "$root")"); then
    fail "$EX_EXISTS" "$(_display "$root") is inside the vault at $(_display "$parent"); a vault does not hold another"
  fi

  if [[ -f "$file" ]]; then
    yq -e 'tag == "!!map" or tag == "!!null"' "$file" >/dev/null 2>&1 || die "$(_display "$file") is not a YAML mapping"
    id=$(_cfg_id "$root")
    if [[ -z "$id" ]]; then
      id=$(_new_id)
      I="$id" yq -i '.id = strenv(I)' "$file"
      made=true
    fi
    [[ -z "$name" ]] || N="$name" yq -i '.name = strenv(N)' "$file"
  else
    id=$(_new_id)
    cat > "$file" <<EOF
# A pvm vault (pvm help). The id is this vault's identity: do not change it.
id: $id
name: ""
# Directories linked into wsm levels are recorded here: pvm link add DIR --to SPEC
#links:
#  - source: docs/product      # relative to this file
#    target: source/ws/space   # a wsm level (wsm ls)
#    as: product               # optional: the symlink's name; default is the directory's
# What \`pvm validate\` requires of every document's frontmatter
profile:
  required: [type, id]
  #types: [PRD, ADR, Note]    # allowed values of type; leave out to allow any
EOF
    # Set by yq, which quotes a name that needs it
    N="${name:-${root##*/}}" yq -i '.name = strenv(N)' "$file"
    made=true
  fi
  name=$(_cfg_name "$root")
  _register_locked "$root" "$name" "$id"
  if $made; then
    say "initialized vault $name ($id) at $(_display "$root")"
  else
    say "$REG_STATUS vault $name ($id) at $(_display "$root")"
  fi
  anfs_result id "$id" name "$name" path "$root" status "$REG_STATUS"
}

cmd_new() {
  local path="$1"
  [[ ! -e "$path" ]] || fail "$EX_EXISTS" "already exists: $path (pvm init makes an existing directory a vault)"
  mkdir -p -- "$path" || die "cannot create $path"
  cmd_init "$path"
}

cmd_list() {
  local stale=${CLI_OPT[stale]:-false} i state
  _registry_load
  for i in "${!REG_ID[@]}"; do
    state=ok
    _is_stale "$i" && state=stale
    # Stale entries only with --stale, where they are all that is listed; --json has both
    if ! anfs_json_on; then
      if $stale; then [[ "$state" == stale ]] || continue; else [[ "$state" == ok ]] || continue; fi
    elif $stale && [[ "$state" != stale ]]; then
      continue
    fi
    printf '%s\n' "${REG_NAME[$i]}$US${REG_ID[$i]}$US$state$US${REG_PATH[$i]}"
  done | anfs_table "NAME ID STATUS PATH" "name id status path"
}

cmd_scan() {
  local arg root id name found=0 changed=0
  local -a dirs=() files=()
  for arg in "$@"; do
    case "$arg" in
      *) [[ -d "$arg" ]] || fail "$EX_NOTFOUND" "no such directory: $arg"; dirs+=("$arg") ;;
    esac
  done
  [[ ${#dirs[@]} -gt 0 ]] || dirs=("$HOME")
  _require_yq
  # No symlinks followed, and nothing below what never holds a vault
  mapfile -t files < <(find "${dirs[@]}" \( -name .git -o -name node_modules -o -name .Trash \
    -o -name .cache -o -name Caches \) -prune -o -type f -name "$PVM_CONFIG" -print 2>/dev/null || true)
  _lock_acquire
  _registry_load
  for arg in "${files[@]}"; do
    root=$(_canon "$(dirname -- "$arg")") || continue
    id=$(_cfg_id "$root")
    if [[ -z "$id" ]]; then
      warn "no id in $(_display "$arg"): pvm init $(_display "$root")"
      continue
    fi
    name=$(_cfg_name "$root")
    _register "$root" "$name" "$id"
    found=$((found + 1))
    [[ "$REG_STATUS" == unchanged ]] && continue
    changed=$((changed + 1))
    say "$REG_STATUS $name ($id) $(_display "$root")${REG_OLD:+ (was $(_display "$REG_OLD"))}"
  done
  [[ $changed -eq 0 ]] || _registry_write
  _lock_release
  say "$found vault(s) found, $changed change(s)"
  anfs_result found "$found" changed "$changed"
}

cmd_remove() {
  local rc=0 id name
  _lock_acquire
  _registry_load
  _vault_resolve "$1" || rc=$?
  [[ $rc -ne 2 ]] || _ambiguous "$1"
  [[ $rc -eq 0 ]] || fail "$EX_NOTFOUND" "no vault matching '$1' (pvm ls, pvm ls --stale)"
  id="${REG_ID[$V_I]}" name="${REG_NAME[$V_I]}"
  REG_ID[V_I]=""
  _registry_write
  _lock_release
  say "removed $name ($id) from the registry; its files are untouched"
  anfs_result id "$id" name "$name"
}

cmd_prune() {
  local dry=${CLI_OPT[dry-run]:-false} i n=0
  _lock_acquire
  _registry_load
  for i in "${!REG_ID[@]}"; do
    _is_stale "$i" || continue
    n=$((n + 1))
    say "$($dry && echo would drop || echo dropped) ${REG_NAME[$i]} (${REG_ID[$i]}) $(_display "${REG_PATH[$i]}")"
    $dry || REG_ID[i]=""
  done
  $dry || [[ $n -eq 0 ]] || _registry_write
  _lock_release
  anfs_result pruned "$n" dry_run "$dry"
}

# --- Documents ----------------------------------------------------------------------------
#
# A document is a .md file in a vault: not in a hidden directory (.obsidian, .git, .trash) or
# node_modules, and not index.md or log.md, which OKF reserves and which carry no frontmatter.

# One row per document that opens with frontmatter: path, ok|open (open: the block never closes),
# then its top-level id, type and title. A file with no frontmatter gives no row.
# shellcheck disable=SC2016
FM_AWK='
function val(s) {
  sub(/^[^:]*:[ \t]*/, "", s); sub(/[ \t\r]+$/, "", s)
  if (s ~ /^".*"$/ || s ~ /^\047.*\047$/) s = substr(s, 2, length(s) - 2)
  gsub(/\t/, " ", s)
  return s
}
function row(state) { printf "%s\037%s\037%s\037%s\037%s\n", file, state, id, type, title }
FNR == 1 {
  if (open) row("open")
  open = 0; file = FILENAME; id = ""; type = ""; title = ""
  line = $0; sub(/[ \t\r]+$/, "", line)
  if (line != "---") nextfile
  open = 1; next
}
open && /^---[ \t\r]*$/ { row("ok"); open = 0; nextfile }
open && /^id:/    { id = val($0) }
open && /^type:/  { type = val($0) }
open && /^title:/ { title = val($0) }
END { if (open) row("open") }
'

# The documents under <dir>, one path per line
_doc_files() {
  find "$1" -mindepth 1 \( -name '.*' -o -name node_modules \) -prune -o \
    -type f -name '*.md' ! -name index.md ! -name log.md -print 2>/dev/null | LC_ALL=C sort
}

# FM_AWK's rows for every document under <dir>
_doc_scan() {
  find "$1" -mindepth 1 \( -name '.*' -o -name node_modules \) -prune -o \
    -type f -name '*.md' ! -name index.md ! -name log.md -exec awk "$FM_AWK" {} + 2>/dev/null | LC_ALL=C sort
}

# A document's frontmatter, without the fences / its body, without the frontmatter
_fm_block() { awk 'NR == 1 { if ($0 !~ /^---[ \t\r]*$/) exit; next } /^---[ \t\r]*$/ { exit } { print }' "$1"; }
_doc_body() {
  awk 'NR == 1 && /^---[ \t\r]*$/ { fm = 1; next } fm == 1 { if (/^---[ \t\r]*$/) fm = 2; next } { print }' "$1"
}

# The links of the vault at <root>, into L_SRC, L_TGT, L_AS (the default name filled in)
L_SRC=() L_TGT=() L_AS=()
_links_load() {
  local root="$1" src tgt as
  L_SRC=() L_TGT=() L_AS=()
  [[ -f "$root/$PVM_CONFIG" ]] || return 0
  while IFS="$US" read -r src tgt as; do
    src="${src#./}" src="${src%/}" tgt="${tgt%/}"
    [[ -n "$src" && -n "$tgt" ]] || continue
    [[ -n "$as" ]] || as=$(_default_as "$root" "$src")
    L_SRC+=("$src") L_TGT+=("$tgt") L_AS+=("$as")
  done < <(yq -r ".links[]? | [.source // \"\", .target // \"\", .as // \"\"] | join(\"$US\")" "$root/$PVM_CONFIG" 2>/dev/null || true)
}

# The wsm level a path relative to the vault root belongs to: the link whose source holds it,
# the deepest one when links nest. Empty when no link does. Uses L_* (_links_load).
_space_of() {
  local rel="$1" i best="" len=-1 src
  for i in "${!L_SRC[@]}"; do
    src="${L_SRC[$i]}"
    if [[ "$src" == . || "$rel" == "$src" || "$rel" == "$src"/* ]]; then
      if [[ ${#src} -gt $len ]]; then len=${#src} best="${L_TGT[$i]}"; fi
    fi
  done
  printf '%s\n' "$best"
}

# Find a document by id in every live vault: D_PATH, D_ROOT, D_VAULT (name), D_VID. Returns 1
# when there is none; exits 2 when more than one document carries the id.
D_PATH="" D_ROOT="" D_VAULT="" D_VID=""
_doc_find() {
  local want="$1" v path state id type title
  local -a hits=() roots=() names=() vids=()
  _live_vaults
  for v in "${!LIVE[@]}"; do
    # grep narrows it to the files that mention the id; the frontmatter scan decides
    while IFS="$US" read -r path state id type title; do
      [[ "$id" == "$want" ]] || continue
      hits+=("$path") roots+=("${LIVE[$v]}") names+=("${LIVE_NAME[$v]}") vids+=("${LIVE_ID[$v]}")
    done < <(find "${LIVE[$v]}" -mindepth 1 \( -name '.*' -o -name node_modules \) -prune -o \
      -type f -name '*.md' ! -name index.md ! -name log.md -exec grep -lE "^id:[[:space:]]*[\"']?$want" {} + 2>/dev/null |
      while IFS= read -r path; do awk "$FM_AWK" "$path"; done)
  done
  case ${#hits[@]} in
    0) return 1 ;;
    1) D_PATH="${hits[0]}" D_ROOT="${roots[0]}" D_VAULT="${names[0]}" D_VID="${vids[0]}" ;;
    *)
      warn "more than one document has the id $want:"
      printf '  %s\n' "${hits[@]}" >&2
      exit "$EX_AMBIGUOUS"
      ;;
  esac
}

cmd_path() {
  local rc=0 root
  if [[ $# -eq 0 ]]; then
    root=$(_here)
    if anfs_json_on; then anfs_result path "$root"; else printf '%s\n' "$root"; fi
    return 0
  fi
  _registry_load
  _vault_resolve "$1" || rc=$?
  [[ $rc -ne 2 ]] || _ambiguous "$1"
  if [[ $rc -eq 0 ]]; then
    if anfs_json_on; then anfs_result path "${REG_PATH[$V_I]}" kind vault; else printf '%s\n' "${REG_PATH[$V_I]}"; fi
    if _is_stale "$V_I"; then
      warn "${REG_NAME[$V_I]} is stale: its path is gone or its pvm.yml changed id (pvm scan, pvm prune)"
      return "$EX_STALE"
    fi
    return 0
  fi
  if [[ "$1" =~ $ID_RE ]] && _doc_find "$1"; then
    if anfs_json_on; then anfs_result path "$D_PATH" kind document; else printf '%s\n' "$D_PATH"; fi
    return 0
  fi
  fail "$EX_NOTFOUND" "no vault or document matching '$1'"
}

cmd_docs() {
  local path="${1:-}" want_type="${CLI_OPT[type]:-}" want_space="${CLI_OPT[space]:-}"
  want_space="${want_space%/}"
  _require_yq
  # Where to look: PATH (in its vault), else the vault you are in, else every vault
  local -a roots=() dirs=() names=()
  local root dir v
  if [[ -n "$path" ]]; then
    dir=$(_canon "$path") || fail "$EX_NOTFOUND" "no such directory: $path"
    root=$(_find_root "$dir") || fail "$EX_NOTFOUND" "$(_display "$dir") is not inside a vault"
    roots=("$root") dirs=("$dir") names=("$(_cfg_name "$root")")
  elif root=$(_find_root "$PWD"); then
    roots=("$root") dirs=("$root") names=("$(_cfg_name "$root")")
  else
    _live_vaults
    roots=("${LIVE[@]}") dirs=("${LIVE[@]}") names=("${LIVE_NAME[@]}")
  fi

  local file state id type title space shown
  for v in "${!roots[@]}"; do
    _links_load "${roots[$v]}"
    while IFS="$US" read -r file state id type title; do
      [[ -n "$file" ]] || continue
      space=$(_space_of "${file#"${roots[$v]}"/}")
      [[ -z "$want_type" || "$type" == "$want_type" ]] || continue
      [[ -z "$want_space" || "$space" == "$want_space" ]] || continue
      printf '%s\n' "$id$US$type$US$title$US$space$US$file$US${names[$v]}"
    done < <(_doc_scan "${dirs[$v]}")
  done | anfs_table "ID TYPE TITLE SPACE PATH VAULT" "id type title space path vault"
}

cmd_show() {
  local want="$1" body=${CLI_OPT[body]:-false}
  _require_yq
  _doc_find "$want" || fail "$EX_NOTFOUND" "no document with the id '$want' in any registered vault (pvm docs)"
  if ! anfs_json_on; then
    if $body; then _doc_body "$D_PATH"; else cat -- "$D_PATH"; fi
    return 0
  fi
  # The frontmatter and the body go through files: a document can be larger than one
  # environment string may be
  local tmp space
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/pvm-show.XXXXXX")
  anfs_on_exit "rm -rf '$tmp'"
  _fm_block "$D_PATH" > "$tmp/fm.yml"
  _doc_body "$D_PATH" > "$tmp/body"
  [[ -s "$tmp/fm.yml" ]] || echo '{}' > "$tmp/fm.yml"
  _links_load "$D_ROOT"
  space=$(_space_of "${D_PATH#"$D_ROOT"/}")
  ID="$want" VAULT="$D_VAULT" VID="$D_VID" P="$D_PATH" SPACE="$space" FM="$tmp/fm.yml" BODY="$tmp/body" \
    yq -n -o=json '{
      "id": strenv(ID), "vault": strenv(VAULT), "vault_id": strenv(VID), "path": strenv(P),
      "space": strenv(SPACE), "frontmatter": load(strenv(FM)), "body": load_str(strenv(BODY))
    } | (select(.space == "") | .space) = null' ||
    die "the frontmatter of $(_display "$D_PATH") does not parse (pvm validate)"
}

# --- Links --------------------------------------------------------------------------------
#
# A link is <level's directory>/<as> -> <vault>/<source>. The level's directory comes from wsm
# (`wsm ls --json`: space and dir, null when the level is not installed), so pvm.yml holds no
# absolute path and works on another machine. One tool reads another's list as JSON, never by
# column (lib/anfs/table.sh).

declare -A WSM_DIR=() WSM_KNOWN=()
WSM_LOADED=false
_wsm_load() {
  local id dir
  $WSM_LOADED && return 0
  command -v wsm >/dev/null 2>&1 || fail "$EX_UNAVAIL" "wsm is required for links (ppm install core/wsm)"
  WSM_DIR=() WSM_KNOWN=()
  while IFS="$US" read -r id dir; do
    id="${id%/}"
    [[ -n "$id" ]] || continue
    WSM_KNOWN[$id]=1
    WSM_DIR[$id]="$dir"
  done < <(wsm ls --json 2>/dev/null | yq -p json -r ".[] | .space + \"$US\" + (.dir // \"\")" 2>/dev/null || true)
  WSM_LOADED=true
}

# The record of the symlinks pvm made: path, vault id, what it points at, the level. Loaded into
# R_PATH, R_VID, R_DEST, R_TGT.
R_PATH=() R_VID=() R_DEST=() R_TGT=()
_rec_load() {
  local path vid dest tgt
  R_PATH=() R_VID=() R_DEST=() R_TGT=()
  [[ -f "$PVM_LINKS" ]] || return 0
  while IFS="$US" read -r path vid dest tgt; do
    [[ -n "$path" ]] || continue
    R_PATH+=("$path") R_VID+=("$vid") R_DEST+=("$dest") R_TGT+=("$tgt")
  done < "$PVM_LINKS"
}
# Rewrite the record without <path>, then with it again when the other three are given
_rec_set() {
  local path="$1" i tmp="$PVM_LINKS.tmp.$$"
  _lock_acquire
  _rec_load
  for i in "${!R_PATH[@]}"; do
    [[ "${R_PATH[$i]}" == "$path" ]] && continue
    printf '%s\n' "${R_PATH[$i]}$US${R_VID[$i]}$US${R_DEST[$i]}$US${R_TGT[$i]}"
  done > "$tmp"
  [[ $# -lt 4 ]] || printf '%s\n' "$path$US$2$US$3$US$4" >> "$tmp"
  mv -- "$tmp" "$PVM_LINKS"
  _lock_release
}

# Where one link stands. Sets LS_STATE, LS_PATH (the symlink), LS_DEST (what it should point at):
#   ok        the symlink is there and points into the vault
#   missing   the level is installed and nothing is at the symlink's path
#   pending   the level is not installed; wsm will say when it is
#   unknown   no source defines the level
#   conflict  something else is at the symlink's path
#   dangling  the vault directory is gone (the symlink, if any, points at nothing)
LS_STATE="" LS_PATH="" LS_DEST=""
_link_state() {
  local root="$1" src="$2" tgt="$3" as="$4" dir
  LS_DEST="$root/$src" LS_PATH=""
  [[ "$src" != . ]] || LS_DEST="$root"
  if [[ -z "${WSM_KNOWN[$tgt]:-}" ]]; then LS_STATE=unknown; return 0; fi
  dir="${WSM_DIR[$tgt]:-}"
  if [[ -z "$dir" ]]; then LS_STATE=pending; return 0; fi
  LS_PATH="$dir/$as"
  if [[ ! -d "$LS_DEST" ]]; then LS_STATE=dangling; return 0; fi
  if [[ -L "$LS_PATH" ]]; then
    if _points_at "$LS_PATH" "$LS_DEST"; then LS_STATE=ok; else LS_STATE=conflict; fi
  elif [[ -e "$LS_PATH" ]]; then
    LS_STATE=conflict
  else
    LS_STATE=missing
  fi
}

# True when the symlink <path> leads to <dest>: as written, or once both are resolved (a link
# made by hand may spell the same directory another way)
_points_at() {
  local to
  to=$(readlink -- "$1" 2>/dev/null) || return 1
  [[ "$to" == "$2" ]] && return 0
  [[ -d "$1" && -d "$2" && "$(_canon "$1")" == "$(_canon "$2")" ]]
}

# The name a link gets when pvm.yml gives none: the directory's, or the vault's for its root
_default_as() {
  if [[ "$2" == . ]]; then _cfg_name "$1"; else printf '%s\n' "${2##*/}"; fi
}

# A symlink in a cloned repo would show up there as an untracked file
_in_git() { [[ "$(git -C "$1" rev-parse --is-inside-work-tree 2>/dev/null)" == true ]]; }

# Bring one link into being. Returns 1 when it could not be (and says why).
# Usage: _link_make <root> <vault id> <source> <target> <as>
_link_make() {
  local root="$1" vid="$2" src="$3" tgt="$4" as="$5"
  _link_state "$root" "$src" "$tgt" "$as"
  case "$LS_STATE" in
    ok)
      _rec_set "$LS_PATH" "$vid" "$LS_DEST" "$tgt"
      ;;
    missing)
      if _in_git "${LS_PATH%/*}"; then
        warn "not linking $src: $(_display "${LS_PATH%/*}") is inside a git repository, where the link would be an untracked file"
        return 1
      fi
      ln -s -- "$LS_DEST" "$LS_PATH" || { warn "cannot link $(_display "$LS_PATH")"; return 1; }
      _rec_set "$LS_PATH" "$vid" "$LS_DEST" "$tgt"
      say "linked $(_display "$LS_PATH") -> $(_display "$LS_DEST")"
      ;;
    pending)  say "pending $src -> $tgt: the level is not installed (wsm install $tgt)" ;;
    unknown)  warn "$src: no wsm level '$tgt' (wsm ls)"; return 1 ;;
    dangling) warn "$src: no such directory in the vault: $(_display "$LS_DEST")"; return 1 ;;
    conflict) warn "$src: $(_display "$LS_PATH") exists and is not this link; move it away, or pick another name with --as"; return 1 ;;
  esac
}

# Remove a symlink pvm made, if it still is one: never anything that replaced it
_link_drop() {
  local path="$1" dest="$2"
  if [[ -L "$path" ]] && _points_at "$path" "$dest"; then
    rm -f -- "$path"
    say "unlinked $(_display "$path")"
  fi
  _rec_set "$path"
}

# The vault directory an argument names, as a path relative to its vault's root: LK_ROOT, LK_SRC
LK_ROOT="" LK_SRC=""
_link_dir() {
  local dir
  dir=$(_canon "${1:-.}") || fail "$EX_NOTFOUND" "no such directory: ${1:-.}"
  LK_ROOT=$(_find_root "$dir") || fail "$EX_NOTFOUND" "$(_display "$dir") is not inside a vault"
  LK_SRC=.
  [[ "$dir" == "$LK_ROOT" ]] || LK_SRC="${dir#"$LK_ROOT"/}"
}

cmd_link_add() {
  local dir="${1:-}" to="${CLI_OPT[to]:-}" as="${CLI_OPT[as]:-}"
  to="${to%/}"
  [[ -n "$to" ]] || cli_usage_err "--to SPEC is required"
  [[ "$as" != */* && "$as" != . && "$as" != .. ]] || fail "$EX_USAGE" "--as is a name, not a path: $as"
  _require_yq
  _link_dir "$dir"
  _wsm_load
  [[ -n "${WSM_KNOWN[$to]:-}" ]] || fail "$EX_NOTFOUND" "no wsm level '$to': it is source, source/ws or source/ws/space (wsm ls)"
  local name="$as" vid file="$LK_ROOT/$PVM_CONFIG"
  [[ -n "$name" ]] || name=$(_default_as "$LK_ROOT" "$LK_SRC")
  vid=$(_cfg_id "$LK_ROOT")
  [[ -n "$vid" ]] || die "$(_display "$file") has no id: pvm init $(_display "$LK_ROOT")"

  # Everything that would refuse the link, before pvm.yml changes
  _link_state "$LK_ROOT" "$LK_SRC" "$to" "$name"
  case "$LS_STATE" in
    conflict) fail "$EX_EXISTS" "$(_display "$LS_PATH") exists and is not this link; move it away, or pick another name with --as" ;;
    missing)
      ! _in_git "${LS_PATH%/*}" ||
        fail "$EX_UNAVAIL" "$(_display "${LS_PATH%/*}") is inside a git repository, where the link would be an untracked file"
      ;;
  esac

  # One entry per source and level: adding it again replaces it, and a link it had under
  # another name goes. ("=" marks an entry, so one without `as` is told from none at all.)
  local old
  old=$(S="$LK_SRC" T="$to" yq -r '.links[]? | select(.source == strenv(S) and .target == strenv(T)) | "=" + (.as // "")' "$file" | head -n 1)
  S="$LK_SRC" T="$to" yq -i 'del(.links[]? | select(.source == strenv(S) and .target == strenv(T)))' "$file"
  if [[ -n "$as" ]]; then
    S="$LK_SRC" T="$to" A="$as" yq -i '.links += [{"source": strenv(S), "target": strenv(T), "as": strenv(A)}]' "$file"
  else
    S="$LK_SRC" T="$to" yq -i '.links += [{"source": strenv(S), "target": strenv(T)}]' "$file"
  fi
  if [[ -n "$old" && -n "${WSM_DIR[$to]:-}" ]]; then
    old="${old#=}"
    [[ -n "$old" ]] || old=$(_default_as "$LK_ROOT" "$LK_SRC")
    [[ "$old" == "$name" ]] || _link_drop "${WSM_DIR[$to]}/$old" "$LS_DEST"
  fi
  local rc=0
  _link_make "$LK_ROOT" "$vid" "$LK_SRC" "$to" "$name" || rc=1
  anfs_result source "$LK_SRC" target "$to" as "$name" status "$LS_STATE" link "$LS_PATH"
  return "$rc"
}

cmd_link_remove() {
  local dir="${1:-}" to="${CLI_OPT[to]:-}"
  to="${to%/}"
  _require_yq
  _link_dir "$dir"
  _links_load "$LK_ROOT"
  _wsm_load
  local i n=0 file="$LK_ROOT/$PVM_CONFIG"
  for i in "${!L_SRC[@]}"; do
    [[ "${L_SRC[$i]}" == "$LK_SRC" ]] || continue
    [[ -z "$to" || "${L_TGT[$i]}" == "$to" ]] || continue
    n=$((n + 1))
    _link_state "$LK_ROOT" "${L_SRC[$i]}" "${L_TGT[$i]}" "${L_AS[$i]}"
    [[ -z "$LS_PATH" ]] || _link_drop "$LS_PATH" "$LS_DEST"
    S="${L_SRC[$i]}" T="${L_TGT[$i]}" yq -i 'del(.links[]? | select(.source == strenv(S) and .target == strenv(T)))' "$file"
    say "removed $LK_SRC -> ${L_TGT[$i]} from $(_display "$file")"
  done
  [[ $n -gt 0 ]] || fail "$EX_NOTFOUND" "no link of $LK_SRC${to:+ to $to} in $(_display "$file") (pvm link ls)"
  # An empty list reads better gone
  yq -i 'del(.links | select(length == 0))' "$file"
  anfs_result source "$LK_SRC" removed "$n"
}

# Rows for the links of the vaults in ROOTS (parallel NAMES): source, target, as, state, the
# symlink's path, vault name
_link_rows() {
  local v i
  for v in "${!ROOTS[@]}"; do
    _links_load "${ROOTS[$v]}"
    for i in "${!L_SRC[@]}"; do
      _link_state "${ROOTS[$v]}" "${L_SRC[$i]}" "${L_TGT[$i]}" "${L_AS[$i]}"
      printf '%s\n' "${L_SRC[$i]}$US${L_TGT[$i]}$US${L_AS[$i]}$US$LS_STATE$US$LS_PATH$US${NAMES[$v]}"
    done
  done
}

cmd_link_list() {
  _require_yq
  local -a ROOTS=() NAMES=()
  local root rel="" src tgt as state path vault
  if [[ $# -eq 1 ]]; then
    _link_dir "$1"
    ROOTS=("$LK_ROOT") NAMES=("$(_cfg_name "$LK_ROOT")")
    [[ "$LK_SRC" == . ]] || rel="$LK_SRC"
  elif root=$(_find_root "$PWD"); then
    ROOTS=("$root") NAMES=("$(_cfg_name "$root")")
  else
    _live_vaults
    ROOTS=("${LIVE[@]}") NAMES=("${LIVE_NAME[@]}")
  fi
  _wsm_load
  _link_rows | while IFS="$US" read -r src tgt as state path vault; do
    # With PATH: the links at or below it, and the ones that hold it
    [[ -z "$rel" || "$src" == . || "$src" == "$rel" || "$src" == "$rel"/* || "$rel" == "$src"/* ]] || continue
    printf '%s\n' "$src$US$tgt$US$as$US$state$US$path$US$vault"
  done | anfs_table "SOURCE TARGET AS STATUS LINK VAULT" "source target as status link vault"
}

cmd_link_apply() {
  local event="${CLI_OPT[event]:-}" arg
  local -a specs=("$@")
  _require_yq
  local i v rc=0 vid root
  if [[ -z "$event" ]]; then
    root=$(_here)
    vid=$(_cfg_id "$root")
    [[ -n "$vid" ]] || die "$(_display "$root/$PVM_CONFIG") has no id: pvm init"
    _wsm_load
    _links_load "$root"
    [[ ${#L_SRC[@]} -gt 0 ]] || say "no links in $(_display "$root/$PVM_CONFIG") (pvm link add DIR --to SPEC)"
    for i in "${!L_SRC[@]}"; do
      _link_make "$root" "$vid" "${L_SRC[$i]}" "${L_TGT[$i]}" "${L_AS[$i]}" || rc=1
    done
    anfs_result applied "${#L_SRC[@]}" ok "$([[ $rc -eq 0 ]] && echo true || echo false)"
    return "$rc"
  fi

  # From wsm, for the levels it just installed or removed. Never fails the tool that emitted:
  # what could not be done is said, and `pvm link validate` shows it later.
  local -A want=()
  for arg in "${specs[@]}"; do want[${arg%/}]=1; done
  [[ ${#want[@]} -gt 0 ]] || return 0
  case "$event" in
    install)
      _wsm_load
      _live_vaults
      for v in "${!LIVE[@]}"; do
        _links_load "${LIVE[$v]}"
        for i in "${!L_SRC[@]}"; do
          [[ -n "${want[${L_TGT[$i]}]:-}" ]] || continue
          _link_make "${LIVE[$v]}" "${LIVE_ID[$v]}" "${L_SRC[$i]}" "${L_TGT[$i]}" "${L_AS[$i]}" || true
        done
      done
      ;;
    remove)
      # The level is gone from wsm, so its directory is only in the record of what pvm linked
      _rec_load
      local -a paths=("${R_PATH[@]}") dests=("${R_DEST[@]}") tgts=("${R_TGT[@]}")
      for i in "${!paths[@]}"; do
        [[ -n "${want[${tgts[$i]}]:-}" ]] || continue
        _link_drop "${paths[$i]}" "${dests[$i]}"
      done
      ;;
    *) cli_usage_err "unknown event '$event': install or remove" ;;
  esac
  return 0
}

cmd_link_validate() {
  _require_yq
  local spec="${1:-}" src tgt as state path vault i n=0
  spec="${spec%/}"
  local -a ROOTS=() NAMES=() rows=()
  local -A configured=()
  _live_vaults
  ROOTS=("${LIVE[@]}") NAMES=("${LIVE_NAME[@]}")
  _wsm_load
  while IFS="$US" read -r src tgt as state path vault; do
    [[ -n "$src" ]] || continue
    [[ -z "$path" ]] || configured[$path]=1
    [[ -z "$spec" || "$tgt" == "$spec" ]] || continue
    case "$state" in ok|pending) continue ;; esac
    rows+=("$src$US$tgt$US$as$US$state$US$path$US$vault")
  done < <(_link_rows)
  # A symlink pvm made whose entry has left every pvm.yml
  _rec_load
  for i in "${!R_PATH[@]}"; do
    [[ -z "${configured[${R_PATH[$i]}]:-}" && -L "${R_PATH[$i]}" ]] || continue
    [[ -z "$spec" || "${R_TGT[$i]}" == "$spec" ]] || continue
    rows+=("$US${R_TGT[$i]}$US${R_PATH[$i]##*/}${US}orphan$US${R_PATH[$i]}$US")
  done
  n=${#rows[@]}
  if [[ $n -gt 0 ]]; then
    printf '%s\n' "${rows[@]}"
  fi | anfs_table "SOURCE TARGET AS STATUS LINK VAULT" "source target as status link vault"
  if [[ $n -eq 0 ]]; then
    say "all links ok"
    return 0
  fi
  return 1
}

# --- validate -----------------------------------------------------------------------------

# Put `id: <id>` into a document's frontmatter: on its empty id line, else as its last line
_doc_set_id() {
  local file="$1" id="$2" tmp
  tmp=$(mktemp "${TMPDIR:-/tmp}/pvm-id.XXXXXX")
  awk -v id="$id" '
    NR == 1 { print; fm = 1; next }
    fm == 1 && /^id:/ { print "id: " id; done = 1; next }
    fm == 1 && /^---[ \t\r]*$/ { if (!done) print "id: " id; fm = 2 }
    { print }
  ' "$file" > "$tmp"
  # Written through, not moved over: the file keeps its inode, mode and whatever syncs it
  cat -- "$tmp" > "$file"
  rm -f -- "$tmp"
}

cmd_validate() {
  local path="${1:-}" fix=${CLI_OPT[fix]:-false} strict=${CLI_OPT[strict]:-false}
  _require_yq
  local scope root file
  if [[ -n "$path" ]]; then
    [[ -e "$path" ]] || fail "$EX_NOTFOUND" "no such file or directory: $path"
    if [[ -d "$path" ]]; then scope=$(_canon "$path"); else scope="$(_canon "$(dirname -- "$path")")/${path##*/}"; fi
    root=$(_find_root "$( [[ -d "$scope" ]] && echo "$scope" || dirname -- "$scope")") ||
      fail "$EX_NOTFOUND" "$(_display "$scope") is not inside a vault"
  else
    root=$(_here)
    scope="$root"
  fi
  file="$root/$PVM_CONFIG"

  # The profile: what every document must have. With none, OKF's type and pvm's id.
  local -a required=() types=()
  mapfile -t required < <(yq -r '.profile.required // ["type", "id"] | .[]' "$file" 2>/dev/null)
  mapfile -t types < <(yq -r '.profile.types // [] | .[]' "$file" 2>/dev/null)

  # The whole vault's ids, so a duplicate outside PATH is still one
  local -A state_of=() id_of=() type_of=() count=() first=()
  local f state id type title
  while IFS="$US" read -r f state id type title; do
    [[ -n "$f" ]] || continue
    state_of[$f]="$state" id_of[$f]="$id" type_of[$f]="$type"
    [[ -n "$id" ]] || continue
    count[$id]=$(( ${count[$id]:-0} + 1 ))
    [[ -n "${first[$id]:-}" ]] || first[$id]="$f"
  done < <(_doc_scan "$root")

  local -a docs=() rows=()
  if [[ -d "$scope" ]]; then
    mapfile -t docs < <(_doc_files "$scope")
  else
    docs=("$scope")
  fi

  local rel keys key t ok minted=0 new
  for f in "${docs[@]}"; do
    [[ -n "$f" ]] || continue
    rel="${f#"$root"/}"
    case "${state_of[$f]:-none}" in
      none) rows+=("$rel${US}no frontmatter"); continue ;;
      open) rows+=("$rel${US}the frontmatter is not closed (no second ---)"); continue ;;
    esac
    # The top-level keys that have a value
    if ! keys=$(_fm_block "$f" | yq -r '(. // {}) | to_entries | .[] | select(.value != null and .value != "") | .key' 2>/dev/null); then
      rows+=("$rel${US}the frontmatter does not parse as YAML")
      continue
    fi
    id="${id_of[$f]}"
    if $fix && ! grep -qxF id <<< "$keys"; then
      new=$(_new_id)
      while [[ -n "${count[$new]:-}" ]]; do new=$(_new_id); done
      _doc_set_id "$f" "$new"
      count[$new]=1 first[$new]="$f" id="$new"
      keys+=$'\n'id
      minted=$((minted + 1))
      say "$rel: minted id $new"
    fi
    for key in "${required[@]}"; do
      grep -qxF -- "$key" <<< "$keys" || rows+=("$rel${US}missing required key: $key")
    done
    if [[ ${#types[@]} -gt 0 && -n "${type_of[$f]}" ]]; then
      ok=false
      for t in "${types[@]}"; do [[ "$t" == "${type_of[$f]}" ]] && ok=true; done
      $ok || rows+=("$rel${US}type '${type_of[$f]}' is not one of: ${types[*]}")
    fi
    if [[ -n "$id" && ${count[$id]:-0} -gt 1 ]]; then
      rows+=("$rel${US}duplicate id $id$( [[ "${first[$id]}" == "$f" ]] || printf ' (also %s)' "${first[$id]#"$root"/}")")
    fi
  done

  if anfs_json_on; then
    if [[ ${#rows[@]} -gt 0 ]]; then printf '%s\n' "${rows[@]}"; fi | anfs_table "PATH FINDING" "path finding"
  else
    for f in "${rows[@]}"; do printf '%s: %s\n' "${f%%"$US"*}" "${f#*"$US"}"; done
    say "${#docs[@]} document(s), ${#rows[@]} finding(s)$( [[ $minted -eq 0 ]] || printf ', %d id(s) minted' "$minted")"
  fi
  if $strict && [[ ${#rows[@]} -gt 0 ]]; then return 1; fi
  return 0
}

# --- Completion ---------------------------------------------------------------------------
#
# What cli.sh asks for on a tab press (complete_<kind>): one candidate per line, quickly. No yq.

complete_vault() {
  local id name added path
  [[ -f "$PVM_REGISTRY" ]] || return 0
  while IFS=$'\t' read -r id name added path; do
    [[ -n "$name" ]] && printf '%s\t%s\n' "$name" "$(anfs_display "$path")"
  done < "$PVM_REGISTRY"
}
complete_vault_or_doc() { complete_vault; }
# A wsm level: wsm's to say
complete_spec() { command wsm __complete install "" 2>/dev/null | cut -f1; }

# --- Dispatch -----------------------------------------------------------------------------

cli_globals "$@"
set -- "${CLI_ARGS[@]}"

# A vault you are standing in is registered as a side effect of using it. Not for the commands
# that manage the registry themselves, for a tab press, nor for wsm's events, which are about
# other directories.
case "${1:-help}" in
  help|-h|--help|--version|__complete|completion|init|new|scan|remove|rm|prune) ;;
  link) [[ " $* " == *" --event "* ]] || { command -v yq >/dev/null 2>&1 && _auto_register; } ;;
  *) command -v yq >/dev/null 2>&1 && _auto_register ;;
esac

cli_dispatch "$@"
