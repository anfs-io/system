# ppm settings: shipped by core/ppm. Every setting ppm reads (anfs's own are in ~/.config/anfs/anfs.env).
#
# This machine's values go in ~/.config/ppm/ppm.local.env, beside this file (yours, never shipped).
# The environment wins over both: `PPM_BREW_UPDATE_CACHE_DURATION=0 ppm install x` does what it
# says. Format: NAME=value, one per line, read and never sourced (only a leading ~/, or a value
# that is ~, is expanded, to $HOME; a value may be quoted). A commented line is the default used
# when nothing sets it; an active one is what the package sets. `ppm config` is to list and set
# them; until it exists, edit ppm.local.env.

# Seconds between `brew update` runs before an install (only the Homebrew owner runs it)
PPM_BREW_UPDATE_CACHE_DURATION=86400
# The source `ppm file claim` copies a file into when no --repo is given
#PPM_DEFAULT_REPO=user
