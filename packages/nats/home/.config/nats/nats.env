# NATS settings: shipped by core/nats. What core/nats renders into ~/.local/state/nats/server.conf
# (never edit that file: it is written again from these by `ppm install core/nats` and
# `anfs bus restart nats`).
#
# This machine's values go in ~/.config/nats/nats.local.env, beside this file (yours, never
# shipped). The environment wins over both. Format: NAME=value, one per line, read and never
# sourced (only a leading ~/, or a value that is ~, is expanded, to $HOME). A commented line is
# the default used when nothing sets it. After a change: anfs bus restart nats.

# The client port, on 127.0.0.1 (not 4222, which apps in containers publish)
#ANFS_NATS_PORT=47222
# The monitoring port, on 127.0.0.1 (anfs bus status reads it)
#ANFS_NATS_HTTP_PORT=47223
# JetStream's disk cap for every stream (the stream ANFS is bounded by anfsd.env's own limits)
#ANFS_NATS_MAX_FILE=2GiB
# JetStream's memory cap
#ANFS_NATS_MAX_MEM=64MiB
