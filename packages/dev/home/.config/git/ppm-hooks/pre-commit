#!/usr/bin/env bash
# pre-commit hook for ppm package repos: bump the patch version of every package this commit
# touches, create package.yml for a package that has none, and refuse a commit that would leave
# a package without a package.yml, or with one that isn't valid YAML.
#
# Bumps at most once per unpushed series. A package whose version already differs from the
# version at the push base has been bumped since the last push, so it is left alone — which
# also means `git commit --amend` and a run of commits before one push produce a single bump,
# and a version you set by hand is respected. A repo with nothing pushed yet (no upstream and
# no remote branch) has had zero pushes, so it gets zero bumps: a new package settles at 0.1.0
# and stays there until its first push.
#
# Wired up by `ppm hooks install` (core/dev), which points a repo's core.hooksPath at this
# directory. Note that core.hooksPath replaces a repo's .git/hooks entirely.
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel)"

if [[ -f "$HOOK_DIR/lib/package-meta.sh" ]]; then
  source "$HOOK_DIR/lib/package-meta.sh"
else
  echo "meta: package-meta.sh not found next to the hook, skipping version bump" >&2
  exit 0
fi

# Every directory under packages/ is a package, and a package has a package.yml. Checked against
# the index, after the loop below has created and staged any that were missing, so what is left
# is a package.yml deleted on its own or a package that predates this hook.
check_packages() {
  local missing pkg yml bad=""
  missing=$(git ls-files packages/ | awk -F/ 'NF >= 3 { print $2 }' | sort -u | while read -r pkg; do
    git cat-file -e ":packages/$pkg/package.yml" 2>/dev/null || echo "$pkg"
  done)
  if [[ -n "$missing" ]]; then
    echo "meta: every package needs a package.yml; missing in:" >&2
    printf '  packages/%s\n' $missing >&2
    exit 1
  fi

  # yq is ppm's, not the hook's: validate when it is there
  command -v yq >/dev/null 2>&1 || return 0
  for yml in $(git diff --cached --name-only --diff-filter=ACMR | grep '^packages/[^/]*/package.yml$' || true); do
    git show ":$yml" | yq -e 'tag == "!!map" and ((.categories // []) | tag == "!!seq")' >/dev/null 2>&1 ||
      bad="$bad"$'\n'"  $yml"
  done
  if [[ -n "$bad" ]]; then
    echo "meta: not a valid package.yml (a YAML map; categories, if present, a list):$bad" >&2
    exit 1
  fi
}

# A commit that only deletes still gets checked: deleting a package.yml alone is what it catches
git diff --cached --name-only | grep -q '^packages/' || exit 0
staged_files=$(git diff --cached --name-only --diff-filter=ACMR | grep '^packages/' || true)

base=$(meta_push_base)

for pkg_name in $(echo "$staged_files" | cut -d'/' -f2 | sort -u); do
  pkg_dir="$REPO_ROOT/packages/$pkg_name"
  [[ -d "$pkg_dir" ]] || continue          # deleted package
  meta_file="$pkg_dir/package.yml"

  base_version=""
  [[ -n "$base" ]] && base_version=$(meta_version_at "$base" "$pkg_name")
  current=$(meta_read "$pkg_dir" version)

  if [[ ! -f "$meta_file" ]]; then
    meta_bootstrap "$pkg_dir"
    echo "meta: $pkg_name — created package.yml at 0.1.0"
  elif [[ -z "$base" ]]; then
    echo "meta: $pkg_name — nothing pushed yet ($current), not bumping"
    continue
  elif [[ -z "$base_version" ]]; then
    echo "meta: $pkg_name — new package at $current, not bumping until it is pushed"
    continue
  elif [[ "$base_version" != "$current" ]]; then
    echo "meta: $pkg_name — already $current since $base_version was pushed, not bumping"
    continue
  else
    new_version=$(meta_bump_patch "$pkg_dir")
    if [[ -z "$new_version" ]]; then
      echo "meta: $pkg_name — version '$current' is not semver, leaving it alone"
      continue
    fi
    echo "meta: $pkg_name — bumped to $new_version"
  fi

  git add "$meta_file"
done

check_packages
