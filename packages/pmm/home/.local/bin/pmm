#!/usr/bin/env bash
set -euo pipefail

# Paths and sources come from anfs: one source list for every tool (`anfs src`), each source
# cloned once under ~/.local/share/anfs/sources; pmm reads the machines/
# directory of each (machines, and below it images/ and networks/)
ANFS_LIB="$HOME/.local/lib/anfs"
if [[ ! -f "$ANFS_LIB/bash.sh" ]]; then
  echo "pmm: $ANFS_LIB is missing or out of date; run: ppm install -f core/anfs" >&2
  exit 1
fi
# The bash floor, first: re-execs under bash 5 when this is macOS's 3.2
# shellcheck source=/dev/null
source "$ANFS_LIB/bash.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/paths.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/log.sh"
# anfs_on_exit is log.sh's since 2026-10-19; an older installed lib gets a plain EXIT trap
declare -F anfs_on_exit >/dev/null ||
  anfs_on_exit() { if [[ -n "$1" ]]; then trap "$1" EXIT; else trap - EXIT; fi; }
# shellcheck source=/dev/null
source "$ANFS_LIB/callbacks.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/sources.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/catalog.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/iso.sh"
anfs_tool_paths pmm
anfs_gitsrc_env
: "${PMM_MACHINES_HOME:=$PMM_CONFIG_HOME/machines}"
: "${PMM_SSH_PORT_BASE:=2222}"
: "${PMM_SSH_TIMEOUT:=600}"
: "${PMM_INSTALL:=up}"
: "${PMM_MACOS_LIMIT:=2}"
# Images: local definitions, and how long a build waits for the installer and then for ssh
: "${PMM_IMAGES_HOME:=$PMM_MACHINES_HOME/images}"
: "${PMM_IMAGE_INSTALL_TIMEOUT:=3600}"
: "${PMM_IMAGE_SSH_TIMEOUT:=600}"
# Networks: local definitions, libvirt, and what qemu's bridge helper needs (pmm-network sets
# the last two up). The backend is libvirt on Linux; there is none elsewhere yet
: "${PMM_NETWORKS_HOME:=$PMM_MACHINES_HOME/networks}"
: "${PMM_LIBVIRT_URI:=qemu:///system}"
: "${PMM_BRIDGE_CONF:=/etc/qemu/pmm-bridge.conf}"
if [[ -z "${PMM_BRIDGE_HELPER:-}" ]]; then
  PMM_BRIDGE_HELPER=/usr/lib/qemu/qemu-bridge-helper
  [[ -e "$PMM_BRIDGE_HELPER" || ! -e /usr/libexec/qemu-bridge-helper ]] || PMM_BRIDGE_HELPER=/usr/libexec/qemu-bridge-helper
fi
: "${PMM_SYS_NET:=/sys/class/net}"
: "${PMM_NET_CHECK:=true}"
: "${PMM_SSH_CONFIG=$HOME/.ssh/config.d/05-pmm.conf}"
if [[ -z "${PMM_NET_BACKEND:-}" ]]; then
  [[ "$(uname -s)" == Linux ]] && PMM_NET_BACKEND=libvirt || PMM_NET_BACKEND=none
fi
export PMM_CONFIG_HOME PMM_DATA_HOME PMM_STATE_HOME PMM_CACHE_HOME PMM_MACHINES_HOME PMM_NETWORKS_HOME PMM_IMAGES_HOME

# The implicit, highest-priority source: a person's own definitions on this host, machines in
# $PMM_MACHINES_HOME and images in $PMM_IMAGES_HOME. `pmm image new` is the one command that
# writes there.
PMM_LOCAL_SOURCE=local

# The command line (lib/anfs/cli.sh): every command is a cmd_<name> function in lib/pmm/; the
# registry is the help, in this order, and the completion's command list
# shellcheck source=/dev/null
source "$ANFS_LIB/cli.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/table.sh"
CLI_TOOL=pmm
# The commands are declared in lib/pmm/commands.sh, which the tests load too

cli_help_epilogue() {
  cat <<'EOF'
A machine is defined, or was run from an image. `pmm run debian-13` makes one from the image
and starts it: its settings are the command line's, kept with its disk until `pmm remove`, and
no definition is written. `pmm up web1` starts a machine that is defined (making it first), or
one an earlier `run` made. `pmm show` prints a machine's settings as the YAML a definition
holds: keeping one that was run is a copy into machines/<name>/machine.yml.

A <machine> is `name` or `source/name`. A plain name resolves to the highest-priority source
that defines it: local ($PMM_MACHINES_HOME), then the anfs sources in order. The name alone is
the machine: its disk, its snapshots, what `up` and `shell` act on.

A machine runs from an image's build, the way an instance runs from an AMI: any number per
image, each on the build it was created from until `pmm reset` moves it onto the current one.
`pmm image` manages the images: `pmm image build debian-13`, then `pmm run debian-13`.

Definition: machines/<name>/machine.yml in a source, or in $PMM_MACHINES_HOME
  image: debian-13          an image, name or source/name; required unless media: is given
  media: [proxmox]          ISOs (a CD) and disk images (a USB drive) to boot from when the disk
                            does not: a file, or an id in the ISO catalogue (`pmm iso list`;
                            downloaded into ~/.cache/anfs/isos when the machine starts, or ahead
                            of time by `pmm iso pull`). With no image: a blank machine, an empty
                            disk for what the media install (qemu)
  profile: medium           a named shape (below)
  cpus: 4                   each of these overrides the profile
  memory: 8G                8G, 512M, or a number of MB
  disk: 40G                 grows the machine's disk; growing the filesystem is the image's job
                            (a blank machine: its disk's size, 20G unless set)
  shares: ["~/src:ro"]      PATH[:tag][:ro]; mounted at /mnt/<tag> (qemu)
  ports: ["8080:80"]        host:guest, on 127.0.0.1; for a machine on no network
  interfaces:               the networks it is on (Linux, qemu); the first is where ssh goes
    - network: lab          a pmm network, installed with the machine if it is not
      address: 10.20.0.11   optional: kept for it either way, and its name resolves there
      mac: 52:54:00:..      optional: minted once and kept
  user: admin               who `pmm shell` logs in as (default: the image's user)
  arch: arm64               default: the host's

Profiles: machines/profiles.yml in a source, a map of name to {cpus, memory, disk}; a
higher-priority source wins by name. A setting is the first of: the machine's own, its
profile's, the profile its image names (image.yml machine.profile), then 2 cpus and 2048 MB.

Files: a machine in $PMM_DATA_HOME/machines/<name>/ (its disk, and state.yml: the build it is
on, and for one that was run from an image its settings), its snapshots in
$PMM_DATA_HOME/snapshots/<name>/, runtime state in $PMM_STATE_HOME/run/<name>/. macOS guests
(tart) are in tart's own store as pmm-<name>.

Network: machines/networks/<name>/network.yml in a source, or in $PMM_NETWORKS_HOME.
`pmm network create` makes one with no definition (`pmm network show` prints it as one)
  kind: nat                 nat (out through the host), isolated (machines and the host only),
                            bridged (onto a bridge the host already has)
  subnet: 10.20.0.0/24      nat and isolated: required. The host is .1, DHCP hands out the upper
                            half, machines get the lowest free address unless they name one
  interface: br0            bridged: the host's bridge. Addresses and names are the LAN's
  domain: lab               optional: web1.lab as well as web1

A machine with no interfaces has qemu's user-mode network: ssh and any ports: are forwarded on
127.0.0.1 only. The host setup networks need is one package: ppm install core/pmm-network.
`ssh <machine>` works for running machines where ~/.ssh/config includes ~/.ssh/config.d/*.conf.

An <image> is `name` or `source/name`, resolved like a machine: local ($PMM_IMAGES_HOME), then
the anfs sources in order.

Image: machines/images/<name>/ in a source, or in $PMM_IMAGES_HOME. The directory holds
everything a build reads except pmm's finalize step (qemu); `pmm image show` lists it, `pmm image new`
starts one
  image.yml      backend: qemu (default) | tart
                 distro: debian | fedora | macos     arch: [arm64, amd64]
                 iso: {<arch>: <id>}     (qemu, from an ISO) an id in the ISO catalogue
                                   (`pmm iso list`), whose entry pins a sha256
                 from: <image>     a qcow2 overlay on another image's build; resolves to the
                                   same or a lower-priority source, like a dependency. Its own
                                   name is the next layer down: an image built on the one it
                                   overrides
                 base: <oci image>                                        (tart)
                 build: {cpus: 2, memory: 2048, disk: 20G}     what a build boots with, and
                                   the size of the image's disk
                 machine: {profile: medium, min: {cpus: 2, memory: 4G, disk: 20G}}
                                   the profile its machines get, and their minimums
                 user: {name: pmm, password_hash: <crypt>, authorized_keys: [...]}
                 vars: {HOSTNAME: x, ...}     the answer file's ${VAR}s, all of them but
                                   what pmm sets: USER FULLNAME PASSWORD_HASH KS_PASSWORD
                                   SSH_PUBKEY IMAGE ARCH, and HOSTNAME (the image's name)
                                   unless vars: sets it
                 timeouts: {install: 3600, ssh: 600}
  preseed.cfg | kickstart.ks   the answer file a root image installs with (required; a from:
                 image has none). ${VAR} is substituted, $${VAR} is a literal ${VAR}, a name
                 neither vars: nor pmm sets is an error
  provision/*    the steps, run in name order after the install, each by the provisioner its
                 extension names (below). A from: image runs its own only: its parent's are
                 in the build it starts from
    10-base.sh       a script, run as root in the guest. It sees ANFS_IMAGE_NAME, _ARCH,
                     _BACKEND, _DISTRO, _USER, _FILES and _SSH_PUBKEY
    50-toolkit.anfs  installs the anfs toolkit as the image's user. YAML: sources: pushed
                     (the guest clones them; the default) | host (this machine's clones are
                     copied in), repo: <url>, packages: [...], installer: <url>
  files/         copied to the guest for the steps ($ANFS_IMAGE_FILES)
  test.sh        what `pmm image test` runs: the image's, else the nearest up its from: chain
  README.md      what the image is for; never read by a build

Provisioner: an executable named for the extension of the steps it runs, the first of
$PMM_CONFIG_HOME/provisioners/<ext> and ~/.local/lib/pmm/provisioners/<ext> (pmm's own sh and
anfs, and what another package stows). A step nothing provides fails `image validate`. It is
called with a verb, in the image's directory:
  check                prints what is missing on the host and fails; nothing printed is ready
  fingerprint <step>   prints, one per line, the files the step's result depends on, the step
                       first (a directory: the tree under it). They are hashed into the build
                       key; one that is not there fails `image validate`
  run <step>           runs the step against the guest; its output is the step's log, a
                       non-zero exit fails the build
Every verb gets what is being built; run also gets the guest, as a way to run something in it
rather than an ssh session:
  ANFS_IMAGE_NAME _ARCH _BACKEND _DISTRO      what is being built
  ANFS_IMAGE_USER                             the image's user
  ANFS_IMAGE_DIR                              the definition directory
  ANFS_IMAGE_WORK                             an empty directory for the call, deleted after it
  ANFS_IMAGE_GUEST_EXEC                       a command line that runs its arguments as root in
                                              the guest, stdin passed through
  ANFS_IMAGE_GUEST_PUSH                       a command line that copies a local path to an
                                              absolute guest path, as root (a directory: its
                                              contents)
  ANFS_IMAGE_GUEST_TRANSPORT                  ssh, and with it ANFS_IMAGE_GUEST_HOST, _PORT,
                                              _USER and _KEY, for one that brings its own
                                              connection
  ANFS_IMAGE_FILES                            where files/ is in the guest; empty with none
  ANFS_IMAGE_SSH_PUBKEY                       the image's public key
pmm keeps the order, files/, the log and finalize.

Every qemu build ends with pmm's finalize step (package caches, logs, ssh host keys regenerated
on first boot, machine-id); a tart build ends with a reboot. Builds are cached by a hash of
image.yml (but description:, machine:, timeouts: and the arch and iso lists), the answer file,
what each step's fingerprint names, files/, this arch's ISO's sha256 and the parent's build; `image build` is a no-op
while that hash is unchanged. A build a machine, a snapshot or another image's build is on is
kept: `image prune` leaves it, `image remove` refuses, and so does `image build -f`, which would
replace its disk.

Access: each root image gets its own ssh key ($PMM_DATA_HOME/keys/<image>); the user's
password is locked unless user.password_hash is set.

Files: ISOs in $ANFS_ISO_HOME (~/.cache/anfs/isos, shared with ventoy: `pmm iso`), builds in
$PMM_DATA_HOME/images/<name>/<arch>/, exports in $PMM_DATA_HOME/exports/.
EOF
}

cmd_cd() {
  echo "pmm cd requires the pmm shell function (source pmm.zsh)" >&2
  return 1
}

# pmm's own libraries: every *.sh in PMM_LIB_DIR (defaults/ below it holds the finalize step:
# data, not sourced; provisioners/ the executables that run a provision step). The
# stowed dir is preferred; next to this script's real path is the fallback (unstowed, or tests)
pmm_lib_dir() {
  local self="${BASH_SOURCE[0]}" dir link
  if [[ -n "${PMM_LIB_DIR:-}" ]]; then echo "$PMM_LIB_DIR"; return; fi
  if [[ -f "$HOME/.local/lib/pmm/commands.sh" ]]; then echo "$HOME/.local/lib/pmm"; return; fi
  dir="$(cd "$(dirname "$self")" && pwd)"
  while [[ -L "$self" ]]; do
    link="$(readlink "$self")"
    [[ "$link" == /* ]] || link="$dir/$link"
    self="$link"
    dir="$(cd "$(dirname "$self")" && pwd)"
  done
  echo "$dir/../lib/pmm"
}
PMM_LIB_DIR="$(pmm_lib_dir)"
if [[ ! -f "$PMM_LIB_DIR/commands.sh" ]]; then
  echo "pmm: libraries not found in $PMM_LIB_DIR; run: ppm install -f core/pmm" >&2
  exit 1
fi
for lib_file in "$PMM_LIB_DIR"/*.sh; do
  # shellcheck source=/dev/null
  [[ -f "$lib_file" ]] && source "$lib_file"
done

# -d, --trace and --json may come before the command: read them first, to see which it is
cli_globals "$@"
set -- ${CLI_ARGS[@]+"${CLI_ARGS[@]}"}
cmd=$(cli_resolve "${1:-help}")
shift 2>/dev/null || true

# install and image build pull stale sources first, like ppm install
[[ "$cmd" == "install" || "$cmd ${1:-}" == "image build" ]] && { gitsrc_update_stale >&2 || true; }
# One catalogue per process (lib/anfs/catalog.sh): images for the image commands, machines for
# the rest. A tab press reads file names only and loads neither.
case "$cmd" in
  completion|__complete|help|-h|--help|--version|iso) ;;
  image) load_images ;;
  *) load_machines ;;
esac

# A test that forgot PMM_SOCK_DIR is stopped here, before any command (core.sh, sock_dir_path)
[[ -z "${BATS_TEST_TMPDIR:-}" ]] || sock_dir_path >/dev/null || exit 69

cli_dispatch "$cmd" "$@"
