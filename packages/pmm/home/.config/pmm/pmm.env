# pmm settings: shipped by core/pmm. Every setting pmm reads (anfs's own are in ~/.config/anfs/anfs.env).
#
# This machine's values go in ~/.config/pmm/pmm.local.env, beside this file (yours, never shipped).
# The environment wins over both: `PMM_SSH_TIMEOUT=1200 pmm up x` does what it says. Format:
# NAME=value, one per line, read and never sourced (only a leading ~/, or a value that is ~, is
# expanded, to $HOME; a value may be quoted). A commented line is the default used when nothing
# sets it; an active one is what the package sets. `pmm config` is to list and set them; until it
# exists, edit pmm.local.env.

# What `pmm install` (and so `anfs install`) does with a source's images and machines: up (build,
# make and start), create (build and make, start nothing), or only validate
#PMM_INSTALL=up
# First localhost port pmm forwards ssh to (a machine's, and a build's)
#PMM_SSH_PORT_BASE=2222
# Seconds to wait for a started machine's ssh
#PMM_SSH_TIMEOUT=600
# Building an image: seconds an unattended OS install may take, and seconds to wait for the
# installed system's ssh
#PMM_IMAGE_INSTALL_TIMEOUT=3600
#PMM_IMAGE_SSH_TIMEOUT=600
# true: a build prints each step's output as it runs, not only to the build's log
#PMM_IMAGE_VERBOSE=false
# How a machine's display is shown: window or vnc (empty: a window where the host has a screen)
#PMM_DISPLAY=
# Linux: the libvirt connection pmm's networks are made in
#PMM_LIBVIRT_URI=qemu:///system
