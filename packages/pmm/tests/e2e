#!/usr/bin/env bash
# pmm end to end, for real: qemu with hvf (macOS) or kvm (Linux), the host's arch. The image half
# first (validate, build, test, export, a child whose steps two provisioners run), then machines
# from that build.
# Usage: packages/pmm/tests/e2e [debian|fedora]   (default: debian)
#
# Runs the working tree's pmm, with the working tree's lib/anfs, against an isolated HOME (a temp
# dir for config, data and state) with this repo as the source `core`: its machines/images/ and
# the catalogue their ISOs are in (isos/isos.yml). Only the ISO store is the real one, so an ISO
# downloads once. Each step is checked; the temp dir must be empty of pmm's files at the end.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PMM="$here/../home/.local/bin/pmm"
root=$(mktemp -d "${TMPDIR:-/tmp}/pmm-e2e.XXXXXX")
# the store is anfs's and shared (lib/anfs/iso.sh): pmm's implode leaves it alone
export ANFS_ISO_HOME="${ANFS_ISO_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/anfs/isos}"
export HOME="$root/home"
export XDG_CONFIG_HOME="$HOME/.config" XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state" XDG_CACHE_HOME="$HOME/.cache"
unset ANFS_CONFIG_HOME ANFS_DATA_HOME ANFS_STATE_HOME ANFS_CACHE_HOME
mkdir -p "$HOME/.local/lib" "$HOME/.config/anfs" "$HOME/.local/share/anfs/sources"
ln -s "$here/../../anfs/home/.local/lib/anfs" "$HOME/.local/lib/anfs"
# this repo is the source `core`, a local path: never pulled
repo="$(cd "$here/../../.." && pwd)"
ln -s "$repo" "$HOME/.local/share/anfs/sources/core"
printf '%s  core\n' "$repo" > "$HOME/.config/anfs/user.list"
export ANFS_LOG=off
export PMM_LIB_DIR="$here/../home/.local/lib/pmm"
export PMM_CONFIG_HOME="$root/pmm/config" PMM_DATA_HOME="$root/pmm/data" PMM_STATE_HOME="$root/pmm/state"
export PMM_CACHE_HOME="$root/pmm/cache"
export PMM_MACHINES_HOME="$PMM_CONFIG_HOME/machines"
export PMM_IMAGES_HOME="$PMM_MACHINES_HOME/images"
# A run's own ports and sockets: from the environment when it sets them (`anfs work run` gives
# each job its own), else 2342 and a fresh /tmp/pmm-e2e.*. Never the socket default: a pmm really
# running machines on this host has their sockets there, and the implode below deletes the
# directory. So under a job too the run takes a fresh directory inside the job's.
export PMM_SSH_PORT_BASE="${PMM_SSH_PORT_BASE:-2342}"
if [[ -n "${PMM_SOCK_DIR:-}" ]]; then
  mkdir -p "$PMM_SOCK_DIR"
  export PMM_SOCK_DIR=$(mktemp -d "${PMM_SOCK_DIR%/}/e2e.XXXXXX")
else
  export PMM_SOCK_DIR=$(mktemp -d /tmp/pmm-e2e.XXXXXX)
fi
# tart's store is not this run's to touch: implode deletes every pmm- VM in it
export TART_HOME="$root/no-tart"
case "${1:-debian}" in
  debian) img=debian-13 ;;
  fedora) img=fedora-44 ;;
  *) echo "usage: e2e [debian|fedora]" >&2; exit 64 ;;
esac

arch=$(uname -m); [[ "$arch" == x86_64 ]] && arch=amd64; [[ "$arch" == aarch64 ]] && arch=arm64

status=0
step() {
  local what="$1"; shift
  local t0=$(date +%s)
  if "$@" > "$root/step.log" 2>&1; then
    echo "  ok    $what ($(( $(date +%s) - t0 ))s)"
  else
    echo "  FAIL  $what"; sed 's/^/        /' "$root/step.log" | tail -n 25; status=1
  fi
}
pmm() { "$PMM" "$@"; }
# A provisioner of the run's own, for .probe steps: it fails unless it was given everything the
# contract names and is root in the guest through the command line it was handed, then leaves
# two files there, one written through GUEST_EXEC and one copied by GUEST_PUSH
mkdir -p "$PMM_CONFIG_HOME/provisioners"
cat > "$PMM_CONFIG_HOME/provisioners/probe" <<'PROBE'
#!/usr/bin/env bash
set -euo pipefail
case "$1" in
  check) ;;
  fingerprint) echo "$2" ;;
  run)
    for v in NAME ARCH BACKEND DISTRO USER DIR WORK FILES SSH_PUBKEY GUEST_EXEC GUEST_PUSH GUEST_TRANSPORT \
             GUEST_HOST GUEST_PORT GUEST_USER GUEST_KEY; do
      n="ANFS_IMAGE_$v"; [[ -n "${!n:-}" ]] || { echo "$n is not set"; exit 1; }
    done
    uid=$($ANFS_IMAGE_GUEST_EXEC id -u)
    [[ "$uid" == 0 ]] || { echo "GUEST_EXEC id -u: $uid"; exit 1; }
    echo "probe: $ANFS_IMAGE_NAME is root in the guest over $ANFS_IMAGE_GUEST_TRANSPORT"
    $ANFS_IMAGE_GUEST_EXEC sh -c 'cat > "$1"' sh "/etc/probe by exec" < "$2"
    $ANFS_IMAGE_GUEST_PUSH "$2" /etc/probe-pushed ;;
esac
PROBE
chmod +x "$PMM_CONFIG_HOME/provisioners/probe"
mkdir -p "$root/share" "$PMM_MACHINES_HOME" && echo shared > "$root/share/f"
printf 'small: {cpus: 1, memory: 1G}\n' > "$PMM_MACHINES_HOME/profiles.yml"

echo "== $img: the image"
step "image validate"                 pmm image validate "$img"
step "image show: every file the build reads, and its ISO" bash -c "o=\$('$PMM' image show $img) && for f in 'answer .*/machines/images/$img/' 'provision .*/machines/images/$img/provision/10-base.sh' 'finalize .*(pmm) .*/defaults/finalize.sh' 'test .*/machines/images/$img/test.sh' 'iso $arch .*$img-$arch'; do grep -q \"\$f\" <<< \"\$o\" || { echo \"not shown: \$f\"; echo \"\$o\"; exit 1; }; done"
step "image list: unbuilt"            bash -c "[ \"\$('$PMM' image list --json $img | yq -p json -r '.[0].state')\" = unbuilt ]"
step "image build --test"             pmm image build --test "$img"
step "rebuild is a cache hit"         bash -c "'$PMM' image build $img | grep -q 'is up to date'"
step "image list: built and tested"   bash -c "[ \"\$('$PMM' image list --json $img | yq -p json -r '.[0] | .state + \" \" + .tested')\" = 'built true' ]"
step "image export -c, a standalone qcow2" bash -c "'$PMM' image export -c -o '$root/out.qcow2' $img && qemu-img check -q '$root/out.qcow2' && ! qemu-img info '$root/out.qcow2' | grep -q 'backing file'"
step "image new --from: a child, in the local source" bash -c "'$PMM' image new web --from $img && mkdir '$PMM_IMAGES_HOME/web/files' && echo from-files > '$PMM_IMAGES_HOME/web/files/hello' && printf '#!/bin/bash\nset -e\necho \"\$ANFS_IMAGE_NAME \$ANFS_IMAGE_ARCH \$ANFS_IMAGE_USER\" > /etc/web-image\ncp \"\$ANFS_IMAGE_FILES/hello\" /etc/web-file\n' > '$PMM_IMAGES_HOME/web/provision/50-web.sh' && echo probed > '$PMM_IMAGES_HOME/web/provision/60-root.probe' && '$PMM' image validate web"
step "a step nothing provides fails validate" bash -c "echo x > '$PMM_IMAGES_HOME/web/provision/70-site.yml'; '$PMM' image validate web > '$root/v.log' 2>&1; rc=\$?; rm '$PMM_IMAGES_HOME/web/provision/70-site.yml'; cat '$root/v.log'; [ \$rc -ne 0 ] && grep -q 'nothing provides .yml steps' '$root/v.log'"
step "the child builds on $img's build: a .sh step, then the run's own provisioner, in name order; it passes $img's test.sh" bash -c "'$PMM' image build --test web | tee '$root/web.log' && grep -q '$img (.*) is up to date' '$root/web.log' && [ \"\$(grep -o '^== [^ ]*' '$root/web.log' | paste -sd' ' -)\" = '== build == 50-web.sh == 60-root.probe == finalize == test' ] && ! grep -q '10-base.sh' '$root/web.log' && grep -q 'probe: web is root in the guest over ssh' '$PMM_STATE_HOME/logs/web-$arch/provision.log'"
step "image show web: both images' steps and what runs each; built and tested" bash -c "[ \"\$('$PMM' image show --json web | yq -p json -r '[.provision[] | .step + \":\" + .provisioner] | join(\",\")')\" = 10-base.sh:sh,50-web.sh:sh,60-root.probe:probe,finalize:sh ] && [ \"\$('$PMM' image list --json web | yq -p json -r '.[0] | .state + \" \" + .tested')\" = 'built true' ]"
step "a machine from the child has both steps' work, and nothing of the build's" bash -c "'$PMM' run web --rm >/dev/null && '$PMM' exec web -- 'cat /etc/web-image /etc/web-file \"/etc/probe by exec\" /etc/probe-pushed; ls /tmp/pmm-files 2>/dev/null | wc -l' | paste -sd, - | tee /dev/stderr | grep -qx 'web $arch pmm,from-files,probed,probed,0' && '$PMM' down web >/dev/null"
step "a file the step's fingerprint names changes the build key" bash -c "echo again >> '$PMM_IMAGES_HOME/web/provision/60-root.probe' && [ \"\$('$PMM' image list --json web | yq -p json -r '.[0].state')\" = stale ]"
step "image remove is refused while the child is built on it" bash -c "! '$PMM' image remove -y $img"
step "image remove web"               pmm image remove -y web

echo "== $img: machines"
step "run --no-start: a, with a read-only share" pmm run "$img" --name a --no-start --profile small --share "$root/share:sh:ro"
step "no definition was written"      bash -c "[ ! -e '$PMM_MACHINES_HOME/a' ] && [ \"\$('$PMM' list --json | yq -p json -r '.[] | select(.name == \"a\") | .source')\" = null ]"
step "the build is held by a"         bash -c "'$PMM' image list --json $img | yq -p json -e '.[0].held | contains([\"a\"])'"
step "up a"                           pmm up a
step "exec runs a command"            bash -c "'$PMM' exec a -- 'cat /mnt/sh/f; echo kept > kept' | grep -qx shared"
step "the share is read-only"         bash -c "! '$PMM' exec a -- touch /mnt/sh/x"
step "the profile's one cpu"          bash -c "'$PMM' shell a -- nproc | grep -qx 1"
step "run: a second machine, started" pmm run "$img" --name b
step "ps lists both"                  bash -c "[ \"\$('$PMM' ps --json | yq -p json -r '[.[].name] | sort | join(\",\")')\" = a,b ]"
step "b has its own disk"             bash -c "! '$PMM' shell b -- test -e kept"
step "down a"                         pmm down a
step "up again: the disk and the settings persisted" bash -c "'$PMM' up a >/dev/null && '$PMM' exec a -- 'cat kept; nproc; cat /mnt/sh/f' | paste -sd, - | grep -qx kept,1,shared"
step "snapshot, change, reset to it"  bash -c "'$PMM' snapshot create a s1 >/dev/null && '$PMM' shell a -- rm kept && '$PMM' reset -y a s1 >/dev/null && '$PMM' shell a -- cat kept | grep -qx kept"
step "the snapshot holds the build too" bash -c "'$PMM' image list --json $img | yq -p json -e '.[0].held | contains([\"a@s1\"])'"
step "image remove is refused while held" bash -c "! '$PMM' image remove -y $img"
step "reset onto the build: a new disk" bash -c "'$PMM' reset -y a >/dev/null && ! '$PMM' shell a -- test -e kept"
step "list: a and b running"          bash -c "[ \"\$('$PMM' list --json | yq -p json -r '[.[] | select(.state == \"running\")] | length')\" = 2 ]"
step "snapshot remove"                bash -c "'$PMM' snapshot remove -y a s1 >/dev/null && [ -z \"\$('$PMM' snapshot list a)\" ]"
step "run --rm: gone at its shutdown" bash -c "'$PMM' run --rm $img --name c >/dev/null && '$PMM' down c >/dev/null && ! '$PMM' show c 2>/dev/null"
step "rm a and b"                     pmm rm -y a b
step "the build is no longer held"    bash -c "[ \"\$('$PMM' image list --json $img | yq -p json -r '.[0].held | length')\" = 0 ]"
step "image prune"                    pmm image prune
step "image remove, now that nothing is on it" pmm image remove -y "$img"
step "implode"                        pmm implode -y
left=$(find "$root/pmm" -mindepth 1 2>/dev/null | head -5)
[[ -z "$left" ]] && echo "  ok    implode left nothing" || { echo "  FAIL  implode left: $left"; status=1; }
rm -rf "$root"
[[ $status -eq 0 ]] && echo "== PASS" || echo "== FAIL"
exit $status
