#!/usr/bin/env bash
set -euo pipefail

# Paths and sources come from anfs: every anfs source with a skills/ directory is a skill repo
# psm syncs, named by its alias (anfs src list). ~/.config/psm/*.yml add third-party repos.
ANFS_LIB="$HOME/.local/lib/anfs"
if [[ ! -f "$ANFS_LIB/bash.sh" ]]; then
  echo "psm: $ANFS_LIB is missing or out of date; run: ppm install -f core/anfs" >&2
  exit 1
fi
# The bash floor, first: re-execs under bash 5 when this is macOS's 3.2
# shellcheck source=/dev/null
source "$ANFS_LIB/bash.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/paths.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/log.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/callbacks.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/sources.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/resolve.sh"
# The engine: agents, the skills CLI, rows, what is installed (the global scope, -g, here)
# shellcheck source=/dev/null
source "$ANFS_LIB/skill.sh"
anfs_gitsrc_env
anfs_tool_paths psm
export PSM_CONFIG_HOME

# The command line (lib/anfs/cli.sh): every command is a cmd_<name> function below; the registry
# is the help, in this order, and the completion's command list. `path` is plumbing for the
# `psm cd` shell function and stays out of both.
# shellcheck source=/dev/null
source "$ANFS_LIB/cli.sh"
# shellcheck source=/dev/null
source "$ANFS_LIB/table.sh"
CLI_TOOL=psm
cli_cmd install "Install a source's skills (source/) or one of them (\`anfs install\` uses this)" \
  --opt "-y --yes: Do not ask before installing a whole source/" --arg "skill-spec..."
cli_cmd sync "Install declared skills that are missing, or not yet linked to
every target agent (all sources and configs if none given; a
source's alias names it)" \
  --opt "--local: Re-copy local-path sources too, so edits take effect" --arg "[config...]"
cli_cmd update "Update remote skills (skills update -g) and re-copy local-path
sources so edits take effect" --arg "[config...]"
cli_group repo "The repos skills come from"
cli_cmd "repo list" "Every declared repo and the config declaring it" --alias ls
cli_cmd "repo add" "Declare a local skill directory in a config of its own,
named after the directory unless a name is given" --arg "dir" --arg "[name]"
cli_cmd "repo remove" "Remove that config" --alias rm \
  --opt "-y --yes: Do not ask before deleting it" --arg "dir"
cli_cmd list "Each declared skill: ok, partial, missing or *" --alias ls
cli_cmd remove "Remove skills globally" --alias rm --opt "-y --yes: Do not ask before removing" --arg "skill..."
cli_cmd prune "Remove the installed skills no config declares" --opt "-y --yes: Do not ask before removing them"
cli_group agents "The agents skills are installed for"
cli_cmd "agents list" "Agent ids detected from installed ppm packages" --alias ls
cli_cmd "agents remove" "Unlink every installed skill from these agents,
leaving it in place for the others" --alias rm \
  --opt "-y --yes: Do not ask before unlinking" --arg "agent..."
cli_cmd cd "Change to the config directory (requires the psm shell function)"
cli_cmd implode "Remove every skill and psm's config (back to no skills)" --opt "-y --yes: Do not ask before imploding"
cli_standard

cmd_cd() { echo "psm cd needs the psm shell function (source ~/.config/sh/psm.sh)" >&2; exit 1; }

cli_help_epilogue() {
  cat <<'EOF'
Run a noun on its own — psm repo, psm agents — for its commands.
sync and update stay at the top: they are the only commands that span all
three, reading repos to install skills for agents.

Config: $PSM_CONFIG_HOME/*.yml, each holding a `sources:` list

  sources:
    - repo: DietrichGebert/ponytail
      skills: [ponytail, ponytail-audit]
    - repo: obra/superpowers
      skills: ["*"]           # every skill in the repo
      agents: [claude-code]   # optional: override agent auto-detection
    - repo: ~/src/my-skills   # local paths are copied; run `psm update` after edits
      skills: ["*"]

Agents are auto-detected: any installed ppm package whose package.yml declares
`meta: {agent: <skills-cli-id>}` becomes a target. ppm tells psm when one is
installed (psm sync) or removed (psm agents rm <id>).

Every anfs source with a skills/<name>/SKILL.md needs no config: it is synced as
the repo named by the source's alias (`anfs src list` shows which provide skills),
which every command accepts as a config name.

See $PSM_CONFIG_HOME/example.yml for a commented config covering remote repos,
local skill directories and the `agents:` stanza.
EOF
}

# Messages and the log are anfs's (lib/anfs/log.sh)
die()  { anfs_die "$@"; }
warn() { anfs_warn "$@"; }

# Wrong arity for a known command: the same wording and exit code as every tool (lib/anfs/cli.sh)
usage_err() { cli_usage "$@"; }

require_npx() { anfs_skill_require || exit 1; }

# The skills CLI in the global scope (lib/anfs/skill.sh puts -g before the first option)
skills_cli() { anfs_skill_cli -g "$@"; }

_installed_agents() { anfs_skill_agents; }
_agent_display() { anfs_skill_display "$1"; }

# Config files, all or by name (basename without extension)
_config_files() {
  local name file

  if [[ $# -eq 0 ]]; then
    for file in "$PSM_CONFIG_HOME"/*.yml "$PSM_CONFIG_HOME"/*.yaml; do
      [[ -f "$file" ]] && echo "$file"
    done
    return 0
  fi

  for name in "$@"; do
    if [[ -f "$PSM_CONFIG_HOME/$name.yml" ]]; then
      echo "$PSM_CONFIG_HOME/$name.yml"
    elif [[ -f "$PSM_CONFIG_HOME/$name.yaml" ]]; then
      echo "$PSM_CONFIG_HOME/$name.yaml"
    else
      die "no config named '$name' in $PSM_CONFIG_HOME"
    fi
  done
}

_dir_skills() { anfs_skill_dir_skills "$1"; }

# The anfs sources holding skills/, one row each: <alias>|<skills dir>|<skills csv>|
# Named rather than passed as "*" so each skill gets a real installed check and prune sees them
# as declared. The dir is resolved through links, since the skills CLI does not follow them.
# Usage: _anfs_skill_sources [alias...]   (all when none given)
_anfs_skill_sources() {
  local i name dir skills want=" $* "
  anfs_sources skills
  for i in ${ANFS_SRC_NAMES[@]+"${!ANFS_SRC_NAMES[@]}"}; do
    name="${ANFS_SRC_NAMES[$i]}"
    [[ $# -eq 0 || "$want" == *" $name "* ]] || continue
    dir=$(cd -P "${ANFS_SRC_DIRS[$i]}/skills" && pwd) || continue
    skills=$(_dir_skills "$dir" | paste -sd, -)
    [[ -n "$skills" ]] && echo "$name|$dir|$skills|"
  done
  return 0
}

# True when <name> is an anfs source holding skills
_is_skill_source() {
  anfs_sources skills
  anfs_is_source "$1"
}

# Fail early on unknown config names: inside _config_sources, which feeds a loop
# through a pipe, die would only exit the subshell
_validate_names() {
  local name
  for name in "$@"; do
    _is_skill_source "$name" || _config_files "$name" >/dev/null
  done
}

# Declared sources as |-separated rows: <config>|<repo>|<skills csv>|<agents csv>
# (| rather than tab: read collapses consecutive tabs, losing empty fields)
# anfs sources come first; named arguments pick sources by alias and configs by name.
_config_sources() {
  local file name rows
  local -a names=() srcs=()

  if [[ $# -gt 0 ]]; then
    for name in "$@"; do
      if _is_skill_source "$name"; then srcs+=("$name"); else names+=("$name"); fi
    done
  fi

  if [[ $# -eq 0 || ${#srcs[@]} -gt 0 ]]; then
    _anfs_skill_sources ${srcs[@]+"${srcs[@]}"}
  fi
  [[ $# -gt 0 && ${#names[@]} -eq 0 ]] && return 0

  # yq is checked on its own rather than through the pipeline: under pipefail a
  # consumer that stops reading (psm list | head) would otherwise surface as
  # an unparseable config
  _config_files ${names[@]+"${names[@]}"} | while IFS= read -r file; do
    if ! rows=$(yq -r '.sources[]? | [.repo,
                                      ((.skills // ["*"]) | join(",")),
                                      ((.agents // []) | join(","))] | join("|")' "$file" 2>/dev/null); then
      warn "can't parse $file"
      continue
    fi

    [[ -n "$rows" ]] || continue
    awk -v c="$(basename "${file%.*}")" 'NF { print c "|" $0 }' <<< "$rows"
  done
}

_expand_home() { anfs_skill_expand "$1"; }

# Inverse of _expand_home: configs record ~/src/skills, not /Users/x/src/skills
_abbreviate() { anfs_display "$1"; }

_is_local() { anfs_skill_is_local "$1"; }

# Installed skills (lib/anfs/skill.sh): <name>|<agent display names csv>|<source> rows in
# INSTALLED, loaded once per run; a failed lookup yields nothing, so nothing is skipped
INSTALLED=""
_load_installed() { anfs_skill_load -g; INSTALLED="$ANFS_SKILL_INSTALLED"; }

# Agent display names a skill is installed for; returns 1 if not installed
_skill_agents() { anfs_skill_installed_agents "$1"; }

# True when <skill> is installed for every agent id in <agents csv>
_has_skill() { anfs_skill_has "$1" "$2"; }

# --- repo ---

# Name of the config declaring <abs path>, if any. The built-in repo is skipped:
# it has no config file to add to or remove.
_repo_config() {
  local config repo skills agents match=""

  # Drains the stream rather than returning on the first hit: leaving early
  # would close the pipe under _config_sources, whose yq would then fail and
  # report the config as unparseable
  while IFS='|' read -r config repo skills agents; do
    _is_skill_source "$config" && continue
    repo=$(_expand_home "$repo")
    if [[ -z "$match" && "${repo%/}" == "$1" ]]; then match="$config"; fi
  done < <(_config_sources)

  [[ -n "$match" ]] || return 1
  echo "$match"
}

# Resolve an argument to an absolute path with no symlinks
_repo_path() {
  local path
  path=$(cd -P "${1:-.}" 2>/dev/null && pwd -P) || return 1
  echo "$path"
}

cmd_repo_add() {

  local path name config file
  local -a found=()

  path=$(_repo_path "$1") || die "not a directory: $1"

  if config=$(_repo_config "$path"); then
    echo "Already declared in $config: $(_abbreviate "$path")"
    return 0
  fi

  while IFS= read -r name; do found+=("$name"); done < <(_dir_skills "$path")
  [[ ${#found[@]} -gt 0 ]] \
    || die "no <skill>/SKILL.md directly under $(_abbreviate "$path")"

  name="${2:-}"
  if [[ -z "$name" ]]; then
    name=$(basename "$path")
    # ~/spaces/cnfs-io/skills is better named for its parent than for "skills"
    [[ "$name" == skills ]] && name=$(basename "$(dirname "$path")")
  fi

  file="$PSM_CONFIG_HOME/$name.yml"
  [[ -e "$file" ]] && die "$file exists — pass a name: psm repo add $1 <name>"

  mkdir -p "$PSM_CONFIG_HOME"
  # "*" rather than the names found: it is your directory, and skills you add to
  # it later should sync without re-declaring the repo
  cat > "$file" <<EOF
sources:
  - repo: $(_abbreviate "$path")
    skills: ["*"]
EOF

  echo "Added $(_abbreviate "$path") as $name"
  printf '  %s\n' "${found[@]}"
  echo "Run: psm sync $name"
}

cmd_repo_remove() {

  local path config file count

  # A repo whose directory is gone must still be removable, so an unresolvable
  # argument falls back to the path as written
  path=$(_repo_path "$1") || { path=$(_expand_home "$1"); path="${path%/}"; }

  config=$(_repo_config "$path") || die "not declared: $(_abbreviate "$path")"
  file=$(_config_files "$config")

  # A stowed config belongs to the ppm package that ships it; removing the
  # symlink here would leave ppm's tracker claiming it is still installed
  [[ -L "$file" ]] \
    && die "$config is stowed by a ppm package — remove the package instead: $file"

  # Only remove a config this command could have written; anything hand-authored
  # is left alone rather than rewritten, which would drop its comments
  count=$(yq -r '.sources | length' "$file" 2>/dev/null) || count=0
  [[ "$count" == 1 ]] \
    || die "$config declares $count sources — remove the entry by hand: $file"

  anfs_confirm "repo remove deletes $(_abbreviate "$file")" "Remove $config?"
  rm -f "$file"
  echo "Removed $(_abbreviate "$path") ($config)"
  echo "Run: psm prune   # its skills are still installed"
}

cmd_repo_list() {
  local config repo skills agents path

  while IFS='|' read -r config repo skills agents; do
    [[ -n "$repo" ]] || continue
    path=$(_expand_home "$repo")
    if _is_local "$path" && [[ ! -d "$path" ]]; then
      anfs_row "$repo" missing "$config"
    else
      anfs_row "$repo" "" "$config"
    fi
  done < <(_config_sources) | anfs_table "REPOSITORY STATUS CONFIG" "repository status config"
}

cmd_agents_list() {
  _installed_agents | tr ',' '\n'
}

# Skill names go before -a: the CLI's -a takes every argument after it as an agent
cmd_agents_remove() {
  require_npx
  _load_installed

  local id display name agents source _path failed=0
  local -a names
  for id in "$@"; do
    display=$(_agent_display "$id") || { warn "unknown agent '$id'"; failed=$((failed + 1)); continue; }
    names=()
    while IFS='|' read -r name agents source _path; do
      [[ -n "$name" && ",$agents," == *",$display,"* ]] && names+=("$name")
    done <<< "$INSTALLED"

    if [[ ${#names[@]} -eq 0 ]]; then
      echo "ok     $id: no skills linked"
      continue
    fi
    echo "unlink $id: ${names[*]}"
    anfs_confirm "agents remove unlinks ${#names[@]} skills from $id" "Unlink them from $id?"
    anfs_skill_unlink -g "$id" "${names[@]}" || { warn "skills remove for $id failed"; failed=$((failed + 1)); }
  done

  # Universal agents read ~/.agents/skills itself: there is no link of theirs to remove, and the
  # CLI rightly keeps the shared copy, so they still list every skill
  _load_installed
  for id in "$@"; do
    display=$(_agent_display "$id") || continue
    if awk -F'|' -v d="$display" '{ n = split($2, a, ","); for (i = 1; i <= n; i++) if (a[i] == d) f = 1 } END { exit !f }' <<< "$INSTALLED"; then
      echo "note   $id reads the shared ~/.agents/skills directly; its skills stay with the other agents'"
    fi
  done
  [[ $failed -eq 0 ]]
}

cmd_sync() {
  local force_local=${CLI_OPT[local]:-false}
  local -a names=("$@")

  _validate_names ${names[@]+"${names[@]}"}
  require_npx
  _load_installed

  local detected
  detected=$(_installed_agents)

  _sync_rows "$force_local" "$detected" < <(_config_sources ${names[@]+"${names[@]}"})
}

# Sync |-separated source rows read from stdin (see _config_sources), then say how it went
# Usage: _sync_rows <force_local> <detected agents csv>
_sync_rows() {
  local rc=0
  anfs_skill_sync_rows -g "$1" "$2" || rc=1
  local installed=$ANFS_SKILL_SYNCED current=$ANFS_SKILL_CURRENT failed=$ANFS_SKILL_FAILED waiting=$ANFS_SKILL_WAITING
  if [[ $((installed + current + failed + waiting)) -eq 0 ]]; then
    echo "No skill sources: no anfs source has skills/ and $PSM_CONFIG_HOME has no configs"
  elif [[ $((installed + current + failed)) -eq 0 ]]; then
    echo "No agent installed yet: $waiting skill source(s) sync when an agent package is installed"
  else
    local note=""
    [[ $waiting -eq 0 ]] || note=", $waiting waiting for an agent"
    echo "Sources: $installed synced, $current up to date, $failed failed$note"
  fi
  return $rc
}

# `psm install <source/|source/skill>...`: sync a source's skills, or one of them
cmd_install() {
  require_npx
  _load_installed

  local spec src name row rows=""
  for spec in "$@"; do
    src="${spec%%/*}" name="${spec#*/}"
    _is_skill_source "$src" || die "'$src' is not an anfs source with skills (anfs src list)"
    row=$(_anfs_skill_sources "$src")
    [[ -n "$name" ]] || anfs_confirm "install $src/ installs every skill $src has" "Install them?"
    if [[ -n "$name" ]]; then
      [[ ",$(cut -d'|' -f3 <<< "$row")," == *",$name,"* ]] || die "no skill '$name' in $src"
      row="$src|$(cut -d'|' -f2 <<< "$row")|$name|"
    fi
    rows+="$row"$'\n'
  done
  _sync_rows false "$(_installed_agents)" <<< "$rows"
}

cmd_update() {
  require_npx
  skills_cli update -y || warn "skills update failed"
  CLI_OPT[local]=true
  cmd_sync "$@"
}

cmd_list() {
  require_npx
  _load_installed

  local detected
  detected=$(_installed_agents)

  local config repo skills agents item status
  local -a list

  while IFS='|' read -r config repo skills agents; do
    [[ -n "$repo" ]] || continue
    [[ -n "$agents" ]] || agents=$detected
    IFS=',' read -r -a list <<< "$skills"
    for item in "${list[@]}"; do
      if [[ "$item" == '*' ]]; then
        status="*"
      else
        status=$(anfs_skill_status "$item" "$agents")
      fi
      anfs_row "$config/$item" "$status" "$config" "$repo"
    done
  done < <(_config_sources) | anfs_table "SKILL STATUS" "skill status config repo"
}

cmd_prune() {
  require_npx
  _load_installed

  # Named skills are protected by name; "*" sources protect whatever the CLI
  # recorded as coming from that repo
  local declared="" globs="" config repo skills agents
  while IFS='|' read -r config repo skills agents; do
    declared+="${skills//,/$'\n'}"$'\n'
    [[ ",$skills," == *",*,"* ]] && globs+="$repo"$'\n'
  done < <(_config_sources)

  local name source _path
  local -a orphans=()
  while IFS='|' read -r name agents source _path; do
    [[ -n "$name" ]] || continue
    grep -qxF "$name" <<< "$declared" && continue
    [[ -n "$source" ]] && grep -qxF "$source" <<< "$globs" && continue
    orphans+=("$name")
  done <<< "$INSTALLED"

  if [[ ${#orphans[@]} -eq 0 ]]; then
    echo "Nothing to prune"
    return 0
  fi

  printf 'undeclared  %s\n' "${orphans[@]}"
  anfs_confirm "prune removes ${#orphans[@]} skills no config declares" "Remove them?"
  skills_cli remove -y "${orphans[@]}"
}

cmd_remove() {
  require_npx
  anfs_confirm "remove takes $* away from every agent" "Remove $*?"
  skills_cli remove -y "$@"
}

cmd_path() {
  if [[ $# -eq 0 ]]; then
    echo "$PSM_CONFIG_HOME"
  else
    _config_files "$1"
  fi
}

# What cli.sh asks for on a tab press (complete_<kind>): one candidate per line, quickly
complete_config() {
  local f
  for f in "$PSM_CONFIG_HOME"/*.yml "$PSM_CONFIG_HOME"/*.yaml; do
    [[ -f "$f" ]] || continue
    f="${f##*/}"
    printf '%s\n' "${f%.*}"
  done
  # A source with skills is named by its alias
  for f in "$ANFS_SOURCES_HOME"/*/skills; do
    [[ -d "$f" ]] || continue
    f="${f%/skills}"
    printf '%s\n' "${f##*/}"
  done
}
complete_agent() { _installed_agents | tr ',' '\n'; }

# `psm implode [-y]`: remove every global skill (the skills CLI's ~/.agents/skills and each
# agent's links to it) and psm's own config and hub. Skills installed with `npx skills` by hand
# go too: psm cannot tell them apart, and implode means a machine with none. node and the npx
# cache are left alone.
cmd_implode() {
  local yes=${CLI_OPT[yes]:-false}

  local -a names=()
  local name agents source _path have_cli=false
  if command -v npx &>/dev/null || command -v mise &>/dev/null; then
    require_npx
    have_cli=true
    _load_installed
    while IFS='|' read -r name agents source _path; do
      [[ -n "$name" ]] && names+=("$name")
    done <<< "$INSTALLED"
  fi

  {
    echo "psm implode removes:"
    if $have_cli; then
      echo "  skills       ${names[*]:-none installed}"
    else
      echo "  skills       npx is not available; installed skills, if any, are left"
    fi
    local dir
    for dir in "$PSM_CONFIG_HOME" "$PSM_DATA_HOME"; do
      [[ -e "$dir" ]] && echo "  directory    $(_abbreviate "$dir")"
    done
  } >&2

  $yes || anfs_confirm "implode removes every skill" "Implode psm?"

  local rc=0
  if [[ ${#names[@]} -gt 0 ]]; then
    skills_cli remove "${names[@]}" -y || { warn "skills remove failed"; rc=1; }
  fi
  for dir in "$PSM_CONFIG_HOME" "$PSM_DATA_HOME"; do
    [[ -e "$dir" ]] || continue
    echo "psm: deleting $(_abbreviate "$dir")" >&2
    rm -rf "${dir:?}" || rc=1
  done
  _implode_empty_skill_dirs
  [[ $rc -eq 0 ]] && echo "psm imploded" >&2
  return $rc
}

# The skills CLI makes a skills/ directory in each agent's home (~/.agents/skills, ~/.pi/agent/
# skills, ...) to link skills into. Once every skill is removed the ones it made are empty: remove
# them and the parents that are empty too. rmdir only, so an agent's own files keep its dir.
_implode_empty_skill_dirs() {
  local dir
  while IFS= read -r dir; do
    while [[ "$dir" == "$HOME"/.* && "$dir" != "$HOME" ]]; do
      rmdir "$dir" 2>/dev/null || break
      dir="${dir%/*}"
    done
  done < <(find "$HOME" -maxdepth 4 -path "$HOME/.*" -type d -name skills -empty 2>/dev/null)
}

cli_dispatch "$@"
