# anfs-ui config schema — canonical source of truth for every tunable.
#
# The toolkit's dashboard. Where it listens on the host, and who may use it.
# Validate: varlock load --path .
#
# @defaultSensitive=false @defaultRequired=infer
# ---

## Listen address
# The host address the port is published on. Loopback only by default, for security: there is
# no login, so whoever reaches the page sees the inventory. 0.0.0.0 publishes on every
# interface (the LAN can reach it). A single address (the Mac's LAN IP, a tailscale IP)
# publishes only there. On macOS podman's VM forwards it to the host.
# @type=string
ANFS_UI_BIND=127.0.0.1
# Host port (the container's stays 9292).
# @type=port
ANFS_UI_PORT=9292

## Access
# Extra host names or IPs the app answers to, comma-separated (it refuses any other Host, against
# DNS rebinding). Needed whenever it is reached by a name other than localhost: set it to the
# names and IPs you browse to when ANFS_UI_BIND is not loopback.
# @type=string
ANFS_UI_HOSTS=
# 1 lets other machines run commands (install, remove, up, down), not only view. There is no
# login, and the container holds the toolkit's write grant: anyone who reaches the page can
# change this machine. Leave it 0 unless the address is one only you can reach.
# With ANFS_UI_BIND on loopback this machine may always run them. Published anywhere else the
# container cannot tell this machine's browser from another's, so 0 means view only for all.
# @type=enum(0, 1)
ANFS_UI_REMOTE_ACTIONS=0

## The bus
# Where the container reaches NATS (core/nats) to hear what changes: the host's 127.0.0.1:47222,
# through podman's host.containers.internal. Change it only when nats.local.env moves the port
# (ANFS_NATS_PORT). The reader's password is not a setting: compose.yml mounts core/nats's own
# file read-only.
# @type=url
ANFS_UI_BUS_URL=nats://host.containers.internal:47222
